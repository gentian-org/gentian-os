# Gentian OS installer non-secret configuration template
#
# Usage:
#   cp install.env.template install.env
#   edit install.env
#   ./install.sh
#
# Notes:
# - install.sh auto-loads ./install.env when present.
# - Values in this file are non-secret and may be committed only if your
#   organization allows it. Prefer environment-specific private copies.

# Core cluster/domain settings
KERNEL_DOMAIN=platform.example.com
INSTALL_CLUSTER_INFRA=1

# Networking mode — how external traffic reaches the cluster:
#   tunnel    → cluster is behind a reverse-proxy/tunnel (e.g. Cloudflare Tunnel,
#               ngrok). DNS resolves *.${KERNEL_DOMAIN} to the tunnel endpoint,
#               not to the node IP. NODE_IP is optional (URL display fallback only).
#               DNS-01 ACME (Cloudflare) recommended for wildcard certificates.
#   static-ip → node has a public/reachable static IP. DNS *.${KERNEL_DOMAIN}
#               points directly to NODE_IP. MetalLB (or equivalent LoadBalancer
#               provider) must be pre-configured so the ingress service is
#               assigned NODE_IP as its external IP. HTTP-01 ACME works directly.
NETWORK_MODE=tunnel

# NODE_IP: required in static-ip mode; auto-detected otherwise.
# NODE_IP=192.0.2.10

# Tool install behavior
# SKIP_TOOLS=0

# Optional cert-manager/ACME overrides
# LETSENCRYPT_EMAIL=platform-admin@example.com
# INGRESS_CLASS_NAME=nginx

# OpenBao KV v2 mount path (default: secret).
# Must match spec.openbao.kvMount in the Cluster XR claim.
# KV_MOUNT=secret

# OpenBao CLI version auto-installed to ~/.local/bin when 'bao' is not on PATH.
# Must match the appVersion of the OpenBao Helm chart in kernel/bootstrap/openbao-application.yaml.
# OPENBAO_CLI_VERSION=v2.5.0

# Mail delivery mode:
#   external  -> Nubus sends via an external SMTP host (e.g. Gmail/Proton)
#   kernel    -> Nubus sends via in-cluster Postfix service
MAIL_SERVICE_MODE=external

# Required when MAIL_SERVICE_MODE=external
# EXTERNAL_SMTP_HOST=smtp.gmail.com
# EXTERNAL_SMTP_PORT=587
# EXTERNAL_SMTP_SSL=false
# EXTERNAL_SMTP_STARTTLS=true

# App/deployment repository sources
GENTIAN_APPS_REPO=https://github.com/gentian-org/gentian-apps
GENTIAN_APPS_BRANCH=main
GENTIAN_DEPLOYMENTS_REPO=https://github.com/gentian-org/gentian-deployments
GENTIAN_DEPLOYMENTS_BRANCH=main
# GENTIAN_DEPLOYMENTS_PATH=${HOME}/.gentian/gentian-deployments

# Optional: set to 1 in CI to avoid interactive prompts
GENTIAN_NONINTERACTIVE=1
