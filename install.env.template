# Gentian OS installer configuration. Non-secret; credentials never go here.
#
#   cp install.env.template install.env    # edit, then ./install.sh
#
# This file says how to RUN the install. What the cluster IS lives on the
# Cluster claim, written by `./install.sh --prepare-deployment`. Credentials are
# prompted for and stored in OpenBao. See docs/install-reference.md §4.

# ── Set these ────────────────────────────────────────────────────────────────

# Directory name under clusters/ in gentian-deployments, and half the Cluster
# claim's name. Set it before the first run; scaffolding pushes the tree it names.
GENTIAN_DEPLOYMENTS_CLUSTER_ID=default-cluster
GENTIAN_DEPLOYMENTS_STAGE=dev

GENTIAN_DEPLOYMENTS_REPO=https://github.com/gentian-org/gentian-deployments
GENTIAN_DEPLOYMENTS_BRANCH=main

GENTIAN_APPS_REPO=https://github.com/gentian-org/gentian-apps
GENTIAN_APPS_BRANCH=main

# The gentian-os ref every in-cluster Application tracks. A release tag pins the
# cluster; a branch follows it. docs/deployment.md §4.
GENTIAN_OS_BRANCH=develop

# ── Defaults — change for a fork or a mirror ─────────────────────────────────

# *_AUTH: none | basic | bearer. Deployments defaults to basic because a private
# repository cannot describe its own access; set none for a public one.
GENTIAN_APPS_AUTH=none
GENTIAN_DEPLOYMENTS_AUTH=basic

GENTIAN_UI_REPO=https://github.com/gentian-org/gentian-ui
GENTIAN_UI_BRANCH=develop
GENTIAN_UI_AUTH=none

GENTIAN_OS_REPO=https://github.com/gentian-org/gentian-os
GENTIAN_OS_AUTH=none
GENTIAN_OS_IMAGE_REPOSITORY=ghcr.io/gentian-org/gentian-os

# 0 when cert-manager, CloudNativePG and Reloader are managed elsewhere.
INSTALL_CLUSTER_INFRA=1

# 1 in CI: take the default for every prompt instead of asking.
GENTIAN_NONINTERACTIVE=0

# ── Optional ─────────────────────────────────────────────────────────────────

# GENTIAN_DEPLOYMENTS_PATH=${HOME}/.gentian/gentian-deployments
# Local checkout of the deployments repository.

# KERNEL_DOMAIN=platform.example.com
# Only for a non-interactive first run. The Cluster claim owns the domain, and
# --prepare-deployment asks for it; a value here after that overrides the claim.

# OPENBAO_CLI_VERSION=v2.5.0
# Which `bao` to fetch when none is on PATH. Unset takes the versions.yaml pin.

# GENTIAN_OS_IMAGE_TAG=develop
# Unset follows GENTIAN_OS_BRANCH, so the cluster runs what that ref published.

# GENTIAN_OS_IMAGE_PULL_POLICY=Always
# Always re-pulls a moving tag; IfNotPresent is faster once tags are immutable.

# PORTAL_IMAGE_TAG=develop
# The portal images to run. Match gentian-ui's published tag.

# PORTAL_SKIP_IMAGE_BUILD=true
# Skip the portal image build step entirely.

# INFRA_CHART_REPO=oci://registry.example.com/charts
# Mirror for the infrastructure charts, instead of their upstream repositories.

# INFRA_CHART_PRIVATE=false
# true when that mirror needs the infra-chart-registry credential.
