# Gentian OS installer secrets template
#
# Usage:
#   cp install.secrets.env.template install.secrets.env
#   edit install.secrets.env
#   chmod 600 install.secrets.env
#   ./install.sh
#
# IMPORTANT: Do not commit install.secrets.env.

MASTER_PASSWORD=replace-with-strong-master-password
OD_PRIVATE_REGISTRY_USERNAME=replace-with-registry-username
OD_PRIVATE_REGISTRY_PASSWORD=replace-with-registry-token
OD_SMTP_RELAY_USERNAME=replace-with-smtp-username
OD_SMTP_RELAY_PASSWORD=replace-with-smtp-password

# Optional: only needed for DNS-01 wildcard issuance via Cloudflare.
# Leave empty to skip wildcard and rely on HTTP-01 per-host certs.
# CF_API_TOKEN=
