# Gentian OS installer secrets template
#
# Usage:
#   cp install.secrets.env.template install.secrets.env
#   edit install.secrets.env
#   chmod 600 install.secrets.env
#   ./install.sh
#
# IMPORTANT: Do not commit install.secrets.env.

MASTER_PASSWORD=replace-with-strong-master-password
OD_PRIVATE_REGISTRY_USERNAME=replace-with-registry-username
OD_PRIVATE_REGISTRY_PASSWORD=replace-with-registry-token
# SMTP credentials used for:
#   - external SMTP mode (Nubus direct delivery), and/or
#   - kernel Postfix relay credentials.
OD_SMTP_RELAY_USERNAME=replace-with-smtp-username
OD_SMTP_RELAY_PASSWORD=replace-with-smtp-password

# Optional: only needed for DNS-01 wildcard issuance via Cloudflare.
# Leave empty to skip the kernel wildcard (platform UIs). Tenant apps still need
# DNS-01 per-tenant wildcards via the operator (TENANT_DNS01_CLUSTER_ISSUER).
# Installer verifies the token against a Cloudflare zone derived from KERNEL_DOMAIN.
# Override the derived zone only when needed (e.g. compound public suffixes).
# Optional: only needed when the operator pushes app lifecycle commits to
# gentian-deployments from inside the cluster (App Store install/uninstall).
# Use a fine-scoped GitHub PAT with contents:write on gentian-deployments.
# GENTIAN_DEPLOYMENTS_GIT_TOKEN=
# GENTIAN_DEPLOYMENTS_GIT_USERNAME=x-access-token
