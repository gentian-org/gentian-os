+
+            {{- /* ── Emit database-init resources (when AppProfile requires database.databasePerTenant */}}
+            {{- $dbRequirements := default dict $kr.database }}
+            {{- if and $dbRequirements.databasePerTenant (eq (default "" $dbRequirements.engine) "postgresql") $cnpgHost }}
+            ---
+            apiVersion: kubernetes.crossplane.io/v1alpha2
+            kind: Object
+            metadata:
+              annotations:
+                gotemplating.fn.crossplane.io/composition-resource-name: {{ $app }}-db-init-sa
+              name: {{ $xrName }}-db-init-sa
+            spec:
+              forProvider:
+                manifest:
+                  apiVersion: v1
+                  kind: ServiceAccount
+                  metadata:
+                    name: app-init
+                    namespace: {{ $ns }}
+              providerConfigRef:
+                name: kubernetes
+            ---
+            apiVersion: kubernetes.crossplane.io/v1alpha2
+            kind: Object
+            metadata:
+              annotations:
+                gotemplating.fn.crossplane.io/composition-resource-name: {{ $app }}-db-init-cm
+              name: {{ $xrName }}-db-init-cm
+            spec:
+              forProvider:
+                manifest:
+                  apiVersion: v1
+                  kind: ConfigMap
+                  metadata:
+                    name: {{ $app }}-db-init
+                    namespace: {{ $ns }}
+                  data:
+                    init.sh: |
+                      #!/bin/sh
+                      set -eu
+                      apk add -q --no-progress --no-cache curl jq openssl postgresql-client 2>/dev/null
+                      JWT=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)
+                      BAO_TOKEN=$(curl -sf "${BAO_ADDR}/v1/auth/kubernetes/login" \
+                        -H 'Content-Type: application/json' \
+                        -d "{\"role\":\"app-init\",\"jwt\":\"${JWT}\"}" \
+                        | jq -r '.auth.client_token')
+                      EXISTING=$(curl -sf \
+                        -H "X-Vault-Token: ${BAO_TOKEN}" \
+                        "${BAO_ADDR}/v1/secret/data/gentian-os/tenants/${TENANT}/apps/${APP}/database" \
+                        2>/dev/null || echo '{}')
+                      if echo "${EXISTING}" | jq -e '.data.data.password' >/dev/null 2>&1; then
+                        echo "[db-init] credential already present for ${TENANT}/${APP} — skipping"
+                        exit 0
+                      fi
+                      CNPG=$(curl -sf \
+                        -H "X-Vault-Token: ${BAO_TOKEN}" \
+                        "${BAO_ADDR}/v1/secret/data/gentian-os/kernel/database/cnpg")
+                      SU_USER=$(echo "${CNPG}" | jq -r '.data.data.superuser_username')
+                      SU_PASS=$(echo "${CNPG}" | jq -r '.data.data.superuser_password')
+                      if [ "${SECRET_MODE}" = "random" ]; then
+                        PASSWORD=$(openssl rand -hex 32)
+                      else
+                        MASTER=$(curl -sf \
+                          -H "X-Vault-Token: ${BAO_TOKEN}" \
+                          "${BAO_ADDR}/v1/secret/data/gentian-os/kernel/master-password" \
+                          | jq -r '.data.data.value')
+                        PASSWORD=$(printf '%s:%s:database' "${TENANT}" "${APP}" \
+                          | openssl dgst -sha256 -hmac "${MASTER}" | awk '{print $2}')
+                      fi
+                      ROLE=$(printf '%s_%s' "${TENANT}" "${APP}" | tr '-' '_')
+                      DBNAME="${ROLE}"
+                      export PGPASSWORD="${SU_PASS}"
+                      psql -h "${CNPG_HOST}" -U "${SU_USER}" -d postgres -v ON_ERROR_STOP=1 <<SQL
+                      DO \$\$
+                      BEGIN
+                        IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = '${ROLE}') THEN
+                          CREATE ROLE "${ROLE}" WITH LOGIN PASSWORD '${PASSWORD}';
+                        ELSE
+                          ALTER ROLE "${ROLE}" WITH PASSWORD '${PASSWORD}';
+                        END IF;
+                      END \$\$;
+                      SQL
+                      psql -h "${CNPG_HOST}" -U "${SU_USER}" -d postgres -v ON_ERROR_STOP=1 \
+                        -c "SELECT 'CREATE DATABASE \"${DBNAME}\" OWNER \"${ROLE}\"' WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = '${DBNAME}')" \
+                        | grep -q 'CREATE DATABASE' \
+                        && psql -h "${CNPG_HOST}" -U "${SU_USER}" -d postgres \
+                             -c "CREATE DATABASE \"${DBNAME}\" OWNER \"${ROLE}\"" || true
+                      echo "[db-init] role ${ROLE} and database ${DBNAME} ensured"
+                      curl -sf \
+                        -H "X-Vault-Token: ${BAO_TOKEN}" \
+                        -H 'Content-Type: application/json' \
+                        -X POST \
+                        -d "{\"data\":{\"host\":\"${CNPG_HOST}\",\"port\":\"5432\",\"name\":\"${DBNAME}\",\"user\":\"${ROLE}\",\"password\":\"${PASSWORD}\"}}" \
+                        "${BAO_ADDR}/v1/secret/data/gentian-os/tenants/${TENANT}/apps/${APP}/database"
+                      echo "[db-init] OpenBao credential written for ${TENANT}/${APP}"
+              providerConfigRef:
+                name: kubernetes
+            ---
+            apiVersion: kubernetes.crossplane.io/v1alpha2
+            kind: Object
+            metadata:
+              annotations:
+                gotemplating.fn.crossplane.io/composition-resource-name: {{ $app }}-db-init-job
+              name: {{ $xrName }}-db-init-job
+            spec:
+              forProvider:
+                manifest:
+                  apiVersion: batch/v1
+                  kind: Job
+                  metadata:
+                    name: {{ $app }}-db-init
+                    namespace: {{ $ns }}
+                    labels:
+                      app.kubernetes.io/managed-by: gentian-os
+                      gentianos.io/tenant: {{ $tenant }}
+                      gentianos.io/app: {{ $app }}
+                  spec:
+                    ttlSecondsAfterFinished: 3600
+                    backoffLimit: 10
+                    template:
+                      spec:
+                        serviceAccountName: app-init
+                        restartPolicy: OnFailure
+                        volumes:
+                          - name: scripts
+                            configMap:
+                              name: {{ $app }}-db-init
+                        containers:
+                          - name: database-init
+                            image: alpine:3.20
+                            command:
+                              - /bin/sh
+                              - -c
+                              - apk add -q --no-progress --no-cache curl jq openssl postgresql-client 2>/dev/null && exec /bin/sh /scripts/init.sh
+                            volumeMounts:
+                              - name: scripts
+                                mountPath: /scripts
+                            env:
+                              - name: TENANT
+                                value: {{ $tenant }}
+                              - name: APP
+                                value: {{ $app }}
+                              - name: BAO_ADDR
+                                value: "http://openbao.openbao.svc.cluster.local:8200"
+                              - name: CNPG_HOST
+                                value: {{ $cnpgHost | quote }}
+                              - name: SECRET_MODE
+                                value: {{ $secretMode | quote }}
+              providerConfigRef:
+                name: kubernetes
+            {{- end }}
 
