+                  metadata:
+                    name: {{ $app }}-ldap-init
+                    namespace: {{ $ns }}
+                  data:
+                    init.sh: |
+                      #!/bin/sh
+                      set -eu
+                      apk add -q --no-progress --no-cache curl jq openssl 2>/dev/null
+                      JWT=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)
+                      BAO_TOKEN=$(curl -sf "${BAO_ADDR}/v1/auth/kubernetes/login" \
+                        -H 'Content-Type: application/json' \
+                        -d "{\"role\":\"app-init\",\"jwt\":\"${JWT}\"}" \
+                        | jq -r '.auth.client_token')
+                      EXISTING=$(curl -sf \
+                        -H "X-Vault-Token: ${BAO_TOKEN}" \
+                        "${BAO_ADDR}/v1/secret/data/gentian-os/tenants/${TENANT}/apps/${APP}/ldap" \
+                        2>/dev/null || echo '{}')
+                      if echo "${EXISTING}" | jq -e '.data.data."bind-password"' >/dev/null 2>&1; then
+                        echo "[ldap-init] credential already present for ${TENANT}/${APP} — skipping"
+                        exit 0
+                      fi
+                      if [ "${SECRET_MODE}" = "random" ]; then
+                        PASSWORD=$(openssl rand -hex 32)
+                      else
+                        MASTER=$(curl -sf \
+                          -H "X-Vault-Token: ${BAO_TOKEN}" \
+                          "${BAO_ADDR}/v1/secret/data/gentian-os/kernel/master-password" \
+                          | jq -r '.data.data.value')
+                        PASSWORD=$(printf '%s:%s:ldap-search' "${TENANT}" "${APP}" \
+                          | openssl dgst -sha256 -hmac "${MASTER}" | awk '{print $2}')
+                      fi
+                      NUBUS=$(curl -sf \
+                        -H "X-Vault-Token: ${BAO_TOKEN}" \
+                        "${BAO_ADDR}/v1/secret/data/gentian-os/kernel/identity/nubus")
+                      ADMIN_PW=$(echo "${NUBUS}" | jq -r '.data.data.admin_password')
+                      USERNAME="ldapsearch-${TENANT}-${APP}"
+                      BIND_DN="uid=${USERNAME},cn=users,${LDAP_BASE_DN}"
+                      DN_ENC=$(printf '%s' "${BIND_DN}" | jq -Rr @uri)
+                      HTTP_CREATE=$(curl -sf -o /tmp/resp -w '%{http_code}' \
+                        "${UDM_URL}/univention/udm/users/user/" \
+                        -u "Administrator:${ADMIN_PW}" \
+                        -H 'Content-Type: application/json' \
+                        -d "{\"properties\":{\"username\":\"${USERNAME}\",\"lastname\":\"LDAP-Search\",\"password\":\"${PASSWORD}\",\"primaryGroup\":\"cn=Domain Service Users,cn=groups,${LDAP_BASE_DN}\"},\"position\":\"cn=users,${LDAP_BASE_DN}\"}" \
+                        2>/dev/null || echo '000')
+                      case "${HTTP_CREATE}" in
+                        201) echo "[ldap-init] UDM user ${USERNAME} created" ;;
+                        422|409)
+                          echo "[ldap-init] UDM user ${USERNAME} already exists — updating password"
+                          curl -sf \
+                            "${UDM_URL}/univention/udm/users/user/${DN_ENC}" \
+                            -u "Administrator:${ADMIN_PW}" \
+                            -X PATCH \
+                            -H 'Content-Type: application/json' \
+                            -d "{\"properties\":{\"password\":\"${PASSWORD}\"}}" >/dev/null ;;
+                        *) echo "[ldap-init] ERROR: UDM create HTTP ${HTTP_CREATE}"; cat /tmp/resp; exit 1 ;;
+                      esac
+                      curl -sf \
+                        -H "X-Vault-Token: ${BAO_TOKEN}" \
+                        -H 'Content-Type: application/json' \
+                        -X POST \
+                        -d "{\"data\":{\"bind-dn\":\"${BIND_DN}\",\"bind-password\":\"${PASSWORD}\",\"base-dn\":\"${LDAP_BASE_DN}\"}}" \
+                        "${BAO_ADDR}/v1/secret/data/gentian-os/tenants/${TENANT}/apps/${APP}/ldap"
+                      echo "[ldap-init] OpenBao credential written for ${TENANT}/${APP}"
+              providerConfigRef:
+                name: kubernetes
+            ---
+            apiVersion: kubernetes.crossplane.io/v1alpha2
+            kind: Object
+            metadata:
+              annotations:
+                gotemplating.fn.crossplane.io/composition-resource-name: {{ $app }}-ldap-init-job
+              name: {{ $xrName }}-ldap-init-job
+            spec:
+              forProvider:
+                manifest:
+                  apiVersion: batch/v1
+                  kind: Job
+                  metadata:
+                    name: {{ $app }}-ldap-init
+                    namespace: {{ $ns }}
+                    labels:
