+            {{- /* ── Emit S3-init resources (when AppProfile requires storage.s3.bucketPerTenant) */}}
+            {{- $storageReqs := default dict $kr.storage }}
+            {{- $s3Reqs      := default dict $storageReqs.s3 }}
+            {{- if and $s3Reqs.bucketPerTenant $minioEndpoint }}
+            ---
+            apiVersion: kubernetes.crossplane.io/v1alpha2
+            kind: Object
+            metadata:
+              annotations:
+                gotemplating.fn.crossplane.io/composition-resource-name: {{ $app }}-s3-init-sa
+              name: {{ $xrName }}-s3-init-sa
+            spec:
+              forProvider:
+                manifest:
+                  apiVersion: v1
+                  kind: ServiceAccount
+                  metadata:
+                    name: app-init
+                    namespace: {{ $ns }}
+              providerConfigRef:
+                name: kubernetes
+            ---
+            apiVersion: kubernetes.crossplane.io/v1alpha2
+            kind: Object
+            metadata:
+              annotations:
+                gotemplating.fn.crossplane.io/composition-resource-name: {{ $app }}-s3-init-cm
+              name: {{ $xrName }}-s3-init-cm
+            spec:
+              forProvider:
+                manifest:
+                  apiVersion: v1
+                  kind: ConfigMap
+                  metadata:
+                    name: {{ $app }}-s3-init
+                    namespace: {{ $ns }}
+                  data:
+                    init.sh: |
+                      #!/bin/sh
+                      set -eu
+                      apk add -q --no-progress --no-cache curl jq openssl 2>/dev/null
+                      JWT=$(cat /var/run/secrets/kubernetes.io/serviceaccount/token)
+                      BAO_TOKEN=$(curl -sf "${BAO_ADDR}/v1/auth/kubernetes/login" \
+                        -H 'Content-Type: application/json' \
+                        -d "{\"role\":\"app-init\",\"jwt\":\"${JWT}\"}" \
+                        | jq -r '.auth.client_token')
+                      EXISTING=$(curl -sf \
+                        -H "X-Vault-Token: ${BAO_TOKEN}" \
+                        "${BAO_ADDR}/v1/secret/data/gentian-os/tenants/${TENANT}/apps/${APP}/s3" \
+                        2>/dev/null || echo '{}')
+                      if echo "${EXISTING}" | jq -e '.data.data."secret-key"' >/dev/null 2>&1; then
+                        echo "[s3-init] credential already present for ${TENANT}/${APP} — skipping"
+                        exit 0
+                      fi
+                      MINIO=$(curl -sf \
+                        -H "X-Vault-Token: ${BAO_TOKEN}" \
+                        "${BAO_ADDR}/v1/secret/data/gentian-os/kernel/storage/minio")
+                      ROOT_USER=$(echo "${MINIO}" | jq -r '.data.data.root_user')
+                      ROOT_PASS=$(echo "${MINIO}" | jq -r '.data.data.root_password')
+                      if [ "${SECRET_MODE}" = "random" ]; then
+                        SECRET_KEY=$(openssl rand -hex 32)
+                      else
+                        MASTER=$(curl -sf \
+                          -H "X-Vault-Token: ${BAO_TOKEN}" \
+                          "${BAO_ADDR}/v1/secret/data/gentian-os/kernel/master-password" \
+                          | jq -r '.data.data.value')
+                        SECRET_KEY=$(printf '%s:%s:s3' "${TENANT}" "${APP}" \
+                          | openssl dgst -sha256 -hmac "${MASTER}" | awk '{print $2}')
+                      fi
+                      ACCESS_KEY="${TENANT}-${APP}"
+                      BUCKET="${TENANT}-${APP}"
+                      mc alias set minio "${MINIO_ENDPOINT}" "${ROOT_USER}" "${ROOT_PASS}" >/dev/null
+                      mc mb --ignore-existing "minio/${BUCKET}"
+                      echo "[s3-init] bucket ${BUCKET} ensured"
+                      mc admin user add minio "${ACCESS_KEY}" "${SECRET_KEY}"
+                      echo "[s3-init] MinIO user ${ACCESS_KEY} created"
+                      printf '{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":{"AWS":["arn:aws:iam:::user/%s"]},"Action":["s3:*"],"Resource":["arn:aws:s3:::%s","arn:aws:s3:::%s/*"]}]}' \
+                        "${ACCESS_KEY}" "${BUCKET}" "${BUCKET}" > /tmp/policy.json
+                      mc admin policy create minio "${ACCESS_KEY}-policy" /tmp/policy.json
+                      mc admin policy attach minio "${ACCESS_KEY}-policy" --user "${ACCESS_KEY}"
+                      echo "[s3-init] bucket policy attached"
+                      curl -sf \
+                        -H "X-Vault-Token: ${BAO_TOKEN}" \
+                        -H 'Content-Type: application/json' \
+                        -X POST \
+                        -d "{\"data\":{\"endpoint\":\"${MINIO_ENDPOINT}\",\"bucket\":\"${BUCKET}\",\"access-key\":\"${ACCESS_KEY}\",\"secret-key\":\"${SECRET_KEY}\",\"region\":\"us-east-1\"}}" \
+                        "${BAO_ADDR}/v1/secret/data/gentian-os/tenants/${TENANT}/apps/${APP}/s3"
+                      echo "[s3-init] OpenBao credential written for ${TENANT}/${APP}"
+              providerConfigRef:
+                name: kubernetes
