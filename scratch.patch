+                              name: {{ $app }}-ldap-init
+                        containers:
+                          - name: ldap-search-init
+                            image: alpine:3.20
+                            command:
+                              - /bin/sh
+                              - -c
+                              - apk add -q --no-progress --no-cache curl jq openssl 2>/dev/null && exec /bin/sh /scripts/init.sh
+                            volumeMounts:
+                              - name: scripts
+                                mountPath: /scripts
+                            env:
+                              - name: TENANT
+                                value: {{ $tenant }}
+                              - name: APP
+                                value: {{ $app }}
+                              - name: BAO_ADDR
+                                value: "http://openbao.openbao.svc.cluster.local:8200"
+                              - name: UDM_URL
+                                value: {{ $udmUrl | quote }}
+                              - name: LDAP_BASE_DN
+                                value: {{ $ldapBaseDn | quote }}
+                              - name: SECRET_MODE
+                                value: {{ $secretMode | quote }}
+              providerConfigRef:
+                name: kubernetes
