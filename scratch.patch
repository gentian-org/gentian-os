+                    namespace: {{ $ns }}
+                    labels:
+                      app.kubernetes.io/managed-by: gentian-os
+                      gentianos.io/tenant: {{ $tenant }}
+                      gentianos.io/app: {{ $app }}
+                  spec:
+                    ttlSecondsAfterFinished: 3600
+                    backoffLimit: 10
+                    template:
+                      spec:
+                        serviceAccountName: app-init
+                        restartPolicy: OnFailure
+                        volumes:
+                          - name: scripts
+                            configMap:
+                              name: {{ $app }}-s3-init
+                        containers:
+                          - name: s3-init
+                            image: minio/mc:latest
+                            command:
+                              - /bin/sh
+                              - -c
+                              - apk add -q --no-progress --no-cache curl jq openssl 2>/dev/null && exec /bin/sh /scripts/init.sh
+                            volumeMounts:
+                              - name: scripts
+                                mountPath: /scripts
+                            env:
+                              - name: TENANT
+                                value: {{ $tenant }}
+                              - name: APP
+                                value: {{ $app }}
+                              - name: BAO_ADDR
+                                value: "http://openbao.openbao.svc.cluster.local:8200"
+                              - name: MINIO_ENDPOINT
+                                value: {{ $minioEndpoint | quote }}
+                              - name: SECRET_MODE
+                                value: {{ $secretMode | quote }}
+              providerConfigRef:
