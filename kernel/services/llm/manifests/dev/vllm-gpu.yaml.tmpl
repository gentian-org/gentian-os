# Real vLLM inference backend (GPU_ACCELERATION=true). Replaces vllm-mock.yaml.
#
# To change the served model: edit VLLM_MODEL_ID below, commit, and run
# `./update.sh --llm`. See docs/design/agentic-ai.md §10.2 for the full
# CLI-flag cheat-sheet and how to add a model to LiteLLM afterwards.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: vllm-model-cache
  namespace: platform-kernel
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      # HF model caches run 15-40GB per 7-8B model; bump if you serve
      # multiple models or switch to a larger one.
      storage: 60Gi
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: vllm-inference
  namespace: platform-kernel
spec:
  replicas: 1
  strategy:
    type: Recreate # only one GPU slice budget is planned per replica; avoid two pods racing for it mid-rollout
  selector:
    matchLabels:
      app: vllm-inference
  template:
    metadata:
      labels:
        app: vllm-inference
    spec:
      nodeSelector:
        nvidia.com/gpu.present: "true"
      containers:
      - name: vllm-server
        image: vllm/vllm-openai:latest
        command: ["/bin/sh", "-c"]
        args:
          - |
            exec vllm serve "${VLLM_MODEL_ID}" \
              --host 0.0.0.0 --port 8000 \
              --gpu-memory-utilization "${VLLM_GPU_MEMORY_UTILIZATION}" \
              --max-model-len "${VLLM_MAX_MODEL_LEN}" \
              --enable-prefix-caching
        env:
        # No HuggingFace gating on Qwen2.5 — swap freely for other ungated
        # models. Gated models (e.g. Llama) additionally need HUGGING_FACE_HUB_TOKEN
        # below (create the vllm-hf-token Secret first — see agentic-ai.md §10.2).
        - name: VLLM_MODEL_ID
          value: "Qwen/Qwen2.5-7B-Instruct"
        # 24GB card, 4-way time-sliced with no memory isolation between
        # slices (see gpu-sharing.yaml) — stay well under 1.0 so this pod
        # doesn't starve/OOM its neighbors.
        - name: VLLM_GPU_MEMORY_UTILIZATION
          value: "0.85"
        - name: VLLM_MAX_MODEL_LEN
          value: "8192"
        - name: HUGGING_FACE_HUB_TOKEN
          valueFrom:
            secretKeyRef:
              name: vllm-hf-token
              key: token
              optional: true
        ports:
        - containerPort: 8000
          name: http
        resources:
          limits:
            nvidia.com/gpu: "1"
          requests:
            nvidia.com/gpu: "1"
            cpu: "2"
            memory: 8Gi
        volumeMounts:
        - name: model-cache
          mountPath: /root/.cache/huggingface
        # Model download + weight load can take minutes on first pull.
        startupProbe:
          httpGet:
            path: /health
            port: 8000
          periodSeconds: 15
          failureThreshold: 80 # ~20 minutes
        readinessProbe:
          httpGet:
            path: /health
            port: 8000
          periodSeconds: 15
          failureThreshold: 3
      volumes:
      - name: model-cache
        persistentVolumeClaim:
          claimName: vllm-model-cache
---
apiVersion: v1
kind: Service
metadata:
  name: vllm-inference
  namespace: platform-kernel
spec:
  ports:
  - port: 8000
    targetPort: 8000
  selector:
    app: vllm-inference
