# Real vLLM inference backend (GPU_ACCELERATION=true). Replaces vllm-mock.yaml.
#
# Rendered from this .tmpl by render_vllm_gpu_manifest() (scripts/llm-lib.sh)
# via VLLM_MODEL_ID/VLLM_GPU_MEMORY_UTILIZATION/VLLM_MAX_MODEL_LEN/
# VLLM_MODEL_CACHE_SIZE/VLLM_IMAGE_TAG — cluster-specific instance data, not
# gentian-os defaults. To change the served model: set VLLM_MODEL_ID (and
# friends) in gentian-deployments' clusters/<cluster>/kernel/cluster-settings.env,
# then run `./update.sh --llm`. See docs/design/agentic-ai.md §10.2 for the
# full CLI-flag cheat-sheet and how to add a model to LiteLLM afterwards.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: vllm-model-cache
  namespace: platform-kernel
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      # HF model caches run 15-40GB per 7-8B model; bump (VLLM_MODEL_CACHE_SIZE)
      # if you serve multiple models or switch to a larger one.
      storage: %VLLM_MODEL_CACHE_SIZE%
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: vllm-inference
  namespace: platform-kernel
spec:
  replicas: 1
  strategy:
    type: Recreate # only one GPU slice budget is planned per replica; avoid two pods racing for it mid-rollout
  selector:
    matchLabels:
      app: vllm-inference
  template:
    metadata:
      labels:
        app: vllm-inference
    spec:
      nodeSelector:
        nvidia.com/gpu.present: "true"
      containers:
      - name: vllm-server
        image: vllm/vllm-openai:%VLLM_IMAGE_TAG%
        command: ["/bin/sh", "-c"]
        args:
          - |
            exec vllm serve "${VLLM_MODEL_ID}" \
              --host 0.0.0.0 --port 8000 \
              --gpu-memory-utilization "${VLLM_GPU_MEMORY_UTILIZATION}" \
              --max-model-len "${VLLM_MAX_MODEL_LEN}" \
              --enable-prefix-caching
        env:
        # Which model to swap in is cluster instance data (cluster-settings.env),
        # not a gentian-os default — see the header comment above. Gated models
        # (e.g. Llama) additionally need HUGGING_FACE_HUB_TOKEN below (create the
        # vllm-hf-token Secret first — see agentic-ai.md §10.2).
        - name: VLLM_MODEL_ID
          value: "%VLLM_MODEL_ID%"
        # Depends on this cluster's GPU/sharing config (see gpu-sharing.yaml.tmpl) —
        # stay well under 1.0 so this pod doesn't starve/OOM its neighbors.
        - name: VLLM_GPU_MEMORY_UTILIZATION
          value: "%VLLM_GPU_MEMORY_UTILIZATION%"
        - name: VLLM_MAX_MODEL_LEN
          value: "%VLLM_MAX_MODEL_LEN%"
        - name: HUGGING_FACE_HUB_TOKEN
          valueFrom:
            secretKeyRef:
              name: vllm-hf-token
              key: token
              optional: true
        ports:
        - containerPort: 8000
          name: http
        resources:
          limits:
            nvidia.com/gpu: "1"
          requests:
            nvidia.com/gpu: "1"
            cpu: "2"
            memory: 8Gi
        volumeMounts:
        - name: model-cache
          mountPath: /root/.cache/huggingface
        # Model download + weight load can take minutes on first pull.
        startupProbe:
          httpGet:
            path: /health
            port: 8000
          periodSeconds: 15
          failureThreshold: 80 # ~20 minutes
        readinessProbe:
          httpGet:
            path: /health
            port: 8000
          periodSeconds: 15
          failureThreshold: 3
      volumes:
      - name: model-cache
        persistentVolumeClaim:
          claimName: vllm-model-cache
---
apiVersion: v1
kind: Service
metadata:
  name: vllm-inference
  namespace: platform-kernel
spec:
  ports:
  - port: 8000
    targetPort: 8000
  selector:
    app: vllm-inference
