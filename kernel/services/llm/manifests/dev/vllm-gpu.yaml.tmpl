# NOTE: this header is a sed substitution target (see below) — every
# %TOKEN% placeholder name mentioned here would itself get replaced if
# written literally, so this comment spells them without the %...%
# wrapper on purpose.
#
# One of possibly several real vLLM inference backends (GPU_ACCELERATION=true).
# Replaces vllm-mock.yaml. One gentian-os cluster can run multiple named vLLM
# instances (e.g. a small always-on chat model plus a larger on-demand one) —
# each instance gets its own PVC/Deployment/Service, named vllm-INSTANCE-*
# so they don't collide, and its own entry in LiteLLM (one shared LiteLLM
# proxy in front of however many vLLM instances exist — see llm-services.yaml).
#
# Rendered from this .tmpl once per entry in VLLM_INSTANCES by
# render_and_apply_vllm_gpu_manifest() (scripts/llm-lib.sh), substituting
# INSTANCE/MODEL_ID/GPU_MEMORY_UTILIZATION/MAX_MODEL_LEN/MODEL_CACHE_SIZE/
# IMAGE_TAG — cluster instance data, not gentian-os defaults. To
# add/change/remove an instance: edit VLLM_INSTANCES (and friends) in
# gentian-deployments' clusters/<cluster>/kernel/cluster-settings.env,
# then run `./update.sh --llm`. See docs/design/agentic-ai.md §10.2 for
# the full flag cheat-sheet.
apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: vllm-%VLLM_INSTANCE%-model-cache
  namespace: platform-kernel
  labels:
    app.kubernetes.io/component: vllm-instance
    gentianos.io/vllm-instance: "%VLLM_INSTANCE%"
spec:
  accessModes: ["ReadWriteOnce"]
  resources:
    requests:
      # HF model caches run 15-40GB per 7-8B model; bump (VLLM_<INSTANCE>_MODEL_CACHE_SIZE)
      # for a larger model.
      storage: %VLLM_MODEL_CACHE_SIZE%
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: vllm-%VLLM_INSTANCE%-inference
  namespace: platform-kernel
  labels:
    app.kubernetes.io/component: vllm-instance
    gentianos.io/vllm-instance: "%VLLM_INSTANCE%"
spec:
  replicas: 1
  strategy:
    type: Recreate # only one GPU slice budget is planned per replica; avoid two pods racing for it mid-rollout
  selector:
    matchLabels:
      app: vllm-%VLLM_INSTANCE%-inference
  template:
    metadata:
      labels:
        app: vllm-%VLLM_INSTANCE%-inference
        app.kubernetes.io/component: vllm-instance
        gentianos.io/vllm-instance: "%VLLM_INSTANCE%"
    spec:
      nodeSelector:
        nvidia.com/gpu.present: "true"
      containers:
      - name: vllm-server
        image: vllm/vllm-openai:%VLLM_IMAGE_TAG%
        command: ["/bin/sh", "-c"]
        args:
          - |
            exec vllm serve "${VLLM_MODEL_ID}" \
              --host 0.0.0.0 --port 8000 \
              --gpu-memory-utilization "${VLLM_GPU_MEMORY_UTILIZATION}" \
              --max-model-len "${VLLM_MAX_MODEL_LEN}" \
              --enable-prefix-caching
        env:
        # Which model to swap in is cluster instance data (cluster-settings.env),
        # not a gentian-os default — see the header comment above. Gated models
        # (e.g. Llama) additionally need HUGGING_FACE_HUB_TOKEN below (create the
        # vllm-hf-token Secret first — see agentic-ai.md §10.2; shared across
        # every instance — one HF account token covers whatever it's licensed for).
        - name: VLLM_MODEL_ID
          value: "%VLLM_MODEL_ID%"
        # Depends on this cluster's GPU/sharing config (see gpu-sharing.yaml.tmpl)
        # and how many OTHER instances/workloads share the same card(s) — stay
        # well under 1.0, and under what's left after every other instance's
        # own budget, so this pod doesn't starve/OOM its neighbors.
        - name: VLLM_GPU_MEMORY_UTILIZATION
          value: "%VLLM_GPU_MEMORY_UTILIZATION%"
        - name: VLLM_MAX_MODEL_LEN
          value: "%VLLM_MAX_MODEL_LEN%"
        - name: HUGGING_FACE_HUB_TOKEN
          valueFrom:
            secretKeyRef:
              name: vllm-hf-token
              key: token
              optional: true
        ports:
        - containerPort: 8000
          name: http
        resources:
          limits:
            nvidia.com/gpu: "1"
          requests:
            nvidia.com/gpu: "1"
            cpu: "2"
            memory: 8Gi
        volumeMounts:
        - name: model-cache
          mountPath: /root/.cache/huggingface
        # Model download + weight load can take minutes on first pull.
        startupProbe:
          httpGet:
            path: /health
            port: 8000
          periodSeconds: 15
          failureThreshold: 80 # ~20 minutes
        readinessProbe:
          httpGet:
            path: /health
            port: 8000
          periodSeconds: 15
          failureThreshold: 3
      volumes:
      - name: model-cache
        persistentVolumeClaim:
          claimName: vllm-%VLLM_INSTANCE%-model-cache
---
apiVersion: v1
kind: Service
metadata:
  name: vllm-%VLLM_INSTANCE%-inference
  namespace: platform-kernel
  labels:
    app.kubernetes.io/component: vllm-instance
    gentianos.io/vllm-instance: "%VLLM_INSTANCE%"
spec:
  ports:
  - port: 8000
    targetPort: 8000
  selector:
    app: vllm-%VLLM_INSTANCE%-inference
