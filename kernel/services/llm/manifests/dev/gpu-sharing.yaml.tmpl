# Must be named/namespaced exactly as referenced by the GPU Operator's
# ClusterPolicy (spec.devicePlugin.config.name) — the operator's device
# plugin daemonset only reads config from its own namespace.
#
# How many virtual slices to carve each physical GPU into is specific to
# this cluster's hardware, not a gentian-os default — rendered from
# GPU_TIME_SLICE_REPLICAS in cluster-settings.env (see render_and_apply_
# gpu_sharing_manifest, scripts/llm-lib.sh).
apiVersion: v1
kind: ConfigMap
metadata:
  name: time-slicing-config
  namespace: gpu-operator-resources
data:
  time-slicing-config.yaml: |
    version: v1
    sharing:
      timeSlicing:
        resources:
        - name: nvidia.com/gpu
          replicas: %GPU_TIME_SLICE_REPLICAS%
