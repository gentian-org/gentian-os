nant app credentials (ESO distributes to namespaces)\npath \"secret/data/gentian-os/tenants/*/apps/*/*\" {\n  capabilities = [\"read\"]\n}\npath \"secret/metadata/gentian-os/tenants/*\" {\n  capabilities = [\"list\"]\n}\n"},"sensitive_attributes":[],"private":"bnVsbA=="}]},{"mode":"managed","type":"vault_policy","name":"tofu_write","provider":"provider[\"registry.opentofu.org/hashicorp/vault\"]","instances":[{"schema_version":0,"attributes":{"id":"tofu-write","name":"tofu-write","namespace":null,"policy":"# Read/write access for Tofu runner to manage all gentian-os secrets\npath \"secret/data/gentian-os/*\" {\n  capabilities = [\"create\", \"read\", \"update\", \"delete\"]\n}\n\npath \"secret/metadata/gentian-os/*\" {\n  capabilities = [\"list\", \"read\", \"delete\"]\n}\n\n# The vault provider creates a limited child token for each operation.\n# This requires auth/token/create capability on the token itself.\npath \"auth/token/create\" {\n  capabilities = [\"update\"]\n}\n\n# Allow the runner to look up its own token (required by vault provider v4).\npath \"auth/token/lookup-self\" {\n  capabilities = [\"read\"]\n}\n"},"sensitive_attributes":[],"private":"bnVsbA=="}]}],"check_results":null}
