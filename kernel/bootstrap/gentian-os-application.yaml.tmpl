---
# Bootstrap Application: manages the gentian-os operator via ArgoCD.
#
# Intentionally contains ONLY the operator (Helm chart + ImageUpdater CR).
# Tenant CRs live in the separate `gentian-tenants` Application so that
# long-running tenant provisioning never stalls operator image rollouts:
# argocd-image-updater targets only `gentian-os`, which is a clean Helm
# deployment.  When a new image lands in GHCR, ArgoCD syncs it in seconds
# regardless of tenant health.
#
# Sources:
#   Source 1: gentian-os Helm chart — operator Deployment, CRDs, RBAC, etc.
#   Source 2: gentian-deployments ref only — provides the $deploy variable
#             for Source 1's valueFiles; renders no manifests.
#   Source 3: gentian-deployments %ENV%/kernel — ImageUpdater CR.
#
# Placeholders filled in by install_orchestrator() in scripts/install-lib.sh:
#   %GENTIAN_OS_BRANCH%   — branch/tag of this repo (e.g. develop, main, v1.2.3)
#   %DEPLOYMENTS_REPO%    — gentian-deployments repo URL
#   %DEPLOYMENTS_BRANCH%  — gentian-deployments branch
#   %ENV%                 — environment name (dev / staging / prod)
#
# Apply:
#   Rendered and applied automatically by install.sh Step 15.
#   For day-2 re-apply (e.g. to fix a missing Application):
#     source install.env && source install.secrets.env
#     sed -e "s|%GENTIAN_OS_BRANCH%|develop|g" \
#         -e "s|%DEPLOYMENTS_REPO%|${GENTIAN_DEPLOYMENTS_REPO}|g" \
#         -e "s|%DEPLOYMENTS_BRANCH%|${GENTIAN_DEPLOYMENTS_BRANCH}|g" \
#         -e "s|%ENV%|dev|g" \
#         kernel/bootstrap/gentian-os-application.yaml.tmpl | kubectl apply -f -
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: gentian-os
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "0"
    # Image updater: follow new builds published for %GENTIAN_OS_BRANCH% and
    # update image.tag in the Application's Helm parameters so ArgoCD triggers
    # a Helm upgrade (rolling restart) whenever a new image lands in GHCR.
    argocd-image-updater.argoproj.io/image-list: gentianos=ghcr.io/gentian-org/gentian-os:%GENTIAN_OS_BRANCH%
    argocd-image-updater.argoproj.io/gentianos.update-strategy: newest-build
    argocd-image-updater.argoproj.io/gentianos.helm.image-name: image.repository
    argocd-image-updater.argoproj.io/gentianos.helm.image-tag: image.tag
    argocd-image-updater.argoproj.io/write-back-method: argocd
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: gentian
  ignoreDifferences:
  - group: admissionregistration.k8s.io
    kind: ValidatingWebhookConfiguration
    name: gentian-os-tenant-validator
    jsonPointers:
    - /webhooks/0/clientConfig/caBundle
  - group: apps
    kind: Deployment
    name: gentian-os
    namespace: gentian-system
    jsonPointers:
    - /metadata/annotations
    - /spec/template/metadata/annotations/kubectl.kubernetes.io~1restartedAt
  # Crossplane enriches the apps.gentianos.io CRD with additional printer
  # columns and its own spec properties (compositionRef, resourceRefs, etc.)
  # after the initial install. Ignore spec.versions drift so ArgoCD does not
  # report permanent OutOfSync noise.
  - group: apiextensions.k8s.io
    kind: CustomResourceDefinition
    name: apps.gentianos.io
    jsonPointers:
    - /spec/versions
  sources:
  # Source 1: gentian-os Helm chart (operator)
  # Values come from $deploy (%ENV%/kernel/values-%ENV%.yaml in the
  # deployments repo).  image.tag is further overridden in-cluster by
  # argocd-image-updater via the Application's Helm parameters.
  - repoURL: https://github.com/gentian-org/gentian-os
    targetRevision: %GENTIAN_OS_BRANCH%
    path: charts/gentian-os
    helm:
      valueFiles:
      - $deploy/%ENV%/kernel/values-%ENV%.yaml
  # Source 2: deployments ref only (provides $deploy variable, no manifests)
  - repoURL: %DEPLOYMENTS_REPO%
    targetRevision: %DEPLOYMENTS_BRANCH%
    ref: deploy
  # Source 3: Environment kernel config (ImageUpdater CR)
  # Deploying this CR activates automatic image updates.
  - repoURL: %DEPLOYMENTS_REPO%
    targetRevision: %DEPLOYMENTS_BRANCH%
    path: %ENV%/kernel
    directory:
      include: "image-updater.yaml"
  destination:
    server: https://kubernetes.default.svc
    namespace: gentian-system
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
    - ServerSideApply=true
---
# Bootstrap Application: manages Tenant CRs via ArgoCD.
#
# Kept separate from `gentian-os` so that long-running tenant provisioning
# never blocks operator image rollouts. argocd-image-updater targets only
# `gentian-os`, so a new operator build deploys in seconds regardless of
# tenant health.
#
# Same placeholders as the gentian-os Application above.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: gentian-tenants
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "2"
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: gentian
  source:
    repoURL: %DEPLOYMENTS_REPO%
    targetRevision: %DEPLOYMENTS_BRANCH%
    path: %ENV%/tenants
  destination:
    server: https://kubernetes.default.svc
    namespace: gentian-system
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
    - ServerSideApply=true
