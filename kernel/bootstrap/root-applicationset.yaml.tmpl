---
# Bootstrap Application: deploys all ApplicationSet manifests from appsets/ to the cluster.
# kernel/appsets is a tiny Helm chart (Chart.yaml + values.yaml + a single
# template that passes raw/*.yaml through verbatim, only substituting the
# "env: dev" generator element for the cluster's actual stage — see
# kernel/appsets/templates/appsets.yaml). Adding a new app = add
# appsets/raw/<app>.yaml. Removing one = delete the file.
# ${GENTIAN_DEPLOYMENTS_STAGE} is substituted by install.sh (envsubst) —
# this file is a .tmpl, not applied directly.
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: gentian-appsets
  namespace: argocd
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: gentian
  ignoreDifferences:
  - group: argoproj.io
    kind: ApplicationSet
    jsonPointers:
    - /metadata/annotations/argocd.argoproj.io~1tracking-id
  # ArgoCD adds post-delete finalizers to a child Application whose chart has a
  # PostDelete hook — kyverno's policyReportsCleanup is one. Git cannot declare
  # them (ArgoCD owns them, and they appear only after the child first syncs), so
  # with ServerSideApply + selfHeal the parent strips them, ArgoCD re-adds them,
  # and the parent stays OutOfSync forever. They are runtime state, not desired
  # config, so exclude them from the diff.
  #
  # This does not stop finalizers from being applied: ignoreDifferences affects
  # only the diff, so a newly created child still gets the resources-finalizer
  # declared in kernel/appsets/raw/.
  - group: argoproj.io
    kind: Application
    jsonPointers:
    - /metadata/finalizers
  source:
    repoURL: https://github.com/gentian-org/gentian-os
    targetRevision: develop
    path: kernel/appsets
    helm:
      parameters:
      - name: stage
        value: "${GENTIAN_DEPLOYMENTS_STAGE}"
      # Reaches the per-service charts through kernel/appsets, which rewrites
      # the kernel.domain.placeholder literal in raw/*.yaml. Postfix needs it
      # for ALLOWED_SENDER_DOMAINS; without a real value it rejects every
      # recipient with 554 "Access denied".
      - name: kernelDomain
        value: "${KERNEL_DOMAIN}"
  destination:
    server: https://kubernetes.default.svc
    namespace: argocd
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - ServerSideApply=true
