---
# Syncs app catalogue profile bundles from gentian-apps into the cluster.
#
# One Argo CD Application per profile bundle, discovered by its profile.yaml.
# Each bundle may contain:
#   profile.yaml       — AppProfile CR
#   composition.yaml   — optional Crossplane Composition (spec.compositionRef)
#   customizations/    — optional Customization CRs (docs/app-customization.md)
#   assets/            — optional cluster-scoped prerequisites (ConfigMaps, …)
#
# A **files** generator (not directories) is deliberate: gentian-apps groups
# profiles at mixed depth — singletons at profiles/<family>/<name>/, families with
# addons at profiles/<family>/{base,addons,packages}/<name>/. Matching a marker file
# rather than a fixed directory depth supports both without an exclude-list of
# "known family folders", and makes intermediate directories invisible to the
# generator instead of turning them into Applications that fail to sync.
#
# The marker is profile.yaml rather than kustomization.yaml because the files
# generator parses the matched file into template parameters. That lets the
# Application be named after the AppProfile it actually manages
# (.metadata.name) instead of after its directory.
#
# Naming from the CR rather than the path matters: AppProfile is cluster-scoped, so
# metadata.name is globally unique by definition, whereas leaf directory names are
# not — profiles/odoo/addons/crm-ce and a future profiles/foo/addons/crm-ce would
# both basename to "crm-ce" and collide. It also frees directories to be named for
# readability (addons/crm-ce, not addons/odoo-crm-ce) without renaming Applications,
# and keeps a move a source-path update in place rather than a delete/recreate that
# would prune the live AppProfile.
#
# CI still requires a kustomization.yaml beside every profile.yaml — without one the
# bundle is generated but cannot be rendered.
#
# Replaces the legacy gentian-appprofiles Application (flat profiles/*.yaml only).
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: gentian-catalogue
  namespace: argocd
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]
  generators:
  - git:
      repoURL: %REPO_URL%
      revision: %BRANCH%
      files:
      - path: profiles/**/profile.yaml
  template:
    metadata:
      name: 'catalogue-{{ .metadata.name }}'
      finalizers:
      - resources-finalizer.argocd.argoproj.io
    spec:
      project: gentian
      source:
        repoURL: %REPO_URL%
        targetRevision: %BRANCH%
        path: '{{ .path.path }}'
      destination:
        server: https://kubernetes.default.svc
        namespace: gentian-system
      ignoreDifferences:
      - group: gentianos.io
        kind: AppProfile
        jsonPointers:
        - /metadata/annotations/argocd.argoproj.io~1tracking-id
      - group: gentianos.io
        kind: AppProfile
        jqPathExpressions:
        - .spec.ingress.clusterIssuer
        - .spec.kernelRequirements.database.allowDynamicDatabaseCreation
        - .spec.additionalIngresses[]?.clusterIssuer
        - .spec.browserProxy[]?.authMode
        - .spec.browserProxy[]?.stripPrefix
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
        - CreateNamespace=false
        - ServerSideApply=true
