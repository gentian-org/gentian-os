---
# Syncs app catalogue profile bundles from gentian-apps into the cluster.
#
# One Argo CD Application per profile bundle, discovered by the presence of a
# kustomization.yaml. Each bundle may contain:
#   profile.yaml       — AppProfile CR
#   composition.yaml   — optional Crossplane Composition (spec.compositionRef)
#   customizations/    — optional Customization CRs (docs/app-customization.md)
#   assets/            — optional cluster-scoped prerequisites (ConfigMaps, …)
#
# A **files** generator (not directories) is deliberate: gentian-apps groups
# profiles by spec.family at mixed depth — singletons sit at profiles/<name>/,
# multi-profile families at profiles/<family>/<name>/. Matching the marker file
# rather than a fixed directory depth supports both without an exclude-list of
# "known family folders", and makes intermediate family directories (which have
# no kustomization.yaml) invisible to the generator instead of failed syncs.
#
# Application names use .path.basename — the bundle's leaf directory. That name
# is required by CI to equal the AppProfile's metadata.name, and AppProfile is
# cluster-scoped, so leaf names are globally unique by construction and cannot
# collide across families. It also means regrouping a profile into a family
# directory does NOT rename its Application: the move is a source-path update
# in place, with no delete/recreate cycle and no prune of live AppProfile CRs.
#
# Replaces the legacy gentian-appprofiles Application (flat profiles/*.yaml only).
apiVersion: argoproj.io/v1alpha1
kind: ApplicationSet
metadata:
  name: gentian-catalogue
  namespace: argocd
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  goTemplate: true
  goTemplateOptions: ["missingkey=error"]
  generators:
  - git:
      repoURL: %REPO_URL%
      revision: %BRANCH%
      files:
      - path: profiles/**/kustomization.yaml
  template:
    metadata:
      name: 'catalogue-{{ .path.basename }}'
      finalizers:
      - resources-finalizer.argocd.argoproj.io
    spec:
      project: gentian
      source:
        repoURL: %REPO_URL%
        targetRevision: %BRANCH%
        path: '{{ .path.path }}'
      destination:
        server: https://kubernetes.default.svc
        namespace: gentian-system
      ignoreDifferences:
      - group: gentianos.io
        kind: AppProfile
        jsonPointers:
        - /metadata/annotations/argocd.argoproj.io~1tracking-id
      - group: gentianos.io
        kind: AppProfile
        jqPathExpressions:
        - .spec.ingress.clusterIssuer
        - .spec.kernelRequirements.database.allowDynamicDatabaseCreation
        - .spec.additionalIngresses[]?.clusterIssuer
        - .spec.browserProxy[]?.authMode
        - .spec.browserProxy[]?.stripPrefix
      syncPolicy:
        automated:
          prune: true
          selfHeal: true
        syncOptions:
        - CreateNamespace=false
        - ServerSideApply=true
