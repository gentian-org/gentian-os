---
# Syncs AppProfile CRs from the gentian-apps repository into the cluster.
# This is what makes `kubectl gentian apps list` populated: ArgoCD applies the
# YAMLs under profiles/ to the cluster as cluster-scoped AppProfile resources,
# the gentian-os AppStore controller picks them up and projects them into the
# AppCatalogue singleton, and the kubectl-gentian plugin reads from there.
#
# This file is a template rendered by install.sh — the repo URL and branch
# placeholders below are filled in based on the user's choice (defaults:
# https://github.com/gentian-org/gentian-apps @ main).
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: gentian-appprofiles
  namespace: argocd
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: gentian
  source:
    repoURL: %REPO_URL%
    targetRevision: %BRANCH%
    path: profiles
    directory:
      recurse: false   # AppProfiles are cluster-scoped YAML files at profiles/*.yaml
  destination:
    server: https://kubernetes.default.svc
    namespace: gentian-system   # AppProfile is cluster-scoped; namespace is nominal
  ignoreDifferences:
  # ArgoCD adds its own tracking annotation to managed resources after apply.
  # This annotation is absent from the source YAMLs, which causes a perpetual
  # OutOfSync loop when client-side apply is used (3-way merge removes it).
  # Ignoring it here breaks the loop; ServerSideApply=true below avoids it
  # for resources managed purely via SSA (no last-applied-configuration).
  - group: gentianos.io
    kind: AppProfile
    jsonPointers:
    - /metadata/annotations/argocd.argoproj.io~1tracking-id
  # AppProfile CRD kubebuilder defaults (clusterIssuer, allowDynamicDatabaseCreation,
  # browserProxy authMode/stripPrefix) are injected by the API server on write but
  # absent from git source YAMLs — ignore to avoid perpetual OutOfSync.
  - group: gentianos.io
    kind: AppProfile
    jqPathExpressions:
    - .spec.ingress.clusterIssuer
    - .spec.kernelRequirements.database.allowDynamicDatabaseCreation
    - .spec.additionalIngresses[]?.clusterIssuer
    - .spec.browserProxy[]?.authMode
    - .spec.browserProxy[]?.stripPrefix
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=false
    - ServerSideApply=true
