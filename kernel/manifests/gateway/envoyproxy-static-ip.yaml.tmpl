# Envoy Gateway data-plane Service overrides for NETWORK_MODE=static-ip.
#
# Applied by install.sh Step 2c (scripts/lib/certs.sh, _pin_static_ip_edge_address)
# only when NETWORK_MODE=static-ip. Referenced from the gentian-envoy GatewayClass
# via spec.parametersRef.
#
# Why this exists
# ---------------
# With NETWORK_MODE=static-ip the data-plane Service is type LoadBalancer, so the
# cloud controller provisions a load balancer and — by default — allocates a NEW
# public address for it. NODE_IP is then whatever the operator wrote into
# cluster-settings.env, which is not the address traffic actually arrives on:
# DNS points one place, the load balancer answers on another.
#
# How the address is claimed differs per provider, which is why the annotations
# below are generated rather than hardcoded — see _edge_lb_annotations() in
# scripts/lib/certs.sh and LB_PROVIDER / LB_ANNOTATIONS in cluster-settings.env:
#
#   metallb    spec.loadBalancerIP, or metallb.universe.tf/loadBalancerIPs.
#              The address must sit inside a configured IPAddressPool.
#   openstack  spec.loadBalancerIP adopts an existing, UNASSOCIATED floating IP.
#              keep-floatingip stops it being released on Service deletion.
#   gcp        spec.loadBalancerIP, with a reserved regional static address.
#   aws        NLBs ignore spec.loadBalancerIP entirely; the address comes from
#              service.beta.kubernetes.io/aws-load-balancer-eip-allocations.
#              certs.sh therefore omits loadBalancerIP when LB_PROVIDER=aws.
#   tunnel     Not applicable — NETWORK_MODE=tunnel keeps the Service ClusterIP
#              and this file is never applied.
#
# Timing matters
# --------------
# Most cloud controllers honour loadBalancerIP only at Service *creation*, never
# on update (e.g. kubernetes/cloud-provider-openstack#2443). That is why this is
# applied in Step 2c, before the operator creates kernel-public-gateway and Envoy
# Gateway materialises the data-plane Service.
#
# spec.loadBalancerIP is deprecated upstream (Kubernetes v1.24) but remains the
# only cross-provider field for this; the per-provider annotations above are the
# supported successor and are emitted alongside it.
apiVersion: gateway.envoyproxy.io/v1alpha1
kind: EnvoyProxy
metadata:
  name: gentian-edge
  namespace: ${ENVOY_GATEWAY_NAMESPACE}
  labels:
    app.kubernetes.io/managed-by: gentian-os
spec:
  provider:
    type: Kubernetes
    kubernetes:
      envoyService:
        type: LoadBalancer
${EDGE_LB_ADDRESS_FIELD}
${EDGE_LB_ANNOTATIONS}
