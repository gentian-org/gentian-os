# Cluster XR claim template — used by install.sh via envsubst.
# Variables substituted at install time:
#   KERNEL_DOMAIN         (required) — e.g. desk.example.com
#   LDAP_BASE_DN          (optional) — defaults to dc= decomposition of KERNEL_DOMAIN
#   LETSENCRYPT_EMAIL     (optional) — defaults to admin@${KERNEL_DOMAIN}
#   OPENBAO_SERVER        (optional) — defaults to in-cluster address
#   INGRESS_CLASS_NAME    (optional) — defaults to nginx
#   KV_MOUNT              (optional) — defaults to secret
#
# For e2e tests (make e2e-p1), use crossplane/claims/dev-cluster.yaml directly.
apiVersion: gentianos.io/v1alpha1
kind: Cluster
metadata:
  name: dev-cluster
  namespace: crossplane-system
spec:
  kernelDomain: ${KERNEL_DOMAIN}
  ldapBaseDn: "${LDAP_BASE_DN}"
  masterPasswordSecretRef:
    name: gentian-os-master-password
    namespace: crossplane-system
  openbao:
    server: ${OPENBAO_SERVER}
    kvMount: ${KV_MOUNT}
    authMount: kubernetes
    kubernetesHost: https://kubernetes.default.svc
  argocd:
    namespace: argocd
    sourceRepos: []
  eso:
    namespace: external-secrets
    serviceAccount: external-secrets
  certManager:
    letsencryptEmail: ${LETSENCRYPT_EMAIL}
    ingressClassName: ${INGRESS_CLASS_NAME}
  compositeDeletePolicy: Background
