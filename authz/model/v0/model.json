          "union": {
            "child": [
              { "this": {} },
              { "computedUserset": { "relation": "member" } }
            ]
          }
        }
      }
    },
    {
      "type": "shell_app",
      "relations": {
        "parent": { "this": {} },
        "can_launch": {
          "union": {
            "child": [
              { "this": {} },
              {
                "tupleToUserset": {
                  "tupleset": { "relation": "parent" },
