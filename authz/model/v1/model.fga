model
  schema 1.1

# Authorization model, v1. The single vocabulary every document is checked
# against — see docs/concepts/authorization.md for the rules behind it.
#
# Conventions
#   type            one per kind of thing rights are held on; object id = its
#                   name, things of a tenant as <tenant>/<name>
#   ids             OpenFGA ids may contain neither ':' nor '#'.
#   role            a noun: a privilege on ONE thing. Every tenant and app
#                   has two, user (the lowest) and admin (the highest); admin
#                   holds every other role on the same thing. An app's profile
#                   may declare more (type role), each between the two. A role
#                   does not travel: a tenant's admin is not an app's.
#   position        a named set of roles a kind of person holds ("Sales
#                   intern"). It belongs to a tenant, is given to a person by
#                   plain assignment (position#holder) and may include other
#                   positions. A role may also be given to a person directly.
#   named duties    the roles the Cluster claim gives a person by name
#                   (spec.platformAccess.roleHolders): security_officer,
#                   auditor, service_admin, shared_apps_admin,
#                   perimeter_approver and a tenant's auditor take
#                   user:<realm>/<sub>, the account qualified by the realm
#                   that holds it, which a token from any other realm can
#                   never name
#   permission      can_<verb>, one per verb an enforcement point exposes;
#                   PEPs check permissions, never roles
#   hierarchy       one parent relation per type (cluster, tenant), derived
#                   with "<relation> from <parent>"
#   additive        grants only add: no relation excludes another
#   stored          everything is stored, nothing is taken from a token. The
#                   operator writes structure and what a tenant declares; who
#                   holds a position or a role is written when it is given.
#   contextual      runtime facts only — task TTL, acting_for, device posture.
#                   Never identity, never who holds what.

type user

# A named set of roles. position:<tenant>/<name>.
type position
  relations
    define tenant: [tenant]
    # sales-manager included_in executive: whoever holds executive holds
    # sales-manager. The writer refuses a circle. Not followed by a check:
    # the operator writes what the including position holds through it as
    # derived_* entries on each thing (see "derived" below).
    define included_in: [position]
    define holder: [user]

type cluster
  relations
    # roles — from the Cluster claim's role holders
    # (spec.platformAccess.roleHolders), each user:<realm>/<sub>
    define admin: [user]                      # a person of the platform tenant
    define security_officer: [user]
    define auditor: [user]
    define service_admin: [user]              # a person of the platform tenant
    define shared_apps_admin: [user]          # a person of the platform tenant
    define perimeter_approver: [user]         # a person of the platform tenant; approves for every tenant
    define break_glass: [user]                # a person, with a reason, until a time

    # permissions — the director's cluster-level verbs
    define can_configure: admin               # Cluster claim, plans, ceilings, network intent
    define can_deploy_tenant: admin
    define can_operate_system: service_admin  # the claim's system section
    define can_install_shared: shared_apps_admin
    define can_grant_shared: shared_apps_admin
    define can_approve: security_officer      # waivers, egress beyond baseline, exposure policy, trustTier platform
    define can_set_admission: break_glass     # PolicyException, admission overlays (kernel tier)
    define can_edit_raw: break_glass          # /v1/files
    define can_audit: auditor or security_officer or admin
    define can_open_kernel_tools: can_configure or can_operate_system   # Headlamp: the cluster as Kubernetes sees it
    define can_approve_perimeter: perimeter_approver   # public addresses and egress, on every tenant

    # Kernel and system credentials, asked by the custodian before OpenBao
    # sees the request. Writing one is administering the cluster. Reading is
    # never reading the VALUE -- the custodian returns none -- it is seeing
    # that a credential is required, whether it is set, and who set it, which
    # is what an auditor is for.
    define can_write_credential: admin
    define can_read_credential: can_write_credential or can_audit

type tenant
  relations
    define cluster: [cluster]

    # roles. A platform administrator acts inside a tenant through the
    # derivation, never by holding the tenant's role: authority comes down the
    # chain (R4, principle 5), so there is no tuple to forget to remove.
    #
    # operated_by is CONSENT, not structure: this tenant lets the cluster's
    # administrators act inside it. The operator writes it when it first
    # attaches a tenant to the cluster, and always for tenant:platform; a tenant that administers itself removes
    # that one tuple, and every platform-admin verb in it — users, secrets,
    # installs — goes with it. `cluster` above stays: it is what audit and
    # approval derive through, and it is not removable.
    define operated_by: [cluster]
    define admin: [user, position#holder] or admin from operated_by or derived_admin
    define user: [user, position#holder] or admin or derived_user
    # derived — written by the operator only, never given: what follows from
    # what was given (a position's included positions). Checks read it in
    # one step instead of walking the inclusions.
    define derived_admin: [user, position#holder]
    define derived_user: [user, position#holder]
    # A role holder of scope tenant:<t> (an administrator of this tenant), or
    # the cluster's perimeter approver.
    define perimeter_approver: [user] or perimeter_approver from cluster
    # A person of the platform tenant the cluster's administrator named to
    # read this tenant's evidence and nothing else's: commonly the tenant's
    # own administrator, given an account of the platform's realm for it. It
    # grants no entry to the tenant (can_enter).
    define auditor: [user]

    # reach — the desktop host at L2. In tenant-platform the console's own
    # users are the security officer and the auditor, who hold no role on any
    # tenant.
    define can_enter: user or perimeter_approver or can_audit from cluster or can_approve from cluster

    # permissions — the director's tenant-level verbs
    define can_install_app: admin
    define can_set_policy: admin          # backup, grants, export schedules, tenant network intent
    define can_grant: admin               # AppGrant: integration consent
    # People, and who holds which position and role in the tenant. An admin
    # may give any of them, to themselves too: it is an assignment like any
    # other, and it is what keeps an app from having nobody to configure it.
    define can_manage_users: admin
    # The perimeter, both directions, is its own grant, asked as its own
    # relation and never as admin: publishing to the internet (can_expose)
    # and egress beyond the baseline (can_approve_privilege, the tenant-scope
    # privilege requests of component-profile 3.1). Held by
    #
    #   - the tenant's perimeter approver: an administrator of this tenant the
    #     cluster's administrator named, or the cluster's perimeter approver;
    #   - the cluster's administrators, on every tenant. It derives through
    #     `cluster`, not `operated_by`: the perimeter is the cluster's, so a
    #     tenant that administers itself still has its perimeter answered for
    #     by the cluster. It grants nothing else in the tenant.
    define can_expose: perimeter_approver or admin from cluster
    define can_approve_privilege: can_expose
    define can_view: user or perimeter_approver or can_audit from cluster
    # The tenant's audit records in the evidence store, read from the platform
    # tenant's console: the tenant's auditor, and the cluster's, whose
    # can_audit reads every tenant's.
    define can_read_evidence: auditor or can_audit from cluster

    # Admin tiles on the desktop.
    define can_administer: admin

    # The tenant's own credentials, asked by the custodian. A platform
    # administrator writes them only through `admin from operated_by`, so a
    # tenant that withdraws that consent withdraws this with it; the cluster's
    # auditors still see that they exist and who set them, never what they are.
    define can_write_credential: admin
    define can_read_credential: can_write_credential or can_audit from cluster

# There is no type for a catalogue source and no relation for a tenant's
# right to an app. A source named on the Cluster claim is offered to every
# tenant. Installing is asked of the person (tenant#can_install_app); whether
# the app then arrives is decided where its artefacts are pulled, by the
# credential the tenant holds for their repository. The platform does no
# license gating.
# An installed app, app:<tenant>/<profile>. An add-on is an app of its own.
# base, addon and declared are structure: the operator derives from them
# (derived_*), a check does not follow them.
type app
  relations
    define tenant: [tenant]
    # On an add-on: the app it extends. On a base: its installed add-ons.
    define base: [app]
    define addon: [app]
    # The further roles the app's profile declares.
    define declared: [role]

    # Administration inside the app. Per app: the admin of one is nothing in
    # another, and the tenant's admin is not an app's. The admin of a base
    # administers its add-ons.
    define admin: [user, position#holder] or derived_admin
    # Whoever holds any role on the app may use it, and whoever holds a role
    # on an add-on may enter its base: an add-on is used inside it.
    define user: [user, position#holder] or admin or derived_user
    # derived — written by the operator only, never given: the admin of an
    # add-on's base (derived_admin); whoever holds one of the app's declared
    # roles or any role on one of its add-ons (derived_user); and what a
    # position holds through the positions it includes. A check reads these
    # in one step instead of walking bases, add-ons, roles and inclusions.
    define derived_admin: [user, position#holder]
    define derived_user: [user, position#holder]

    define can_use: user
    define can_launch: can_use                    # app tiles; also L2 on the app's own route
                                                  # admin tiles are tenant#can_administer
    define can_administer: admin

    # Secret writes for this component, asked by the custodian before OpenBao
    # sees the request: OpenBao's policy then bounds the PATH, it does not
    # make the decision (principle 2). Reads follow the tenant's, and are of
    # a credential's state, never its value.
    define can_write_credential: admin from tenant
    define can_read_credential: can_read_credential from tenant

# A role an app's profile declares beside user and admin,
# role:<tenant>/<profile>/<name>. It sits between the two: holding it is
# holding user (app#user), and the app's admin holds it. A profile may say
# that one of its roles includes another.
type role
  relations
    define app: [app]
    define included_in: [role]
    define holder: [user, position#holder] or admin from app or derived_holder
    # derived — written by the operator only: the holders of a role that
    # includes this one, and what a position holds through its inclusions.
    define derived_holder: [user, position#holder]

type contract
  relations
    define tenant: [tenant]
    # The app that declared this contract in `provides`.
    define provider: [app]
    # Apps the tenant has allowed to consume it, from AppGrant.
    define consumer: [app]
    define can_consume: consumer

    # No enforcement point asks this yet. Until workloads carry identity
    # (G8) there is nothing sitting on an app-to-app call, so the tuple
    # records the tenant's consent and bounds what the director will bind —
    # it does not intercept traffic. What revoking therefore costs today is
    # in design/authorization.md §3 and design/security.md §3.4; the one thing
    # it is not is free.

type shared_instance
  relations
    define cluster: [cluster]
    # Tenants the platform administrator has made this instance available to.
    # Availability is not visibility: a tenant sees the app only once its own
    # administrator installs it, which creates the tenant's own app object
    # bound to this backend (component-profile.md §6.1).
    define offered_to: [tenant]
    define can_bind: offered_to

# Wave 2 adds, without changing anything above:
#
#   type task
#     relations
#       define valid: [agent with task_live]
#   type agent
#     relations
#       define acting_for: [user]
#       define can_act: acting_for and valid from task
#
# and every app permission gains "or can_act from agent" bounded by the
# delegating human's own permission (principle 5).
