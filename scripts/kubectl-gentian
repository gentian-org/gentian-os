#!/usr/bin/env bash
# kubectl-gentian — kubectl plugin for Gentian OS management.
#
# Provides subcommands for the Gentian App Store and tenant lifecycle. GitOps
# operations edit the Tenant CR YAML in the gentian-deployments repository and
# commit+push the change. ArgoCD then reconciles the new state — the Git commit
# is the single source of truth and the audit trail.
#
# Usage:
#   kubectl gentian apps list [--namespace <ns>]
#   kubectl gentian apps install <app> --tenant <tenant>
#   kubectl gentian apps uninstall <app> --tenant <tenant>
#   kubectl gentian tenants list [--env <env>]
#   kubectl gentian tenants deploy <instance> [--env <env>]
#   kubectl gentian tenants undeploy <instance> [--env <env>] [--purge|-f]
#
# Required environment variables (or ~/.gentian/config):
#   GENTIAN_DEPLOYMENTS_PATH   local path to a gentian-deployments checkout
#   GENTIAN_DEPLOYMENTS_REPO   remote URL (used for initial clone if path absent)
#
# The plugin respects KUBECONFIG / kubectl context for the `list` subcommand.

set -euo pipefail

# Print a clear error when any command fails (set -e exits silently otherwise).
_gentian_err_trap() {
  local exit_code=$?
  local line=$1
  echo "error: kubectl gentian failed (line ${line}, exit code ${exit_code})" >&2
  echo "  Run with 'bash -x kubectl gentian ...' for full trace." >&2
  exit "${exit_code}"
}
trap '_gentian_err_trap $LINENO' ERR

# ---------------------------------------------------------------------------
# Config resolution
# ---------------------------------------------------------------------------
CONFIG_FILE="${HOME}/.gentian/config"
if [[ -f "${CONFIG_FILE}" ]]; then
  # shellcheck disable=SC1090
  source "${CONFIG_FILE}"
fi

DEPLOYMENTS_PATH="${GENTIAN_DEPLOYMENTS_PATH:-}"
DEPLOYMENTS_REPO="${GENTIAN_DEPLOYMENTS_REPO:-}"
DEPLOYMENTS_CLUSTER="${GENTIAN_DEPLOYMENTS_CLUSTER:-default-cluster}"
DEPLOYMENTS_STAGE="${GENTIAN_DEPLOYMENTS_STAGE:-dev}"

usage() {
  cat <<EOF
kubectl-gentian — Gentian OS management plugin

Usage:
  kubectl gentian apps list
      List all available apps from the AppCatalogue.

  kubectl gentian apps install <app> --tenant <tenant>
      Install an app for a tenant by committing to gentian-deployments.

  kubectl gentian apps uninstall <app> --tenant <tenant>
      Uninstall an app from a tenant by committing to gentian-deployments.

    kubectl gentian tenants list [--env <stage>]
      List tenant definitions for clusters/<cluster> (definitions/ and tenants/).
      ACTIVE=yes when deployed under tenants/<name>/<stage>/ (GitOps sync path).
      ACTIVE=no when defined only under definitions/<name>/<stage>/.
      LIVE=yes when the Tenant CR exists on the cluster.

    kubectl gentian tenants deploy <instance> [--env <stage>]
      Deploy a tenant by applying clusters/<cluster>/tenants/<instance>/<stage>/.
      If not yet deployed, copies the definition from definitions/<instance>/<stage>/.

    kubectl gentian tenants undeploy <instance> [--env <stage>] [--purge|-f]
      Undeploy a tenant instance by removing it from <env>/tenants/kustomization.yaml.
      With --purge / -f, set deletionPolicy=Delete before undeploying, which
      permanently deletes all tenant data including LDAP users, databases,
      mail secrets, UMC releases, and other orchestrator-owned artifacts.

Environment / ~/.gentian/config:
  GENTIAN_DEPLOYMENTS_PATH   local path to gentian-deployments checkout
  GENTIAN_DEPLOYMENTS_REPO   remote Git URL (used if path does not exist)
  GENTIAN_DEPLOYMENTS_CLUSTER  cluster selector (default: default-cluster)
  GENTIAN_DEPLOYMENTS_STAGE    stage selector (default: dev)

Examples:
  kubectl gentian apps list
  kubectl gentian apps install openproject --tenant gtn-demo
  kubectl gentian apps uninstall openproject --tenant gtn-demo
  kubectl gentian tenants list
  kubectl gentian tenants deploy demo
  kubectl gentian tenants undeploy demo
  kubectl gentian tenants undeploy demo --purge   # or -f
EOF
}

# ---------------------------------------------------------------------------
# Helper: ensure we have a local deployment repo checkout
# ---------------------------------------------------------------------------
ensure_repo() {
  if [[ -z "${DEPLOYMENTS_PATH}" ]]; then
    echo "ERROR: GENTIAN_DEPLOYMENTS_PATH is not set." >&2
    echo "Set it in the environment or in ${CONFIG_FILE}." >&2
    exit 1
  fi

  if [[ ! -d "${DEPLOYMENTS_PATH}/.git" ]]; then
    if [[ -z "${DEPLOYMENTS_REPO}" ]]; then
      echo "ERROR: ${DEPLOYMENTS_PATH} is not a git repository and GENTIAN_DEPLOYMENTS_REPO is not set." >&2
      exit 1
    fi
    echo "Cloning ${DEPLOYMENTS_REPO} → ${DEPLOYMENTS_PATH} ..."
    git clone "${DEPLOYMENTS_REPO}" "${DEPLOYMENTS_PATH}"
  fi

  # Always pull latest to keep local clone in sync with remote.
  (cd "${DEPLOYMENTS_PATH}" && git pull --rebase --autostash)
}

# ---------------------------------------------------------------------------
# Helper: find the tenant YAML file
# ---------------------------------------------------------------------------
tenant_file() {
  local tenant="${1}"
  # First try matching by filename: tenants/gtn-demo.yaml or dev/tenants/gtn-demo.yaml
  local candidates
  candidates=$(find "${DEPLOYMENTS_PATH}/clusters" -name "${tenant}.yaml" -path "*/tenants/*/*" 2>/dev/null || true)

  # Fall back to searching by metadata.name inside all tenant YAML files
  if [[ -z "${candidates}" ]]; then
    candidates=$(grep -rl "name: ${tenant}" "${DEPLOYMENTS_PATH}" --include="*.yaml" 2>/dev/null \
      | while read -r f; do
          [[ "${f}" == */tenants/* ]] && grep -q "kind: Tenant" "${f}" && echo "${f}"
        done || true)
  fi

  if [[ -z "${candidates}" ]]; then
    echo "ERROR: Tenant file for '${tenant}' not found under ${DEPLOYMENTS_PATH}." >&2
    echo "Searched by filename (*/tenants/${tenant}.yaml) and by metadata.name." >&2
    exit 1
  fi
  # If multiple candidates exist (e.g. dev/ and staging/), take the first one.
  echo "${candidates}" | head -n1
}

git_commit_push() {
  local message="${1}"

  (
    cd "${DEPLOYMENTS_PATH}"
    if git diff --cached --quiet; then
      echo "No Git changes detected."
      exit 0
    fi
    git commit -m "${message}"
    git pull --rebase
    git push
  )
}

set_tenant_deletion_policy() {
  local file="${1}"
  local policy="${2}"

  if grep -q '^  deletionPolicy:' "${file}"; then
    sed -i "s/^  deletionPolicy:.*/  deletionPolicy: ${policy}/" "${file}"
  elif grep -q '^  apps:' "${file}"; then
    sed -i "/^  apps:/i\\  deletionPolicy: ${policy}" "${file}"
  else
    printf '\n  deletionPolicy: %s\n' "${policy}" >> "${file}"
  fi
}

KERNEL_NAMESPACE="${KERNEL_NAMESPACE:-platform-kernel}"

wait_for_tenant_deletion_policy() {
  local tenant_name="${1}"
  local desired_policy="${2}"
  local timeout="${3:-120}"
  local allow_missing="${4:-false}"
  local elapsed=0

  while (( elapsed < timeout )); do
    if ! kubectl get tenant "${tenant_name}" &>/dev/null; then
      if [[ "${allow_missing}" == "true" ]]; then
        return 0
      fi
      echo "ERROR: tenant '${tenant_name}' disappeared before deletionPolicy=${desired_policy} was confirmed." >&2
      return 1
    fi
    local live_policy
    live_policy="$(kubectl get tenant "${tenant_name}" \
      -o jsonpath='{.spec.deletionPolicy}' 2>/dev/null || echo "Retain")"
    if [[ "${live_policy}" == "${desired_policy}" ]]; then
      return 0
    fi
    sleep 2
    elapsed=$((elapsed + 2))
  done

  echo "ERROR: timed out waiting for tenant '${tenant_name}' deletionPolicy=${desired_policy}." >&2
  return 1
}

ensure_tenant_deletion_policy_live() {
  local tenant_name="${1}"
  local policy="${2}"

  if ! kubectl get tenant "${tenant_name}" &>/dev/null; then
    return 0
  fi

  local live_policy
  live_policy="$(kubectl get tenant "${tenant_name}" \
    -o jsonpath='{.spec.deletionPolicy}' 2>/dev/null || echo "Retain")"
  if [[ "${live_policy}" != "${policy}" ]]; then
    kubectl patch tenant "${tenant_name}" --type=merge \
      -p "{\"spec\":{\"deletionPolicy\":\"${policy}\"}}" >/dev/null
  fi
  wait_for_tenant_deletion_policy "${tenant_name}" "${policy}" 120 false
}

# Wait until deletionPolicy is stable on the live CR, re-patching if ArgoCD selfHeal
# reverts it. Used before purge deletes the Tenant CR so the controller runs Delete
# cleanup (LDAP OU delete, etc.) instead of Retain (lock/disable only).
assert_live_tenant_deletion_policy() {
  local tenant_name="${1}"
  local policy="${2}"
  local timeout="${3:-180}"
  local elapsed=0
  local stable_checks=0

  echo "Waiting for live tenant '${tenant_name}' deletionPolicy=${policy}..."
  while (( elapsed < timeout )); do
    if ! kubectl get tenant "${tenant_name}" &>/dev/null; then
      echo "ERROR: tenant '${tenant_name}' disappeared before deletionPolicy=${policy} was confirmed." >&2
      return 1
    fi

    ensure_tenant_deletion_policy_live "${tenant_name}" "${policy}" || true

    local live_policy
    live_policy="$(kubectl get tenant "${tenant_name}" \
      -o jsonpath='{.spec.deletionPolicy}' 2>/dev/null || echo "Retain")"
    if [[ "${live_policy}" == "${policy}" ]]; then
      stable_checks=$((stable_checks + 1))
      if (( stable_checks >= 3 )); then
        return 0
      fi
    else
      stable_checks=0
      if (( elapsed > 0 && elapsed % 10 == 0 )); then
        echo "  live deletionPolicy is '${live_policy}'; waiting for stable '${policy}' (${elapsed}s elapsed)..."
      fi
    fi

    sleep 2
    elapsed=$((elapsed + 2))
  done

  echo "ERROR: timed out waiting for stable deletionPolicy=${policy} on tenant '${tenant_name}'." >&2
  return 1
}

# Print a status line before kubectl wait (which is silent until it finishes).
wait_with_message() {
  local message="${1}"
  shift
  echo "${message}"
  kubectl wait "$@"
}

tenant_ldap_ou_from_resource() {
  local resource_file="${1}"
  local tenant_name="${2}"
  local ou=""

  if [[ -f "${resource_file}" ]]; then
    ou="$(grep -E '^[[:space:]]*ldapOU:' "${resource_file}" 2>/dev/null \
      | head -n1 | sed -E 's/^[[:space:]]*ldapOU:[[:space:]]*//' || true)"
  fi
  if [[ -z "${ou}" ]]; then
    ou="ou=${tenant_name}"
  fi
  echo "${ou}"
}

run_ldap_ou_delete_fallback() {
  local tenant_name="${1}"
  local resource_file="${2}"
  local force="${3:-false}"
  local ou_spec
  local job_name="ldap-ou-delete-${tenant_name}"

  ou_spec="$(tenant_ldap_ou_from_resource "${resource_file}" "${tenant_name}")"
  ou_spec="${ou_spec//\"/\\\"}"
  echo "Running LDAP OU delete for tenant '${tenant_name}' (${ou_spec})..."

  if [[ "${force}" == "true" ]]; then
    kubectl delete job "${job_name}" -n "${KERNEL_NAMESPACE}" --ignore-not-found=true >/dev/null 2>&1
  elif kubectl get job "${job_name}" -n "${KERNEL_NAMESPACE}" &>/dev/null; then
    wait_with_message \
      "Waiting for existing LDAP OU delete job '${job_name}' to complete (timeout: 300s)..." \
      job "${job_name}" -n "${KERNEL_NAMESPACE}" \
      --for=condition=complete --timeout=300s
    return $?
  fi

  kubectl apply -f - <<EOF
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
  namespace: ${KERNEL_NAMESPACE}
  labels:
    gentianos.io/tenant: ${tenant_name}
    app.kubernetes.io/managed-by: gentian-os
spec:
  ttlSecondsAfterFinished: 3600
  template:
    spec:
      restartPolicy: OnFailure
      containers:
      - name: delete-ou
        image: curlimages/curl:8.7.1
        command: ["/bin/sh", "-c"]
        args:
        - |
          set -eu
          urlencode() { printf '%s' "\$1" | sed 's/%/%25/g; s/ /%20/g; s/,/%2C/g; s/=/=%3D/g'; }
          CREDS="-u Administrator:\${UDM_ADMIN_PASSWORD}"
          BASE_URL="\${UDM_URL}/udm"
          OU_SPEC="${ou_spec}"
          case "\${OU_SPEC}" in
            *,*) OU_POS="\${OU_SPEC}" ;;
            *) OU_POS="\${OU_SPEC},\${UDM_LDAP_BASE}" ;;
          esac
          OU_ENC=\$(urlencode "\${OU_POS}")
          HTTP=\$(curl -s -o /dev/null -w "%{http_code}" -X DELETE \${CREDS} \\
            -H "Accept: application/json" \\
            "\${BASE_URL}/container/ou/\${OU_ENC}?cleanup=1&recursive=1")
          echo "OU \${OU_POS} deletion requested (HTTP \${HTTP})"
          case "\${HTTP}" in
            200|204|404) ;;
            *) echo "ERROR: OU delete failed (HTTP \${HTTP})" >&2; exit 1 ;;
          esac
        env:
        - name: UDM_URL
          valueFrom:
            secretKeyRef:
              name: udm-admin
              key: url
        - name: UDM_ADMIN_PASSWORD
          valueFrom:
            secretKeyRef:
              name: udm-admin
              key: password
        - name: UDM_LDAP_BASE
          valueFrom:
            secretKeyRef:
              name: udm-admin
              key: ldapBase
EOF

  wait_with_message \
    "Waiting for LDAP OU delete job '${job_name}' to complete (timeout: 300s)..." \
    job "${job_name}" -n "${KERNEL_NAMESPACE}" \
    --for=condition=complete --timeout=300s
}

verify_ldap_ou_absent() {
  local tenant_name="${1}"
  local resource_file="${2}"
  local ou_spec
  local job_name="ldap-ou-verify-gone-${tenant_name}"

  ou_spec="$(tenant_ldap_ou_from_resource "${resource_file}" "${tenant_name}")"
  ou_spec="${ou_spec//\"/\\\"}"

  kubectl delete job "${job_name}" -n "${KERNEL_NAMESPACE}" --ignore-not-found=true >/dev/null 2>&1

  kubectl apply -f - <<EOF
apiVersion: batch/v1
kind: Job
metadata:
  name: ${job_name}
  namespace: ${KERNEL_NAMESPACE}
  labels:
    gentianos.io/tenant: ${tenant_name}
    app.kubernetes.io/managed-by: gentian-os
spec:
  ttlSecondsAfterFinished: 3600
  template:
    spec:
      restartPolicy: Never
      containers:
      - name: verify-ou-gone
        image: curlimages/curl:8.7.1
        command: ["/bin/sh", "-c"]
        args:
        - |
          set -eu
          urlencode() { printf '%s' "\$1" | sed 's/%/%25/g; s/ /%20/g; s/,/%2C/g; s/=/=%3D/g'; }
          CREDS="-u Administrator:\${UDM_ADMIN_PASSWORD}"
          BASE_URL="\${UDM_URL}/udm"
          OU_SPEC="${ou_spec}"
          case "\${OU_SPEC}" in
            *,*) OU_POS="\${OU_SPEC}" ;;
            *) OU_POS="\${OU_SPEC},\${UDM_LDAP_BASE}" ;;
          esac
          OU_ENC=\$(urlencode "\${OU_POS}")
          HTTP=\$(curl -s -o /dev/null -w "%{http_code}" \${CREDS} \\
            -H "Accept: application/json" \\
            "\${BASE_URL}/container/ou/\${OU_ENC}")
          echo "OU \${OU_POS} lookup (HTTP \${HTTP})"
          case "\${HTTP}" in
            404) echo "OU absent (HTTP 404)" ;;
            *) echo "ERROR: tenant LDAP OU still present (HTTP \${HTTP})" >&2; exit 1 ;;
          esac
        env:
        - name: UDM_URL
          valueFrom:
            secretKeyRef:
              name: udm-admin
              key: url
        - name: UDM_ADMIN_PASSWORD
          valueFrom:
            secretKeyRef:
              name: udm-admin
              key: password
        - name: UDM_LDAP_BASE
          valueFrom:
            secretKeyRef:
              name: udm-admin
              key: ldapBase
EOF

  wait_with_message \
    "Waiting for LDAP OU verification job '${job_name}' to complete (timeout: 120s)..." \
    job "${job_name}" -n "${KERNEL_NAMESPACE}" \
    --for=condition=complete --timeout=120s
}

wait_for_purge_controller_cleanup() {
  local tenant_name="${1}"
  local resource_file="${2}"
  local ou_job="ldap-ou-delete-${tenant_name}"
  local lock_job="ldap-lock-${tenant_name}"

  if kubectl get job "${ou_job}" -n "${KERNEL_NAMESPACE}" &>/dev/null; then
    if ! wait_with_message \
      "Waiting for controller LDAP OU delete job '${ou_job}' to complete (timeout: 300s)..." \
      job "${ou_job}" -n "${KERNEL_NAMESPACE}" \
      --for=condition=complete --timeout=300s; then
      echo "WARNING: controller OU delete job did not complete successfully." >&2
    fi
  elif kubectl get job "${lock_job}" -n "${KERNEL_NAMESPACE}" &>/dev/null; then
    echo "WARNING: Retain LDAP cleanup ran (job '${lock_job}'); tenant CR likely had deletionPolicy=Retain during delete." >&2
  fi

  # Always re-run OU delete on purge: idempotent (404 = already gone) and covers
  # cases where GitOps overwrote deletionPolicy=Delete before the controller ran.
  if ! run_ldap_ou_delete_fallback "${tenant_name}" "${resource_file}" true; then
    return 1
  fi

  echo "Verifying tenant LDAP OU is gone..."
  if ! verify_ldap_ou_absent "${tenant_name}" "${resource_file}"; then
    return 1
  fi

  return 0
}

delete_labeled_resources() {
  local resource="${1}"
  local namespace="${2:-}"
  local label_selector="${3}"
  local kubectl_args=()

  if [[ -n "${namespace}" ]]; then
    kubectl_args=(-n "${namespace}")
  fi

  local names
  names="$(kubectl get "${resource}" "${kubectl_args[@]}" \
    -l "${label_selector}" -o name 2>/dev/null || true)"
  if [[ -z "${names}" ]]; then
    return 0
  fi

  while IFS= read -r name; do
    [[ -z "${name}" ]] && continue
    kubectl delete "${name}" "${kubectl_args[@]}" --ignore-not-found=true --wait=false
  done <<< "${names}"
}

purge_tenant_cluster_artifacts() {
  local tenant_name="${1}"
  local ns_name="${2:-tenant-${tenant_name}}"
  local label_selector="gentianos.io/tenant=${tenant_name},app.kubernetes.io/managed-by=gentian-os"

  echo "Purging remaining cluster artifacts for tenant '${tenant_name}'..."

  delete_labeled_resources "databases.postgresql.cnpg.io" "${KERNEL_NAMESPACE}" "${label_selector}"

  delete_labeled_resources "release.helm.crossplane.io" "" "${label_selector}"

  kubectl delete secrets -n "${KERNEL_NAMESPACE}" \
    -l "${label_selector}" --ignore-not-found=true

  if kubectl get namespace "${ns_name}" &>/dev/null; then
    echo "Deleting tenant namespace '${ns_name}'..."
    kubectl delete namespace "${ns_name}" --ignore-not-found=true --wait=false
    kubectl wait namespace "${ns_name}" --for=delete --timeout=180s 2>/dev/null || \
      echo "WARNING: namespace '${ns_name}' is still terminating after purge." >&2
  fi

  # Purge jobs last so controller cleanup jobs can finish before we remove them.
  delete_labeled_resources "jobs" "${KERNEL_NAMESPACE}" "${label_selector}"
}

# Resolve the ArgoCD Application for clusters/<cluster>/tenants/<instance>/<stage>.
# Prints "namespace/name".
argocd_tenants_app_for_instance() {
  local instance="${1}"
  local env_name="${2:-${DEPLOYMENTS_STAGE}}"
  local want_path="clusters/${DEPLOYMENTS_CLUSTER}/tenants/${instance}/${env_name}"

  kubectl get application.argoproj.io -A \
    -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\t"}{.spec.source.path}{"\n"}{end}' \
    2>/dev/null \
    | awk -F'\t' -v p="${want_path}" '$2 == p {print $1; exit}'
}

# Hard-refresh and sync-with-prune the tenant Application so Git revisions apply
# before selfHeal can recreate a manually deleted Tenant CR.
argocd_trigger_sync_prune() {
  local instance="${1}"
  local env_name="${2:-${DEPLOYMENTS_STAGE}}"
  local app_ns_name
  app_ns_name="$(argocd_tenants_app_for_instance "${instance}" "${env_name}")"

  if [[ -z "${app_ns_name}" ]]; then
    echo "No ArgoCD app found for 'clusters/${DEPLOYMENTS_CLUSTER}/tenants/${instance}/${env_name}'; skipping ArgoCD sync." >&2
    return 0
  fi

  local argocd_ns="${app_ns_name%%/*}"
  local argocd_app="${app_ns_name##*/}"

  echo "Refreshing ArgoCD app '${argocd_app}' (clusters/${DEPLOYMENTS_CLUSTER}/tenants/${instance}/${env_name})..."
  kubectl annotate "application.argoproj.io/${argocd_app}" -n "${argocd_ns}" \
    "argocd.argoproj.io/refresh=hard" --overwrite &>/dev/null || true

  if command -v argocd >/dev/null 2>&1; then
    echo "  triggering ArgoCD sync with prune..."
    argocd app sync "${argocd_app}" --prune --timeout 120 >/dev/null 2>&1 || true
  else
    echo "  triggering ArgoCD sync with prune via kubectl patch..."
    kubectl patch "application.argoproj.io/${argocd_app}" -n "${argocd_ns}" --type merge \
      -p '{"operation":{"initiatedBy":{"username":"kubectl-gentian"},"sync":{"prune":true}}}' \
      >/dev/null 2>&1 || true
  fi

  local i=0
  while [[ ${i} -lt 90 ]]; do
    local sync_status
    sync_status="$(kubectl get "application.argoproj.io/${argocd_app}" -n "${argocd_ns}" \
      -o jsonpath='{.status.sync.status}' 2>/dev/null || echo "")"
    if [[ "${sync_status}" == "Synced" ]]; then
      echo "ArgoCD app '${argocd_app}' is Synced."
      return 0
    fi
    sleep 2
    i=$((i + 2))
  done

  echo "WARNING: ArgoCD app '${argocd_app}' did not reach Synced within 90s." >&2
  return 0
}

wait_for_tenant_delete() {
  local tenant_name="${1}"
  local ns_name="${2}"
  local purge="${3:-false}"
  local resource_file="${4:-}"
  local instance="${5:-${tenant_name}}"
  local env_name="${6:-${DEPLOYMENTS_STAGE}}"
  local timeout=300
  local elapsed=0
  local last_argocd_sync=-1000

  echo "Waiting for tenant '${tenant_name}' finalizers and controller cleanup (timeout: ${timeout}s)..."
  echo "  (operator is removing tenant resources; this can take a few minutes)"

  while (( elapsed < timeout )); do
    if ! kubectl get tenant "${tenant_name}" &>/dev/null 2>&1; then
      break
    fi

    local deletion_ts
    deletion_ts="$(kubectl get tenant "${tenant_name}" \
      -o jsonpath='{.metadata.deletionTimestamp}' 2>/dev/null || true)"

    if [[ -z "${deletion_ts}" ]]; then
      echo "WARNING: tenant '${tenant_name}' exists without deletionTimestamp (likely ArgoCD selfHeal); recovering..." >&2
      if [[ -n "${env_name}" ]] && (( elapsed - last_argocd_sync >= 10 )); then
        argocd_trigger_sync_prune "${instance:-${tenant_name}}" "${env_name}" || true
        last_argocd_sync=$elapsed
      fi
      if [[ "${purge}" == "true" ]]; then
        ensure_tenant_deletion_policy_live "${tenant_name}" "Delete" || true
      fi
      kubectl delete tenant "${tenant_name}" --ignore-not-found=true
      sleep 3
      elapsed=$((elapsed + 3))
      continue
    fi

    local remaining=$((timeout - elapsed))
    local chunk=30
    if (( remaining < chunk )); then
      chunk=$remaining
    fi
    if kubectl wait tenant "${tenant_name}" --for=delete --timeout="${chunk}s" 2>/dev/null; then
      break
    fi
    elapsed=$((elapsed + chunk))
  done

  if kubectl get tenant "${tenant_name}" &>/dev/null 2>&1; then
    echo "ERROR: timed out waiting for tenant '${tenant_name}' cleanup to complete." >&2
    echo "  Check operator logs: kubectl logs -n gentian-system deployment/gentian-os --tail=50" >&2
    return 1
  fi

  if [[ "${purge}" == "true" ]]; then
    if ! wait_for_purge_controller_cleanup "${tenant_name}" "${resource_file}"; then
      echo "ERROR: purge LDAP cleanup did not complete for tenant '${tenant_name}'." >&2
      return 1
    fi
  fi

  if kubectl get namespace "${ns_name}" &>/dev/null; then
    echo "Waiting for namespace '${ns_name}' to finish terminating..."
    if ! kubectl wait namespace "${ns_name}" --for=delete --timeout=180s 2>/dev/null; then
      echo "ERROR: namespace '${ns_name}' is still terminating after 180s." >&2
      echo "  This may indicate stuck finalizers. Inspect with:" >&2
      echo "    kubectl get namespace ${ns_name} -o yaml" >&2
      return 1
    fi
  fi

  return 0
}

tenant_undeploy_remove_from_git() {
  local instance="${1}"
  local env_name="${2}"
  local _kustom_file="${3:-}"
  local await_prune="${4:-true}"
  local tenant_name="${5:-}"

  local stage_dir
  stage_dir="$(tenant_stage_dir "${instance}" "${env_name}")"

  rm -rf "${stage_dir}"
  (
    cd "${DEPLOYMENTS_PATH}"
    git add -A "clusters/${DEPLOYMENTS_CLUSTER}/tenants/${instance}"
  )
  git_commit_push "feat(${instance}): undeploy tenant instance from ${env_name}"
  if ! apply_tenant_instance "${instance}" "${env_name}"; then
    echo "WARNING: failed to apply tenant kustomization for '${instance}' after undeploy." >&2
  fi
  if [[ "${await_prune}" == "true" && -n "${tenant_name}" ]]; then
    argocd_refresh_await_prune "${instance}" "${env_name}" "${tenant_name}"
  fi
}

tenant_stage_name() {
  local env_name="${1:-}"
  if [[ -n "${env_name}" ]]; then
    echo "${env_name}"
  else
    echo "${DEPLOYMENTS_STAGE}"
  fi
}

tenant_tenants_root() {
  echo "${DEPLOYMENTS_PATH}/clusters/${DEPLOYMENTS_CLUSTER}/tenants"
}

tenant_definitions_root() {
  echo "${DEPLOYMENTS_PATH}/clusters/${DEPLOYMENTS_CLUSTER}/definitions"
}

tenant_definition_stage_dir() {
  local instance="${1}"
  local env_name="${2:-}"
  local stage
  stage="$(tenant_stage_name "${env_name}")"
  echo "$(tenant_definitions_root)/${instance}/${stage}"
}

write_tenant_stage_kustomization() {
  local stage_dir="${1}"
  cat > "${stage_dir}/kustomization.yaml" <<'EOF'
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources:
- tenant.yaml
components:
- ../../components/tenant-defaults
EOF
}

scaffold_tenant_from_definition() {
  local instance="${1}"
  local env_name="${2:-dev}"
  local stage
  local definition_dir
  local target_dir

  stage="$(tenant_stage_name "${env_name}")"
  definition_dir="$(tenant_definition_stage_dir "${instance}" "${env_name}")"
  target_dir="$(tenant_stage_dir "${instance}" "${env_name}")"

  if [[ ! -d "${definition_dir}" ]]; then
    echo "ERROR: tenant '${instance}' is not defined at ${definition_dir}." >&2
    echo "Expected: clusters/${DEPLOYMENTS_CLUSTER}/definitions/${instance}/${stage}/tenant.yaml" >&2
    echo "Or an active deploy path: clusters/${DEPLOYMENTS_CLUSTER}/tenants/${instance}/${stage}/" >&2
    exit 1
  fi

  if [[ ! -f "${definition_dir}/tenant.yaml" ]]; then
    echo "ERROR: tenant definition at ${definition_dir} is missing tenant.yaml." >&2
    exit 1
  fi

  mkdir -p "${target_dir}"
  cp "${definition_dir}/tenant.yaml" "${target_dir}/tenant.yaml"
  write_tenant_stage_kustomization "${target_dir}"

  (
    cd "${DEPLOYMENTS_PATH}"
    git add "clusters/${DEPLOYMENTS_CLUSTER}/tenants/${instance}"
  )
  git_commit_push "feat(${instance}): deploy tenant definition for ${env_name}"
  echo "Activated tenant '${instance}' from definitions/${instance}/${stage}/."
}

ensure_tenant_instance_dir() {
  local instance="${1}"
  local env_name="${2:-dev}"
  local dir

  dir="$(tenant_stage_dir "${instance}" "${env_name}")"
  if [[ ! -d "${dir}" ]]; then
    scaffold_tenant_from_definition "${instance}" "${env_name}"
  fi
  tenant_instance_dir "${instance}" "${env_name}"
}

tenant_stage_dir() {
  local instance="${1}"
  local env_name="${2:-}"
  local stage
  stage="$(tenant_stage_name "${env_name}")"
  echo "$(tenant_tenants_root)/${instance}/${stage}"
}

tenant_instance_dir() {
  local instance="${1}"
  local env_name="${2:-}"
  local dir
  dir="$(tenant_stage_dir "${instance}" "${env_name}")"
  if [[ ! -d "${dir}" ]]; then
    echo "ERROR: tenant instance '${instance}' not found at ${dir}." >&2
    echo "Expected layout: clusters/${DEPLOYMENTS_CLUSTER}/tenants/${instance}/$(tenant_stage_name "${env_name}")/" >&2
    exit 1
  fi
  echo "${dir}"
}

tenant_instance_kustomization() {
  local instance="${1}"
  local env_name="${2:-}"
  echo "$(tenant_stage_dir "${instance}" "${env_name}")/kustomization.yaml"
}

tenant_instance_patch_file() {
  local instance="${1}"
  local env_name="${2:-dev}"
  local dir
  dir="$(tenant_instance_dir "${instance}" "${env_name}")"
  if [[ -f "${dir}/patch.yaml" ]]; then
    echo "${dir}/patch.yaml"
    return 0
  fi

  local first_tenant
  first_tenant=$(grep -rl "kind: Tenant" "${dir}" --include="*.yaml" 2>/dev/null | head -n1 || true)
  if [[ -z "${first_tenant}" ]]; then
    echo "ERROR: no Tenant YAML found for instance '${instance}' in ${dir}." >&2
    exit 1
  fi
  echo "${first_tenant}"
}

# Returns the Tenant YAML file that is actually applied to the cluster (i.e.
# listed under resources: in the instance kustomization.yaml). This is always
# tenant.yaml when it exists. Falls back to the patch file for legacy instances
# that only have a single YAML file.
tenant_instance_resource_file() {
  local instance="${1}"
  local env_name="${2:-dev}"
  local dir
  dir="$(tenant_instance_dir "${instance}" "${env_name}")"
  if [[ -f "${dir}/tenant.yaml" ]]; then
    echo "${dir}/tenant.yaml"
    return 0
  fi
  # Legacy: single-file instance — the patch file IS the applied resource.
  tenant_instance_patch_file "${instance}" "${env_name}"
}

tenant_instance_name_from_patch() {
  local file="${1}"
  awk '
    /^metadata:/ { in_meta=1; next }
    in_meta == 1 && /^[^[:space:]]/ { in_meta=0 }
    in_meta == 1 && $1 == "name:" { print $2; exit }
  ' "${file}"
}

tenant_realm_from_patch() {
  local file="${1}"
  awk '
    /^spec:/ { in_spec=1; next }
    in_spec == 1 && /^[^[:space:]]/ { in_spec=0 }
    in_spec == 1 && /^  isolation:/ { in_iso=1; next }
    in_iso == 1 && /^  [^[:space:]]/ { in_iso=0 }
    in_iso == 1 && $1 == "keycloakRealm:" { print $2; exit }
  ' "${file}"
}

kernel_domain() {
  if [[ -n "${GENTIAN_KERNEL_DOMAIN:-}" ]]; then
    echo "${GENTIAN_KERNEL_DOMAIN}"
    return 0
  fi
  if [[ -n "${KERNEL_DOMAIN:-}" ]]; then
    echo "${KERNEL_DOMAIN}"
    return 0
  fi
  kubectl get deploy -n gentian-system gentian-os \
    -o jsonpath='{.spec.template.spec.containers[0].env[?(@.name=="KERNEL_DOMAIN")].value}' 2>/dev/null || true
}

print_tenant_admin_login_instructions() {
  local tenant_name="${1}"
  local realm="${2}"
  local username="${3}"
  local password="${4}"

  local login_email
  login_email="$(kubectl --request-timeout=5s get tenant "${tenant_name}" -o jsonpath='{.spec.adminEmail}' 2>/dev/null || true)"
  if [[ -z "${login_email}" ]]; then
    login_email="${username}@gentian.org"
  fi

  local kernel_domain_name
  kernel_domain_name="$(kernel_domain)"

  local id_base
  if [[ -n "${kernel_domain_name}" ]]; then
    id_base="https://id.${kernel_domain_name}"
  else
    id_base="https://id.<KERNEL_DOMAIN>"
  fi

  local portal_base
  if [[ -n "${kernel_domain_name}" ]]; then
    portal_base="https://portal.${kernel_domain_name}"
  else
    portal_base="https://portal.<KERNEL_DOMAIN>"
  fi

  echo ""
  echo "─── Shared Gentian Portal (all users) ───────────────────────────────────────"
  echo "  Sign in at the shared kernel portal with your email address."
  echo "  Sign in      : ${portal_base}/login/"
  echo "  Portal       : ${portal_base}/univention/portal/  (after login)"
  echo "  UMC (admins) : ${portal_base}/univention/management/"
  echo "  Login email  : ${login_email}"
  echo "  Password     : ${password}"
  echo ""
  echo "─── Tenant Keycloak Realm Admin (secondary) ─────────────────────────────────"
  echo "  Same user manages OIDC clients and realm settings in Keycloak."
  echo "  Keycloak Admin Console: ${id_base}/admin/${realm}/console"
  echo "  Login email: ${login_email}"
  echo "  Password    : ${password}"
  echo "─────────────────────────────────────────────────────────────────────────────"
}

wait_for_tenant_ready() {
  local tenant_name="${1}"
  local timeout_secs="${2:-600}"
  local start
  start="$(date +%s)"
  local last_phase=""
  local next_progress_at=0

  echo "Waiting for tenant '${tenant_name}' to become Ready (timeout: ${timeout_secs}s)..."

  # Capture the tenant CR creation time so we ignore stale jobs from previous deploy attempts.
  local tenant_created_at
  tenant_created_at="$(kubectl --request-timeout=5s get tenant "${tenant_name}" -o jsonpath='{.metadata.creationTimestamp}' 2>/dev/null || true)"

  while true; do
    local failed_jobs
    # Only consider jobs whose creation timestamp is >= the tenant CR creation time.
    if [[ -n "${tenant_created_at}" ]]; then
      failed_jobs="$(kubectl --request-timeout=5s get jobs -n platform-kernel -l "gentianos.io/tenant=${tenant_name}" \
        -o jsonpath='{range .items[?(@.status.failed>0)]}{.metadata.creationTimestamp}{" "}{.metadata.name}{"\n"}{end}' 2>/dev/null \
        | awk -v cutoff="${tenant_created_at}" '$1 >= cutoff {print $2}' || true)"
    else
      failed_jobs="$(kubectl --request-timeout=5s get jobs -n platform-kernel -l "gentianos.io/tenant=${tenant_name}" -o jsonpath='{range .items[?(@.status.failed>0)]}{.metadata.name}{"\n"}{end}' 2>/dev/null || true)"
    fi
    if [[ -n "${failed_jobs}" ]]; then
      local first_failed_job
      first_failed_job="$(printf '%s\n' "${failed_jobs}" | sed -n '1p')"
      echo "Tenant '${tenant_name}' has failed provisioning Job(s):" >&2
      printf '%s\n' "${failed_jobs}" | sed 's/^/  - /' >&2
      if [[ -n "${first_failed_job}" ]]; then
        echo "Recent logs from failed Job '${first_failed_job}':" >&2
        kubectl --request-timeout=5s logs -n platform-kernel "job/${first_failed_job}" --tail=20 2>/dev/null | sed 's/^/    /' >&2 || true
      fi
      return 1
    fi

    local phase
      phase="$(kubectl --request-timeout=5s get tenant "${tenant_name}" -o jsonpath='{.status.phase}' 2>/dev/null || true)"

    if [[ -z "${phase}" ]]; then
      phase="<pending-status>"
    fi

    if [[ "${phase}" != "${last_phase}" ]]; then
      local now_phase
      now_phase="$(date +%s)"
      echo "  tenant '${tenant_name}' phase: ${phase} (elapsed: $((now_phase - start))s)"
      last_phase="${phase}"
      next_progress_at=$((now_phase - start + 30))
    fi

    local now_progress
    now_progress="$(date +%s)"
    local elapsed
    elapsed=$((now_progress - start))
    if (( elapsed >= next_progress_at )); then
      echo "  tenant '${tenant_name}' still in phase: ${phase} (elapsed: ${elapsed}s)"
      next_progress_at=$((elapsed + 30))
    fi

    if [[ "${phase}" == "Ready" ]]; then
      local now_ready
      now_ready="$(date +%s)"
      echo "Tenant '${tenant_name}' is Ready after $((now_ready - start))s."
      return 0
    fi

    if [[ "${phase}" =~ ^(Failed|Error|Degraded)$ ]]; then
      echo "Tenant '${tenant_name}' entered non-ready phase: ${phase}" >&2
      return 1
    fi

    local now
    now="$(date +%s)"
    if (( now - start >= timeout_secs )); then
      echo "Timed out waiting for tenant '${tenant_name}' to become Ready." >&2
      return 1
    fi

    sleep 5
  done
}

ldap_admin_password_synced() {
  local tenant_name="${1}"
  local ldap_job="ldap-admin-user-${tenant_name}"
  local succeeded
  succeeded="$(kubectl --request-timeout=5s get job -n platform-kernel "${ldap_job}" -o jsonpath='{.status.succeeded}' 2>/dev/null || true)"
  if [[ -z "${succeeded}" || "${succeeded}" == "0" ]]; then
    return 1
  fi
  kubectl --request-timeout=5s logs -n platform-kernel "${ldap_job}" 2>/dev/null \
    | grep -qE 'TENANT_ADMIN_LDAP_PASSWORD_SYNCED|password synced via interim rotation|user admin-'"${tenant_name}"' password synced \(HTTP'
}

fetch_tenant_admin_credentials() {
  local tenant_name="${1}"
  local timeout_secs="${2:-300}"
  local start
  start="$(date +%s)"
  local next_progress_at=0

  TENANT_ADMIN_USERNAME=""
  TENANT_ADMIN_PASSWORD=""

  echo "Retrieving tenant-admin credentials for '${tenant_name}' (timeout: ${timeout_secs}s)..."

  while true; do
    if ! ldap_admin_password_synced "${tenant_name}"; then
      local now_ldap
      now_ldap="$(date +%s)"
      local elapsed_ldap
      elapsed_ldap=$((now_ldap - start))
      if (( elapsed_ldap >= next_progress_at )); then
        echo "  waiting for LDAP admin password sync (elapsed: ${elapsed_ldap}s)"
        next_progress_at=$((next_progress_at + 30))
      fi
    else
      # Portal login validates against LDAP; prefer OpenBao (canonical) once LDAP sync is done.
      local k8s_creds
      k8s_creds="$(fetch_tenant_admin_credentials_via_k8s_auth "${tenant_name}")"
      if [[ -n "${k8s_creds}" ]]; then
        IFS=$'\t' read -r TENANT_ADMIN_USERNAME TENANT_ADMIN_PASSWORD <<<"${k8s_creds}"
        if [[ -z "${TENANT_ADMIN_USERNAME}" ]]; then
          TENANT_ADMIN_USERNAME="admin-${tenant_name}"
        fi
        local now_k8s
        now_k8s="$(date +%s)"
        echo "Retrieved tenant-admin credentials from OpenBao after LDAP sync ($((now_k8s - start))s)."
        return 0
      fi

      if command -v bao >/dev/null 2>&1; then
        local bao_user
        local bao_pw
        bao_user="$(bao kv get -mount=secret -field=username "gentian-os/tenants/${tenant_name}/admin" 2>/dev/null || true)"
        bao_pw="$(bao kv get -mount=secret -field=password "gentian-os/tenants/${tenant_name}/admin" 2>/dev/null || true)"
        if [[ -n "${bao_pw}" ]]; then
          TENANT_ADMIN_USERNAME="${bao_user}"
          if [[ -z "${TENANT_ADMIN_USERNAME}" ]]; then
            TENANT_ADMIN_USERNAME="admin-${tenant_name}"
          fi
          TENANT_ADMIN_PASSWORD="${bao_pw}"
          local now_bao
          now_bao="$(date +%s)"
          echo "Retrieved tenant-admin credentials from OpenBao after LDAP sync ($((now_bao - start))s)."
          return 0
        fi
      fi

      local line
      line="$(kubectl --request-timeout=5s logs -n platform-kernel "job/keycloak-admin-${tenant_name}" 2>/dev/null | grep 'INITIAL_TENANT_ADMIN ' | tail -n1 || true)"
      if [[ -n "${line}" ]]; then
        TENANT_ADMIN_USERNAME="$(echo "${line}" | sed -n 's/.*username=\([^[:space:]]*\).*/\1/p')"
        TENANT_ADMIN_PASSWORD="$(echo "${line}" | sed -n 's/.*password=\([^[:space:]]*\).*/\1/p')"
        if [[ -n "${TENANT_ADMIN_USERNAME}" && -n "${TENANT_ADMIN_PASSWORD}" ]]; then
          local now_ok
          now_ok="$(date +%s)"
          echo "Retrieved tenant-admin credentials from Keycloak admin Job logs after LDAP sync ($((now_ok - start))s)."
          return 0
        fi
      fi
    fi

    local now_status
    now_status="$(date +%s)"
    local elapsed
    elapsed=$((now_status - start))
    if (( elapsed >= next_progress_at )); then
      echo "  still waiting for tenant-admin credentials (elapsed: ${elapsed}s)"
      next_progress_at=$((next_progress_at + 30))
    fi

    local now
    now="$(date +%s)"
    if (( now - start >= timeout_secs )); then
      echo "Timed out waiting for LDAP admin password sync and tenant-admin credentials." >&2
      return 1
    fi

    sleep 5
  done
}

fetch_tenant_admin_credentials_via_k8s_auth() {
  local tenant_name="${1}"

  local jwt
  jwt="$(kubectl --request-timeout=5s create token -n gentian-system gentian-os --duration=10m 2>/dev/null || true)"
  if [[ -z "${jwt}" ]]; then
    return 0
  fi

  local bao_pod
  bao_pod="$(kubectl --request-timeout=5s get pod -n openbao -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
  if [[ -z "${bao_pod}" ]]; then
    return 0
  fi

  local login_token
  login_token="$(kubectl --request-timeout=10s exec -n openbao "${bao_pod}" -- sh -lc "BAO_ADDR=http://127.0.0.1:8200 bao write -field=token auth/kubernetes/login role=gentian-os-operator jwt='${jwt}'" 2>/dev/null || true)"
  if [[ -z "${login_token}" ]]; then
    return 0
  fi

  local username
  local password

  username="$(kubectl --request-timeout=10s exec -n openbao "${bao_pod}" -- sh -lc "BAO_ADDR=http://127.0.0.1:8200 BAO_TOKEN='${login_token}' bao kv get -mount=secret -field=username gentian-os/tenants/${tenant_name}/admin" 2>/dev/null || true)"
  password="$(kubectl --request-timeout=10s exec -n openbao "${bao_pod}" -- sh -lc "BAO_ADDR=http://127.0.0.1:8200 BAO_TOKEN='${login_token}' bao kv get -mount=secret -field=password gentian-os/tenants/${tenant_name}/admin" 2>/dev/null || true)"

  if [[ -n "${password}" ]]; then
    if [[ -z "${username}" ]]; then
      username="admin-${tenant_name}"
    fi
    printf '%s\t%s\n' "${username}" "${password}"
  fi
}

rollback_deploy() {
  local instance="${1}"
  local tenant_name="${2}"
  local env_name="${3}"
  local _kustom_file="${4:-}"
  local ns_name="tenant-${tenant_name}"

  echo "failed to provision tenant, rolling back" >&2

  argocd_refresh_await_prune "${instance}" "${env_name}" "${tenant_name}" || true

  if kubectl get tenant "${tenant_name}" &>/dev/null 2>&1; then
    ns_name="$(kubectl get tenant "${tenant_name}" \
      -o jsonpath='{.status.namespace}' 2>/dev/null || true)"
    if [[ -z "${ns_name}" ]]; then
      ns_name="tenant-${tenant_name}"
    fi
    kubectl delete tenant "${tenant_name}" --ignore-not-found=true
  fi

  if kubectl get tenant "${tenant_name}" &>/dev/null 2>&1; then
    if ! wait_for_tenant_delete "${tenant_name}" "${ns_name}" false "" "${instance}" "${env_name}"; then
      echo "rollback failed: tenant resource '${tenant_name}' still exists in the cluster" >&2
      return 1
    fi
  fi

  kubectl delete jobs -n platform-kernel -l "gentianos.io/tenant=${tenant_name}" --ignore-not-found=true >/dev/null 2>&1 || true
  argocd_refresh_await_prune "${instance}" "${env_name}" "${tenant_name}" || true

  if kubectl get tenant "${tenant_name}" >/dev/null 2>&1; then
    echo "rollback failed: tenant resource '${tenant_name}' still exists in the cluster" >&2
    return 1
  fi

  echo "Rollback completed: tenant '${tenant_name}' removed from cluster (git manifest preserved)." >&2
  return 1
}

is_instance_deployed() {
  local instance="${1}"
  local env_name="${2:-dev}"
  [[ -f "$(tenant_stage_dir "${instance}" "${env_name}")/tenant.yaml" ]]
}

ensure_env_layout() {
  local _env_name="${1:-dev}"
  local root
  root="$(tenant_tenants_root)"

  if [[ ! -d "${root}" ]]; then
    echo "ERROR: tenant path not found: ${root}" >&2
    echo "Set GENTIAN_DEPLOYMENTS_CLUSTER (currently '${DEPLOYMENTS_CLUSTER}') in ${CONFIG_FILE}." >&2
    exit 1
  fi
}

append_instance_resource() {
  local kustom_file="${1}"
  local instance="${2}"

  if grep -Eq "^[[:space:]]*resources:[[:space:]]*\[[[:space:]]*\][[:space:]]*$" "${kustom_file}"; then
    awk -v item="instances/${instance}" '
      {
        if ($0 ~ /^[[:space:]]*resources:[[:space:]]*\[[[:space:]]*\][[:space:]]*$/) {
          print "resources:"
          print "- " item
          next
        }
        print
      }
    ' "${kustom_file}" > "${kustom_file}.tmp"
    mv "${kustom_file}.tmp" "${kustom_file}"
    return 0
  fi

  awk -v item="instances/${instance}" '
    BEGIN { in_res=0; inserted=0 }
    {
      if ($0 ~ /^resources:[[:space:]]*$/) {
        print
        in_res=1
        next
      }
      if (in_res == 1) {
        if ($0 ~ /^[[:space:]]*-[[:space:]]+/) {
          print
          next
        }
        if (inserted == 0) {
          print "- " item
          inserted=1
        }
        in_res=0
      }
      print
    }
    END {
      if (in_res == 1 && inserted == 0) {
        print "- " item
        inserted=1
      }
      if (inserted == 0) {
        print "resources:"
        print "- " item
      }
    }
  ' "${kustom_file}" > "${kustom_file}.tmp"
  mv "${kustom_file}.tmp" "${kustom_file}"
}

remove_instance_resource() {
  local kustom_file="${1}"
  local instance="${2}"

  sed -i "/^[[:space:]]*-[[:space:]]*instances\/${instance}[[:space:]]*$/d" "${kustom_file}"

  # Keep a valid empty list when no instances remain.
  if grep -Eq "^[[:space:]]*resources:[[:space:]]*$" "${kustom_file}"; then
    local resource_count
    resource_count="$(awk '
      BEGIN { in_res=0; count=0 }
      /^resources:[[:space:]]*$/ { in_res=1; next }
      in_res == 1 && /^[[:space:]]*-[[:space:]]+/ { count++; next }
      in_res == 1 && /^[^[:space:]]/ { in_res=0 }
      END { print count }
    ' "${kustom_file}")"

    if [[ "${resource_count}" == "0" ]]; then
      sed -i 's/^resources:[[:space:]]*$/resources: []/' "${kustom_file}"
    fi
  fi
}

ensure_kustomization_seed() {
  local kustom_file="${1}"

  if [[ ! -s "${kustom_file}" ]]; then
    cat > "${kustom_file}" <<EOF
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization
resources: []
EOF
    return 0
  fi

  if ! grep -Eq "^[[:space:]]*resources:" "${kustom_file}"; then
    printf "\nresources: []\n" >> "${kustom_file}"
  fi
}

# argocd_refresh_await_prune INSTANCE STAGE TENANT_NAME
argocd_refresh_await_prune() {
  local instance="${1}"
  local env_name="${2:-${DEPLOYMENTS_STAGE}}"
  local tenant_name="${3}"

  if ! kubectl get tenant "${tenant_name}" --no-headers &>/dev/null 2>&1; then
    return 0
  fi

  if [[ -z "$(argocd_tenants_app_for_instance "${instance}" "${env_name}")" ]]; then
    echo "No ArgoCD app found for 'clusters/${DEPLOYMENTS_CLUSTER}/tenants/${instance}/${env_name}'; deleting tenant CR directly..."
    kubectl delete tenant "${tenant_name}" --ignore-not-found=true
    wait_with_message \
      "Waiting for tenant '${tenant_name}' to be removed after direct delete (timeout: 120s)..." \
      tenant "${tenant_name}" --for=delete --timeout=120s 2>/dev/null || true
    if kubectl get tenant "${tenant_name}" --no-headers &>/dev/null 2>&1; then
      echo "ERROR: tenant '${tenant_name}' still present after direct delete." >&2
      return 1
    fi
    return 0
  fi

  argocd_trigger_sync_prune "${instance}" "${env_name}"

  echo "Waiting for ArgoCD to prune tenant '${tenant_name}' from the cluster (timeout: 120s)..."
  local i=0
  while [[ ${i} -lt 120 ]]; do
    if ! kubectl get tenant "${tenant_name}" --no-headers &>/dev/null 2>&1; then
      echo "Tenant '${tenant_name}' removed from cluster."
      return 0
    fi
    if (( i > 0 && i % 10 == 0 )); then
      echo "  tenant '${tenant_name}' still present after ArgoCD sync (${i}s elapsed)..."
    fi
    sleep 2
    (( i += 2 ))
  done

  echo "WARNING: tenant '${tenant_name}' still present after ArgoCD sync; deleting directly..." >&2
  kubectl delete tenant "${tenant_name}" --ignore-not-found=true
  wait_with_message \
    "Waiting for tenant '${tenant_name}' finalizers to finish after direct delete (timeout: 120s)..." \
    tenant "${tenant_name}" --for=delete --timeout=120s 2>/dev/null || true
  if kubectl get tenant "${tenant_name}" --no-headers &>/dev/null 2>&1; then
    echo "ERROR: failed to remove tenant '${tenant_name}' from cluster." >&2
    return 1
  fi
  echo "Tenant '${tenant_name}' removed from cluster."
  return 0
}

apply_tenant_instance() {
  local instance="${1}"
  local env_name="${2:-dev}"
  local output

  output="$(kubectl apply -k "$(tenant_stage_dir "${instance}" "${env_name}")" 2>&1)"
  local rc=$?

  if [[ ${rc} -eq 0 ]]; then
    [[ -n "${output}" ]] && echo "${output}"
    return 0
  fi

  echo "${output}" >&2
  return ${rc}
}

tenant_collect_instance_names() {
  local env_name="${1:-dev}"
  local tenants_root definitions_root stage
  local tenant_dir instance

  tenants_root="$(tenant_tenants_root)"
  definitions_root="$(tenant_definitions_root)"
  stage="$(tenant_stage_name "${env_name}")"

  declare -A instances=()

  for tenant_dir in "${tenants_root}"/* "${definitions_root}"/*; do
    [[ -d "${tenant_dir}" ]] || continue
    instance="$(basename "${tenant_dir}")"
    [[ "${instance}" == "components" ]] && continue
    [[ -f "${tenant_dir}/${stage}/tenant.yaml" ]] || continue
    instances["${instance}"]=1
  done

  if [[ ${#instances[@]} -eq 0 ]]; then
    return 0
  fi

  printf '%s\n' "${!instances[@]}" | sort
}

cmd_tenant_list() {
  local env_name="${1:-dev}"
  local tenants_root definitions_root stage

  ensure_repo
  ensure_env_layout "${env_name}"

  tenants_root="$(tenant_tenants_root)"
  definitions_root="$(tenant_definitions_root)"
  stage="$(tenant_stage_name "${env_name}")"

  local found=0
  printf "%-24s %-10s %-8s %-18s\n" "INSTANCE" "ACTIVE" "LIVE" "TENANT_NAME"
  printf "%-24s %-10s %-8s %-18s\n" "--------" "------" "----" "-----------"

  local instance_name
  while IFS= read -r instance_name; do
    [[ -n "${instance_name}" ]] || continue
    found=1

    local active live tenant_file tenant_name

    tenant_file="${tenants_root}/${instance_name}/${stage}/tenant.yaml"
    if [[ -f "${tenant_file}" ]]; then
      active="yes"
    else
      active="no"
      tenant_file="${definitions_root}/${instance_name}/${stage}/tenant.yaml"
    fi

    tenant_name="$(tenant_instance_name_from_patch "${tenant_file}")"
    if [[ -z "${tenant_name}" ]]; then
      tenant_name="${instance_name}"
    fi

    if kubectl get tenant "${tenant_name}" --no-headers &>/dev/null 2>&1; then
      live="yes"
    else
      live="no"
    fi

    printf "%-24s %-10s %-8s %-18s\n" "${instance_name}" "${active}" "${live}" "${tenant_name}"
  done < <(tenant_collect_instance_names "${env_name}")

  if [[ "${found}" -eq 0 ]]; then
    echo "No tenant definitions found under clusters/${DEPLOYMENTS_CLUSTER}/definitions/*/${stage} or tenants/*/${stage}."
  fi
}

cmd_tenant_deploy() {
  local instance="${1:-}"
  local env_name="${2:-dev}"

  if [[ -z "${instance}" ]]; then
    echo "ERROR: usage: kubectl gentian tenants deploy <instance> [--env <env>]" >&2
    exit 1
  fi

  ensure_repo
  ensure_env_layout "${env_name}"
  ensure_tenant_instance_dir "${instance}" "${env_name}" >/dev/null

  local patch
  local tenant_name
  local realm

  patch="$(tenant_instance_patch_file "${instance}" "${env_name}")"
  tenant_name="$(tenant_instance_name_from_patch "${patch}")"
  realm="$(tenant_realm_from_patch "${patch}")"

  if [[ -z "${tenant_name}" ]]; then
    tenant_name="${instance}"
  fi
  if [[ -z "${realm}" ]]; then
    realm="${tenant_name}"
  fi

  if kubectl get tenant "${tenant_name}" --no-headers &>/dev/null 2>&1; then
    echo "Tenant instance '${instance}' is already live in '${env_name}' — applying spec changes..."
  else
    echo "Tenant instance '${instance}' manifest found — applying to cluster..."
  fi

  echo "Applying tenant desired state for '${env_name}'..."
  if ! apply_tenant_instance "${instance}" "${env_name}"; then
    rollback_deploy "${instance}" "${tenant_name}" "${env_name}"
  fi

  echo "Waiting for tenant reconciliation to complete..."
  if ! wait_for_tenant_ready "${tenant_name}" 600; then
    rollback_deploy "${instance}" "${tenant_name}" "${env_name}"
  fi

  echo "Waiting for tenant-admin credentials to become available..."
  if ! fetch_tenant_admin_credentials "${tenant_name}" 300; then
    rollback_deploy "${instance}" "${tenant_name}" "${env_name}"
  fi

  echo "Done. Tenant instance '${instance}' deployed in '${env_name}'."
  print_tenant_admin_login_instructions "${tenant_name}" "${realm}" "${TENANT_ADMIN_USERNAME}" "${TENANT_ADMIN_PASSWORD}"
}

cmd_tenant_undeploy() {
  local instance="${1:-}"
  local env_name="${2:-dev}"
  local purge="${3:-false}"

  if [[ -z "${instance}" ]]; then
    echo "ERROR: usage: kubectl gentian tenants undeploy <instance> [--env <env>] [--purge]" >&2
    exit 1
  fi

  ensure_repo
  ensure_env_layout "${env_name}"
  tenant_instance_dir "${instance}" "${env_name}" >/dev/null

  local patch
  local resource_file
  local tenant_name
  local ns_name

  patch="$(tenant_instance_patch_file "${instance}" "${env_name}")"
  resource_file="$(tenant_instance_resource_file "${instance}" "${env_name}")"
  tenant_name="$(tenant_instance_name_from_patch "${patch}")"
  if [[ -z "${tenant_name}" ]]; then
    tenant_name="${instance}"
  fi
  ns_name="tenant-${tenant_name}"

  if [[ "${purge}" == "true" ]]; then
    cmd_tenant_undeploy_purge "${instance}" "${env_name}" "${tenant_name}" \
      "${resource_file}"
    return $?
  fi

  # Non-purge undeploy: if a prior --purge run left deletionPolicy=Delete in the YAML,
  # reset it to Retain first so the controller preserves tenant data.
  if grep -q '^  deletionPolicy: Delete$' "${resource_file}" 2>/dev/null; then
    set_tenant_deletion_policy "${resource_file}" "Retain"
    (
      cd "${DEPLOYMENTS_PATH}"
      git add "${resource_file}"
    )
    local live_policy
    live_policy="$(kubectl get tenant "${tenant_name}" \
      -o jsonpath='{.spec.deletionPolicy}' 2>/dev/null || echo "Retain")"
    if [[ "${live_policy}" == "Delete" ]] && is_instance_deployed "${instance}" "${env_name}"; then
      git_commit_push "chore(${instance}): reset deletionPolicy to Retain before undeploy in ${env_name}"
      apply_tenant_instance "${instance}" "${env_name}" 2>/dev/null || true
    fi
  fi

  if ! is_instance_deployed "${instance}" "${env_name}"; then
    echo "Tenant instance '${instance}' is not deployed in '${env_name}'."
    git_commit_push "chore(${instance}): finalize tenant undeploy in ${env_name}"
  else
    tenant_undeploy_remove_from_git "${instance}" "${env_name}" "" true "${tenant_name}"
  fi

  ns_name="$(kubectl get tenant "${tenant_name}" \
    -o jsonpath='{.status.namespace}' 2>/dev/null || true)"
  if [[ -z "${ns_name}" ]]; then
    ns_name="tenant-${tenant_name}"
  fi

  kubectl delete tenant "${tenant_name}" --ignore-not-found=true

  if ! wait_for_tenant_delete "${tenant_name}" "${ns_name}" false "" "${instance}" "${env_name}"; then
    exit 1
  fi

  if [[ -f "${resource_file}" ]] && grep -q '^  deletionPolicy: Delete$' "${resource_file}" 2>/dev/null; then
    set_tenant_deletion_policy "${resource_file}" "Retain"
    (
      cd "${DEPLOYMENTS_PATH}"
      git add "${resource_file}"
    )
    git_commit_push "chore(${instance}): reset deletionPolicy to Retain after undeploy in ${env_name}"
  fi

  if ! argocd_refresh_await_prune "${instance}" "${env_name}" "${tenant_name}"; then
    exit 1
  fi

  echo "Done. Tenant instance '${instance}' undeployed in '${env_name}'."
}

cmd_tenant_undeploy_purge() {
  local instance="${1}"
  local env_name="${2}"
  local tenant_name="${3}"
  local resource_file="${4}"
  local ns_name="tenant-${tenant_name}"
  local tenant_exists=false

  if ! grep -q '^  deletionPolicy: Delete$' "${resource_file}"; then
    set_tenant_deletion_policy "${resource_file}" "Delete"
    (
      cd "${DEPLOYMENTS_PATH}"
      git add "${resource_file}"
    )
  fi

  if kubectl get tenant "${tenant_name}" &>/dev/null; then
    tenant_exists=true
    ns_name="$(kubectl get tenant "${tenant_name}" \
      -o jsonpath='{.status.namespace}' 2>/dev/null || true)"
    if [[ -z "${ns_name}" ]]; then
      ns_name="tenant-${tenant_name}"
    fi
  fi

  if [[ "${tenant_exists}" == "true" ]]; then
    # Orphan: live in cluster but not listed in kustomization (e.g. ArgoCD
    # selfHeal after a prior undeploy). Sync/prune before destructive cleanup.
    if ! is_instance_deployed "${instance}" "${env_name}"; then
      echo "Tenant '${tenant_name}' is live but not active in GitOps; pruning via ArgoCD..."
      if argocd_refresh_await_prune "${instance}" "${env_name}" "${tenant_name}"; then
        tenant_exists=false
      fi
    fi
  fi

  if [[ "${tenant_exists}" == "true" ]]; then
    if is_instance_deployed "${instance}" "${env_name}"; then
      (
        cd "${DEPLOYMENTS_PATH}"
        git add "${resource_file}"
        if ! git diff --cached --quiet 2>/dev/null; then
          git_commit_push "feat(${instance}): set deletionPolicy=Delete before purge in ${env_name}"
        fi
      )
      echo "Applying deletionPolicy=Delete for '${tenant_name}'..."
      if ! apply_tenant_instance "${instance}" "${env_name}"; then
        echo "WARNING: failed to apply tenant manifest for '${instance}' before purge." >&2
      fi
      if ! assert_live_tenant_deletion_policy "${tenant_name}" "Delete" 180; then
        exit 1
      fi
    else
      if ! assert_live_tenant_deletion_policy "${tenant_name}" "Delete" 180; then
        exit 1
      fi
    fi

    echo "Deleting tenant '${tenant_name}' with deletionPolicy=Delete..."
    kubectl delete tenant "${tenant_name}" --ignore-not-found=true

    if is_instance_deployed "${instance}" "${env_name}"; then
      tenant_undeploy_remove_from_git "${instance}" "${env_name}" "" false "${tenant_name}"
      argocd_trigger_sync_prune "${instance}" "${env_name}"
    fi

    if ! wait_for_tenant_delete "${tenant_name}" "${ns_name}" true "${resource_file}" "${instance}" "${env_name}"; then
      exit 1
    fi

    purge_tenant_cluster_artifacts "${tenant_name}" "${ns_name}"
  else
    echo "Tenant CR '${tenant_name}' is not present; purging orphaned cluster artifacts..."
    purge_tenant_cluster_artifacts "${tenant_name}" "${ns_name}"
    (
      cd "${DEPLOYMENTS_PATH}"
      if ! git diff --cached --quiet 2>/dev/null; then
        git_commit_push "feat(${instance}): enable destructive tenant deletion in ${env_name}"
      fi
    )
  fi

  if is_instance_deployed "${instance}" "${env_name}"; then
    tenant_undeploy_remove_from_git "${instance}" "${env_name}" "" false "${tenant_name}"
  fi

  if [[ -f "${resource_file}" ]] && grep -q '^  deletionPolicy: Delete$' "${resource_file}" 2>/dev/null; then
    set_tenant_deletion_policy "${resource_file}" "Retain"
    (
      cd "${DEPLOYMENTS_PATH}"
      git add "${resource_file}"
    )
    git_commit_push "chore(${instance}): reset deletionPolicy to Retain after purge in ${env_name}"
  fi

  if ! argocd_refresh_await_prune "${instance}" "${env_name}" "${tenant_name}"; then
    exit 1
  fi

  echo "Done. Tenant instance '${instance}' undeployed with purge behavior in '${env_name}'."
}

# ---------------------------------------------------------------------------
# apps list
# ---------------------------------------------------------------------------
cmd_list() {
  echo "Available apps from AppCatalogue:"
  echo ""
  kubectl get appcatalogue default -o jsonpath='{range .status.apps[*]}{.name}{"\t"}{.chartVersion}{"\t"}{.installedCount}{"\t"}{range .kernelRequirements[*]}{@}{","}{end}{"\n"}{end}' \
    | awk -F'\t' '
      BEGIN {
        fmt = "%-30s %-12s %-12s %s\n"
        printf fmt, "NAME", "VERSION", "INSTALLED", "REQUIRES"
        printf fmt, "----", "-------", "---------", "--------"
      }
      {
        sub(/,$/, "", $4)
        if ($4 == "") $4 = "-"
        printf fmt, $1, $2, $3 " tenants", $4
      }'
}

# ---------------------------------------------------------------------------
# apps install
# ---------------------------------------------------------------------------
cmd_install() {
  local app="${1:-}"
  local tenant="${2:-}"

  if [[ -z "${app}" || -z "${tenant}" ]]; then
    echo "ERROR: usage: kubectl gentian apps install <app> --tenant <tenant>" >&2
    exit 1
  fi

  ensure_repo

  local file
  file=$(tenant_file "${tenant}")

  # Guard: check AppProfile exists in the cluster before touching Git.
  if ! kubectl get appprofile "${app}" &>/dev/null; then
    echo "ERROR: AppProfile '${app}' not found in the cluster. Is the app catalogue synced?" >&2
    exit 1
  fi

  # Guard: check not already installed.
  if grep -q "profile: ${app}" "${file}"; then
    echo "App '${app}' is already listed in tenant '${tenant}'. Nothing to do."
    exit 0
  fi

  # Inject the entry under spec.apps.
  # The apps: key is always at 2-space indent; entries are "  - profile: <name>".
  # Insert immediately after the "  apps:" line (order within the list is irrelevant).
  if grep -q '^  apps:' "${file}"; then
    sed -i "/^  apps:/a\\  - profile: ${app}" "${file}"
  else
    # No apps key yet — append the block at the end of the file.
    printf '  apps:\n  - profile: %s\n' "${app}" >> "${file}"
  fi
  echo "Added '${app}' to spec.apps."

  # Commit and push.
  (
    cd "${DEPLOYMENTS_PATH}"
    git add "${file}"
  )
  git_commit_push "feat(${tenant}): install ${app}"

  # Apply the updated Tenant CR so the operator reconciles immediately.
  kubectl apply -f "${file}"

  echo "Done. Tenant '${tenant}' updated — operator will provision '${app}'."
}

# ---------------------------------------------------------------------------
# apps uninstall
# ---------------------------------------------------------------------------
cmd_uninstall() {
  local app="${1:-}"
  local tenant="${2:-}"

  if [[ -z "${app}" || -z "${tenant}" ]]; then
    echo "ERROR: usage: kubectl gentian apps uninstall <app> --tenant <tenant>" >&2
    exit 1
  fi

  ensure_repo

  local file
  file=$(tenant_file "${tenant}")

  # Guard: check actually installed.
  if ! grep -q "profile: ${app}" "${file}"; then
    echo "App '${app}' is not listed in tenant '${tenant}'. Nothing to do."
    exit 0
  fi

  # Remove the '- profile: <app>' line from spec.apps using sed.
  sed -i "/^  - profile: ${app}$/d" "${file}"
  echo "Removed '${app}' from spec.apps."

  # Commit and push.
  (
    cd "${DEPLOYMENTS_PATH}"
    git add "${file}"
  )
  git_commit_push "feat(${tenant}): uninstall ${app}"

  # Apply the updated Tenant CR so the operator reconciles immediately.
  kubectl apply -f "${file}"

  echo "Done. Tenant '${tenant}' updated — operator will deprovision '${app}'."
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

SUBCOMMAND="${1:-}"
shift

case "${SUBCOMMAND}" in
  apps)
    APPS_CMD="${1:-}"
    shift || true
    case "${APPS_CMD}" in
      list)
        cmd_list
        ;;
      install|uninstall)
        APP_NAME="${1:-}"
        shift || true
        TENANT_NAME=""
        while [[ $# -gt 0 ]]; do
          case "${1}" in
            --tenant|-t)
              TENANT_NAME="${2:-}"
              shift 2
              ;;
            *)
              echo "ERROR: unknown flag: ${1}" >&2
              exit 1
              ;;
          esac
        done
        if [[ "${APPS_CMD}" == "install" ]]; then
          cmd_install "${APP_NAME}" "${TENANT_NAME}"
        else
          cmd_uninstall "${APP_NAME}" "${TENANT_NAME}"
        fi
        ;;
      *)
        echo "ERROR: unknown apps subcommand: ${APPS_CMD}" >&2
        usage
        exit 1
        ;;
    esac
    ;;
  tenant|tenants)
    TENANT_CMD="${1:-}"
    shift || true
    TENANT_ENV="dev"
    case "${TENANT_CMD}" in
      list)
        while [[ $# -gt 0 ]]; do
          case "${1}" in
            --env|-e)
              TENANT_ENV="${2:-}"
              shift 2
              ;;
            *)
              echo "ERROR: unknown flag: ${1}" >&2
              exit 1
              ;;
          esac
        done
        cmd_tenant_list "${TENANT_ENV}"
        ;;
      deploy)
        TENANT_INSTANCE="${1:-}"
        shift || true
        while [[ $# -gt 0 ]]; do
          case "${1}" in
            --env|-e)
              TENANT_ENV="${2:-}"
              shift 2
              ;;
            *)
              echo "ERROR: unknown flag: ${1}" >&2
              exit 1
              ;;
          esac
        done
        cmd_tenant_deploy "${TENANT_INSTANCE}" "${TENANT_ENV}"
        ;;
      undeploy)
        TENANT_INSTANCE="${1:-}"
        shift || true
        PURGE=false
        while [[ $# -gt 0 ]]; do
          case "${1}" in
            --env|-e)
              TENANT_ENV="${2:-}"
              shift 2
              ;;
            --purge|-f)
              PURGE=true
              shift
              ;;
            *)
              echo "ERROR: unknown flag: ${1}" >&2
              exit 1
              ;;
          esac
        done
        cmd_tenant_undeploy "${TENANT_INSTANCE}" "${TENANT_ENV}" "${PURGE}"
        ;;
      *)
        echo "ERROR: unknown tenants subcommand: ${TENANT_CMD}" >&2
        usage
        exit 1
        ;;
    esac
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "ERROR: unknown subcommand: ${SUBCOMMAND}" >&2
    usage
    exit 1
    ;;
esac
