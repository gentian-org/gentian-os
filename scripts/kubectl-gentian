#!/usr/bin/env bash
# kubectl-gentian — kubectl plugin for Gentian OS management.
#
# Provides subcommands for the Gentian App Store and tenant lifecycle. GitOps
# operations edit the Tenant CR YAML in the gentian-deployments repository and
# commit+push the change. ArgoCD then reconciles the new state — the Git commit
# is the single source of truth and the audit trail.
#
# Usage:
#   kubectl gentian apps list [--namespace <ns>]
#   kubectl gentian apps install <app> --tenant <tenant>
#   kubectl gentian apps uninstall <app> --tenant <tenant>
#   kubectl gentian tenants list [--env <env>]
#   kubectl gentian tenants deploy <instance> [--env <env>]
#   kubectl gentian tenants undeploy <instance> [--env <env>] [--purge]
#
# Required environment variables (or ~/.gentian/config):
#   GENTIAN_DEPLOYMENTS_PATH   local path to a gentian-deployments checkout
#   GENTIAN_DEPLOYMENTS_REPO   remote URL (used for initial clone if path absent)
#
# The plugin respects KUBECONFIG / kubectl context for the `list` subcommand.

set -euo pipefail

# ---------------------------------------------------------------------------
# Config resolution
# ---------------------------------------------------------------------------
CONFIG_FILE="${HOME}/.gentian/config"
if [[ -f "${CONFIG_FILE}" ]]; then
  # shellcheck disable=SC1090
  source "${CONFIG_FILE}"
fi

DEPLOYMENTS_PATH="${GENTIAN_DEPLOYMENTS_PATH:-}"
DEPLOYMENTS_REPO="${GENTIAN_DEPLOYMENTS_REPO:-}"

usage() {
  cat <<EOF
kubectl-gentian — Gentian OS management plugin

Usage:
  kubectl gentian apps list
      List all available apps from the AppCatalogue.

  kubectl gentian apps install <app> --tenant <tenant>
      Install an app for a tenant by committing to gentian-deployments.

  kubectl gentian apps uninstall <app> --tenant <tenant>
      Uninstall an app from a tenant by committing to gentian-deployments.

    kubectl gentian tenants list [--env <env>]
      List tenant instances available in git and whether they are deployed in the
      selected environment (default: dev).

    kubectl gentian tenants deploy <instance> [--env <env>]
      Deploy a tenant instance by adding it to <env>/tenants/kustomization.yaml.

    kubectl gentian tenants undeploy <instance> [--env <env>] [--purge]
      Undeploy a tenant instance by removing it from <env>/tenants/kustomization.yaml.
      With --purge, set deletionPolicy=Delete before undeploying and delete the
      live Tenant CR after the GitOps change.

Environment / ~/.gentian/config:
  GENTIAN_DEPLOYMENTS_PATH   local path to gentian-deployments checkout
  GENTIAN_DEPLOYMENTS_REPO   remote Git URL (used if path does not exist)

Examples:
  kubectl gentian apps list
  kubectl gentian apps install openproject --tenant gtn-demo
  kubectl gentian apps uninstall openproject --tenant gtn-demo
  kubectl gentian tenants list
  kubectl gentian tenants deploy gtn-demo
  kubectl gentian tenants undeploy gtn-demo
  kubectl gentian tenants undeploy gtn-demo --purge
EOF
}

# ---------------------------------------------------------------------------
# Helper: ensure we have a local deployment repo checkout
# ---------------------------------------------------------------------------
ensure_repo() {
  if [[ -z "${DEPLOYMENTS_PATH}" ]]; then
    echo "ERROR: GENTIAN_DEPLOYMENTS_PATH is not set." >&2
    echo "Set it in the environment or in ${CONFIG_FILE}." >&2
    exit 1
  fi

  if [[ ! -d "${DEPLOYMENTS_PATH}/.git" ]]; then
    if [[ -z "${DEPLOYMENTS_REPO}" ]]; then
      echo "ERROR: ${DEPLOYMENTS_PATH} is not a git repository and GENTIAN_DEPLOYMENTS_REPO is not set." >&2
      exit 1
    fi
    echo "Cloning ${DEPLOYMENTS_REPO} → ${DEPLOYMENTS_PATH} ..."
    git clone "${DEPLOYMENTS_REPO}" "${DEPLOYMENTS_PATH}"
  fi
}

# ---------------------------------------------------------------------------
# Helper: find the tenant YAML file
# ---------------------------------------------------------------------------
tenant_file() {
  local tenant="${1}"
  # First try matching by filename: tenants/gtn-demo.yaml or dev/tenants/gtn-demo.yaml
  local candidates
  candidates=$(find "${DEPLOYMENTS_PATH}" -name "${tenant}.yaml" -path "*/tenants/*" 2>/dev/null || true)

  # Fall back to searching by metadata.name inside all tenant YAML files
  if [[ -z "${candidates}" ]]; then
    candidates=$(grep -rl "name: ${tenant}" "${DEPLOYMENTS_PATH}" --include="*.yaml" 2>/dev/null \
      | while read -r f; do
          [[ "${f}" == */tenants/* ]] && grep -q "kind: Tenant" "${f}" && echo "${f}"
        done || true)
  fi

  if [[ -z "${candidates}" ]]; then
    echo "ERROR: Tenant file for '${tenant}' not found under ${DEPLOYMENTS_PATH}." >&2
    echo "Searched by filename (*/tenants/${tenant}.yaml) and by metadata.name." >&2
    exit 1
  fi
  # If multiple candidates exist (e.g. dev/ and staging/), take the first one.
  echo "${candidates}" | head -n1
}

git_commit_push() {
  local message="${1}"

  (
    cd "${DEPLOYMENTS_PATH}"
    if git diff --cached --quiet; then
      echo "No Git changes detected."
      exit 0
    fi
    git commit -m "${message}"
    git push
  )
}

set_tenant_deletion_policy() {
  local file="${1}"
  local policy="${2}"

  if grep -q '^  deletionPolicy:' "${file}"; then
    sed -i "s/^  deletionPolicy:.*/  deletionPolicy: ${policy}/" "${file}"
  elif grep -q '^  apps:' "${file}"; then
    sed -i "/^  apps:/i\\  deletionPolicy: ${policy}" "${file}"
  else
    printf '\n  deletionPolicy: %s\n' "${policy}" >> "${file}"
  fi
}

tenant_env_root() {
  local env_name="${1:-dev}"
  echo "${DEPLOYMENTS_PATH}/${env_name}/tenants"
}

tenant_instances_root() {
  local env_name="${1:-dev}"
  echo "$(tenant_env_root "${env_name}")/instances"
}

tenant_env_kustomization() {
  local env_name="${1:-dev}"
  echo "$(tenant_env_root "${env_name}")/kustomization.yaml"
}

tenant_instance_dir() {
  local instance="${1}"
  local env_name="${2:-dev}"
  local dir
  dir="$(tenant_instances_root "${env_name}")/${instance}"
  if [[ ! -d "${dir}" ]]; then
    echo "ERROR: tenant instance '${instance}' not found at ${dir}." >&2
    exit 1
  fi
  echo "${dir}"
}

tenant_instance_patch_file() {
  local instance="${1}"
  local env_name="${2:-dev}"
  local dir
  dir="$(tenant_instance_dir "${instance}" "${env_name}")"
  if [[ -f "${dir}/patch.yaml" ]]; then
    echo "${dir}/patch.yaml"
    return 0
  fi

  local first_tenant
  first_tenant=$(grep -rl "kind: Tenant" "${dir}" --include="*.yaml" 2>/dev/null | head -n1 || true)
  if [[ -z "${first_tenant}" ]]; then
    echo "ERROR: no Tenant YAML found for instance '${instance}' in ${dir}." >&2
    exit 1
  fi
  echo "${first_tenant}"
}

tenant_instance_name_from_patch() {
  local file="${1}"
  awk '
    /^metadata:/ { in_meta=1; next }
    in_meta == 1 && /^[^[:space:]]/ { in_meta=0 }
    in_meta == 1 && $1 == "name:" { print $2; exit }
  ' "${file}"
}

is_instance_deployed() {
  local instance="${1}"
  local env_name="${2:-dev}"
  local kustom_file
  kustom_file="$(tenant_env_kustomization "${env_name}")"

  [[ -f "${kustom_file}" ]] || return 1

  grep -Eq "^[[:space:]]*-[[:space:]]*instances/${instance}[[:space:]]*$" "${kustom_file}"
}

ensure_env_layout() {
  local env_name="${1:-dev}"
  local root
  root="$(tenant_env_root "${env_name}")"

  if [[ ! -d "${root}" ]]; then
    echo "ERROR: tenant environment path not found: ${root}" >&2
    exit 1
  fi

  if [[ ! -f "$(tenant_env_kustomization "${env_name}")" ]]; then
    echo "ERROR: missing environment kustomization: $(tenant_env_kustomization "${env_name}")" >&2
    exit 1
  fi
}

append_instance_resource() {
  local kustom_file="${1}"
  local instance="${2}"

  awk -v item="instances/${instance}" '
    BEGIN { in_res=0; inserted=0 }
    {
      if ($0 ~ /^resources:[[:space:]]*$/) {
        print
        in_res=1
        next
      }
      if (in_res == 1) {
        if ($0 ~ /^[[:space:]]*-[[:space:]]+/) {
          print
          next
        }
        if (inserted == 0) {
          print "- " item
          inserted=1
        }
        in_res=0
      }
      print
    }
    END {
      if (in_res == 1 && inserted == 0) {
        print "- " item
        inserted=1
      }
      if (inserted == 0) {
        print "resources:"
        print "- " item
      }
    }
  ' "${kustom_file}" > "${kustom_file}.tmp"
  mv "${kustom_file}.tmp" "${kustom_file}"
}

remove_instance_resource() {
  local kustom_file="${1}"
  local instance="${2}"

  sed -i "/^[[:space:]]*-[[:space:]]*instances\/${instance}[[:space:]]*$/d" "${kustom_file}"
}

cmd_tenant_list() {
  local env_name="${1:-dev}"
  local instances_dir
  local kustom_file

  ensure_repo
  ensure_env_layout "${env_name}"

  instances_dir="$(tenant_instances_root "${env_name}")"
  kustom_file="$(tenant_env_kustomization "${env_name}")"

  if [[ ! -d "${instances_dir}" ]]; then
    echo "No instances directory found: ${instances_dir}"
    return 0
  fi

  local found=0
  printf "%-24s %-10s %-18s\n" "INSTANCE" "DEPLOYED" "TENANT_NAME"
  printf "%-24s %-10s %-18s\n" "--------" "--------" "-----------"

  local instance
  for instance in "${instances_dir}"/*; do
    [[ -d "${instance}" ]] || continue
    found=1

    local instance_name
    local deployed
    local patch
    local tenant_name

    instance_name="$(basename "${instance}")"
    if grep -Eq "^[[:space:]]*-[[:space:]]*instances/${instance_name}[[:space:]]*$" "${kustom_file}"; then
      deployed="yes"
    else
      deployed="no"
    fi

    patch="$(tenant_instance_patch_file "${instance_name}" "${env_name}")"
    tenant_name="$(tenant_instance_name_from_patch "${patch}")"
    if [[ -z "${tenant_name}" ]]; then
      tenant_name="-"
    fi

    printf "%-24s %-10s %-18s\n" "${instance_name}" "${deployed}" "${tenant_name}"
  done

  if [[ "${found}" -eq 0 ]]; then
    echo "No tenant instances found under ${instances_dir}."
  fi
}

cmd_tenant_deploy() {
  local instance="${1:-}"
  local env_name="${2:-dev}"

  if [[ -z "${instance}" ]]; then
    echo "ERROR: usage: kubectl gentian tenants deploy <instance> [--env <env>]" >&2
    exit 1
  fi

  ensure_repo
  ensure_env_layout "${env_name}"
  tenant_instance_dir "${instance}" "${env_name}" >/dev/null

  local kustom_file
  kustom_file="$(tenant_env_kustomization "${env_name}")"

  if is_instance_deployed "${instance}" "${env_name}"; then
    echo "Tenant instance '${instance}' is already deployed in '${env_name}'."
    exit 0
  fi

  append_instance_resource "${kustom_file}" "${instance}"

  (
    cd "${DEPLOYMENTS_PATH}"
    git add "${kustom_file}"
  )
  git_commit_push "feat(${instance}): deploy tenant instance in ${env_name}"

  kubectl apply -k "$(tenant_env_root "${env_name}")"

  echo "Done. Tenant instance '${instance}' deployed in '${env_name}'."
}

cmd_tenant_undeploy() {
  local instance="${1:-}"
  local env_name="${2:-dev}"
  local purge="${3:-false}"

  if [[ -z "${instance}" ]]; then
    echo "ERROR: usage: kubectl gentian tenants undeploy <instance> [--env <env>] [--purge]" >&2
    exit 1
  fi

  ensure_repo
  ensure_env_layout "${env_name}"
  tenant_instance_dir "${instance}" "${env_name}" >/dev/null

  local kustom_file
  local patch
  local tenant_name

  kustom_file="$(tenant_env_kustomization "${env_name}")"
  patch="$(tenant_instance_patch_file "${instance}" "${env_name}")"
  tenant_name="$(tenant_instance_name_from_patch "${patch}")"
  if [[ -z "${tenant_name}" ]]; then
    tenant_name="${instance}"
  fi

  if [[ "${purge}" == "true" ]]; then
    if grep -q '^  deletionPolicy: Delete$' "${patch}"; then
      echo "Tenant instance '${instance}' already configured with deletionPolicy: Delete."
    else
      set_tenant_deletion_policy "${patch}" "Delete"
      (
        cd "${DEPLOYMENTS_PATH}"
        git add "${patch}"
      )
      git_commit_push "feat(${instance}): enable destructive tenant deletion"
      kubectl apply -f "${patch}"
    fi
  fi

  if ! is_instance_deployed "${instance}" "${env_name}"; then
    echo "Tenant instance '${instance}' is not deployed in '${env_name}'."
  else
    remove_instance_resource "${kustom_file}" "${instance}"
    (
      cd "${DEPLOYMENTS_PATH}"
      git add "${kustom_file}"
    )
    git_commit_push "feat(${instance}): undeploy tenant instance from ${env_name}"
    kubectl apply -k "$(tenant_env_root "${env_name}")"
  fi

  kubectl delete tenant "${tenant_name}" --ignore-not-found=true

  if [[ "${purge}" == "true" ]]; then
    echo "Done. Tenant instance '${instance}' undeployed with purge behavior in '${env_name}'."
  else
    echo "Done. Tenant instance '${instance}' undeployed in '${env_name}'."
  fi
}

# ---------------------------------------------------------------------------
# apps list
# ---------------------------------------------------------------------------
cmd_list() {
  echo "Available apps from AppCatalogue:"
  echo ""
  kubectl get appcatalogue default -o jsonpath='{range .status.apps[*]}{.name}{"\t"}{.chartVersion}{"\t"}{.installedCount}{"\t"}{range .kernelRequirements[*]}{@}{","}{end}{"\n"}{end}' \
    | awk -F'\t' '
      BEGIN {
        fmt = "%-30s %-12s %-12s %s\n"
        printf fmt, "NAME", "VERSION", "INSTALLED", "REQUIRES"
        printf fmt, "----", "-------", "---------", "--------"
      }
      {
        sub(/,$/, "", $4)
        if ($4 == "") $4 = "-"
        printf fmt, $1, $2, $3 " tenants", $4
      }'
}

# ---------------------------------------------------------------------------
# apps install
# ---------------------------------------------------------------------------
cmd_install() {
  local app="${1:-}"
  local tenant="${2:-}"

  if [[ -z "${app}" || -z "${tenant}" ]]; then
    echo "ERROR: usage: kubectl gentian apps install <app> --tenant <tenant>" >&2
    exit 1
  fi

  ensure_repo

  local file
  file=$(tenant_file "${tenant}")

  # Guard: check AppProfile exists in the cluster before touching Git.
  if ! kubectl get appprofile "${app}" &>/dev/null; then
    echo "ERROR: AppProfile '${app}' not found in the cluster. Is the app catalogue synced?" >&2
    exit 1
  fi

  # Guard: check not already installed.
  if grep -q "profile: ${app}" "${file}"; then
    echo "App '${app}' is already listed in tenant '${tenant}'. Nothing to do."
    exit 0
  fi

  # Inject the entry under spec.apps.
  # The apps: key is always at 2-space indent; entries are "  - profile: <name>".
  # Insert immediately after the "  apps:" line (order within the list is irrelevant).
  if grep -q '^  apps:' "${file}"; then
    sed -i "/^  apps:/a\\  - profile: ${app}" "${file}"
  else
    # No apps key yet — append the block at the end of the file.
    printf '  apps:\n  - profile: %s\n' "${app}" >> "${file}"
  fi
  echo "Added '${app}' to spec.apps."

  # Commit and push.
  (
    cd "${DEPLOYMENTS_PATH}"
    git add "${file}"
  )
  git_commit_push "feat(${tenant}): install ${app}"

  # Apply the updated Tenant CR so the operator reconciles immediately.
  kubectl apply -f "${file}"

  echo "Done. Tenant '${tenant}' updated — operator will provision '${app}'."
}

# ---------------------------------------------------------------------------
# apps uninstall
# ---------------------------------------------------------------------------
cmd_uninstall() {
  local app="${1:-}"
  local tenant="${2:-}"

  if [[ -z "${app}" || -z "${tenant}" ]]; then
    echo "ERROR: usage: kubectl gentian apps uninstall <app> --tenant <tenant>" >&2
    exit 1
  fi

  ensure_repo

  local file
  file=$(tenant_file "${tenant}")

  # Guard: check actually installed.
  if ! grep -q "profile: ${app}" "${file}"; then
    echo "App '${app}' is not listed in tenant '${tenant}'. Nothing to do."
    exit 0
  fi

  # Remove the '- profile: <app>' line from spec.apps using sed.
  sed -i "/^  - profile: ${app}$/d" "${file}"
  echo "Removed '${app}' from spec.apps."

  # Commit and push.
  (
    cd "${DEPLOYMENTS_PATH}"
    git add "${file}"
  )
  git_commit_push "feat(${tenant}): uninstall ${app}"

  # Apply the updated Tenant CR so the operator reconciles immediately.
  kubectl apply -f "${file}"

  echo "Done. Tenant '${tenant}' updated — operator will deprovision '${app}'."
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

SUBCOMMAND="${1:-}"
shift

case "${SUBCOMMAND}" in
  apps)
    APPS_CMD="${1:-}"
    shift || true
    case "${APPS_CMD}" in
      list)
        cmd_list
        ;;
      install|uninstall)
        APP_NAME="${1:-}"
        shift || true
        TENANT_NAME=""
        while [[ $# -gt 0 ]]; do
          case "${1}" in
            --tenant|-t)
              TENANT_NAME="${2:-}"
              shift 2
              ;;
            *)
              echo "ERROR: unknown flag: ${1}" >&2
              exit 1
              ;;
          esac
        done
        if [[ "${APPS_CMD}" == "install" ]]; then
          cmd_install "${APP_NAME}" "${TENANT_NAME}"
        else
          cmd_uninstall "${APP_NAME}" "${TENANT_NAME}"
        fi
        ;;
      *)
        echo "ERROR: unknown apps subcommand: ${APPS_CMD}" >&2
        usage
        exit 1
        ;;
    esac
    ;;
  tenant|tenants)
    TENANT_CMD="${1:-}"
    shift || true
    TENANT_ENV="dev"
    case "${TENANT_CMD}" in
      list)
        while [[ $# -gt 0 ]]; do
          case "${1}" in
            --env|-e)
              TENANT_ENV="${2:-}"
              shift 2
              ;;
            *)
              echo "ERROR: unknown flag: ${1}" >&2
              exit 1
              ;;
          esac
        done
        cmd_tenant_list "${TENANT_ENV}"
        ;;
      deploy)
        TENANT_INSTANCE="${1:-}"
        shift || true
        while [[ $# -gt 0 ]]; do
          case "${1}" in
            --env|-e)
              TENANT_ENV="${2:-}"
              shift 2
              ;;
            *)
              echo "ERROR: unknown flag: ${1}" >&2
              exit 1
              ;;
          esac
        done
        cmd_tenant_deploy "${TENANT_INSTANCE}" "${TENANT_ENV}"
        ;;
      undeploy)
        TENANT_INSTANCE="${1:-}"
        shift || true
        PURGE=false
        while [[ $# -gt 0 ]]; do
          case "${1}" in
            --env|-e)
              TENANT_ENV="${2:-}"
              shift 2
              ;;
            --purge)
              PURGE=true
              shift
              ;;
            *)
              echo "ERROR: unknown flag: ${1}" >&2
              exit 1
              ;;
          esac
        done
        cmd_tenant_undeploy "${TENANT_INSTANCE}" "${TENANT_ENV}" "${PURGE}"
        ;;
      *)
        echo "ERROR: unknown tenants subcommand: ${TENANT_CMD}" >&2
        usage
        exit 1
        ;;
    esac
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    echo "ERROR: unknown subcommand: ${SUBCOMMAND}" >&2
    usage
    exit 1
    ;;
esac
