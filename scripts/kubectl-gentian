#!/usr/bin/env bash
# kubectl-gentian — the command-line console for Gentian OS.
#
# A client of the director, like the admin console: every command signs in as
# the person running it and asks the director, which checks that person
# against the authorization graph, commits to git in their name, and records
# who asked. The one command about a person -- activating a tenant's
# administrator -- asks the registrar, which makes the same check and acts on
# the identity provider. Nothing here writes to git, reads OpenBao or applies
# manifests itself -- a tool that did would be a way around every check those
# two make.
#
# Usage:
#   kubectl gentian login                       sign in (a code to confirm in a browser)
#   kubectl gentian logout
#   kubectl gentian whoami
#
#   kubectl gentian tenants list
#   kubectl gentian tenants show <name>
#   kubectl gentian tenants create <name> [--display-name <text>] [--no-mfa] [--admins-add-catalogues]
#                                  [--self-sign-up]
#                                  [--country <ISO 3166-1 alpha-2, e.g. CH>]
#                                  (sign-up is off, and is said out loud when it is on:
#                                  anybody may make an account)
#   kubectl gentian tenants set <name> [--admins-add-catalogues=true|false]
#                                      [--country <alpha-2> | --country ""]   "" names none
#   kubectl gentian tenants activate-admin <name> [--recovery-email <address>]
#   kubectl gentian tenants retire <name> [--purge [--keep-bundles]] [--yes]
#   kubectl gentian tenants import <file.gentian> [--identity-file <f> | --passphrase] [--drop-custom-domain]
#   kubectl gentian tenants import --bucket <b> --prefix <p> [--endpoint <url> [--addressing-style path|virtualHost]]
#                                  (--identity-file <f> | --passphrase) [--drop-custom-domain]
#                                  (the bundle's custom domain is kept unless --drop-custom-domain)
#   kubectl gentian tenants delegate-catalogues <name> on|off
#   kubectl gentian tenants domain <name>                      the domain of its own it is bound to
#   kubectl gentian tenants domain <name> <domain> [--yes]     bind it: its addresses move to <label>.<domain>
#                                                             (a cluster with many tenants only)
#   kubectl gentian tenants domain <name> --remove [--yes]     back to its default address
#   kubectl gentian tenants mail-mode <name> [<mode>]          what the operator provisions for its mail:
#                                                             selfhosted, external, transport-only, disabled
#   kubectl gentian tenants groups <name> [<group>... | --clear]   its own groups, declared in git
#   kubectl gentian tenants sign-in <name> [--from <tenant> --groups <g>,... | --remove <tenant>]
#                                                             people of another tenant of this cluster signing in here
#   kubectl gentian tenants partners <name>                    realms of other clusters its realm links accounts with
#   kubectl gentian tenants partners <name> add <partner> --issuer <https://<host>/<path to the realm>>
#                                  [--issue] [--accept link|create|organization [--domain <d>] [--display-name <text>]]
#                                  [--as <name the partner gives this realm>]
#   kubectl gentian tenants partners <name> remove <partner>
#   kubectl gentian tenants platform-access <name> [on|off]    whether the platform's administrators may sign in
#                                                             to the tenant as its administrators (the tenant's switch)
#
#   kubectl gentian platform-roles holders                     who holds which cluster role by name, as the claim declares
#   kubectl gentian platform-roles holders add <role> <tenant> <login> --reason <why> [--expires <RFC 3339>] [--scope tenant:<t>]
#                                                             a person of the platform tenant, or an administrator
#                                                             of another, holds it: one commit
#   kubectl gentian platform-roles holders remove <role> <tenant> <login>   no longer
#   kubectl gentian platform-roles candidates                  who could hold one: the platform tenant's people,
#                                                             every other tenant's administrators
#   kubectl gentian platform-roles members                     who holds admin and breakGlass through their group
#
#   kubectl gentian credentials list [--tenant <tenant>]       what is asked for, and whether it is set
#   kubectl gentian credentials set <name> --field <key>=@<file> [--field <key>=-]
#                                                             set one; a value from a file, or from stdin (once)
#
#   kubectl gentian catalogues list [--tenant <tenant>]
#   kubectl gentian catalogues add <name> <https-url> [--tenant <tenant>]
#   kubectl gentian catalogues add <name> --oci <artifact> --repository <repository> [--tenant <tenant>]
#                                  a catalog kept as an OCI artifact, read with the credential of a
#                                  repository declared for the tenant (or, without --tenant, for the cluster)
#   kubectl gentian catalogues remove <name> [--tenant <tenant>]
#   kubectl gentian catalogues rename <old> <new> [--tenant <tenant>]
#                                  the same catalog under another name: what was installed from
#                                  it follows, in the same commit, and no build moves
#   kubectl gentian catalogues residue
#   kubectl gentian catalogues residue remove <kind>/<name> [--namespace <ns>] [--yes]
#
#   kubectl gentian repositories declare <name> --tenant <tenant> --url oci://<host>/<path> [--type oci]
#                                  a private registry a tenant pulls charts and images from;
#                                  the token is set in the Admin Console under Credentials
#   kubectl gentian repositories remove <name> --tenant <tenant>
#
#   kubectl gentian models list                  the models the gateway offers, and what the claim says of each
#   kubectl gentian models show                  the Cluster claim's model settings, as JSON
#   kubectl gentian models set -f <file.json>    make the claim declare exactly these settings
#                                                (no provider's token: that is a credential)
#
#   kubectl gentian settings show                the Cluster claim's settings, as JSON
#   kubectl gentian settings set <path>=<value> [...]   change them, in one commit: tenancyMode=multi,
#                                                mainAddress.tenant=<tenant>, mail.serviceMode=system,
#                                                platformRoles.auditor=gentian:platform:auditor ...
#
#   kubectl gentian apps list --tenant <tenant> [--available]
#   kubectl gentian apps install <app> --tenant <tenant> [--from <source>] [--digest sha256:<hex>] [--for-everyone]
#   kubectl gentian apps uninstall <app> --tenant <tenant> [--purge]
#   kubectl gentian apps approve <app> --tenant <tenant>       what the app asks for that nobody has approved yet
#   kubectl gentian apps approve <app> <kind>/<name> --tenant <tenant> --reason "<why>" [--expires <RFC 3339>]
#                                                             approve one request: egress (the tenant's perimeter approver),
#                                                             podSecurity or clusterRoles (the cluster's security officer)
#   kubectl gentian apps decline <app> <kind>/<name> --tenant <tenant> --reason "<why>"
#                                                             decline one, with the same right; the app keeps waiting
#   kubectl gentian approvals list                             what awaits the security officer and the perimeter
#                                                             approver, across all tenants: who answers, who asked,
#                                                             when, why the app wants it, and what was declined
#   kubectl gentian approvals granted                          every tenant's approved privilege exceptions
#
#   kubectl gentian exposures requests --tenant <tenant>        what its apps ask to have on the internet, or to keep
#                                                               of their own Authorization header behind sign-in
#   kubectl gentian exposures approve <app-instance> <entry> --tenant <tenant> [--expires <date>] [--reason <text>]
#                                     [--acknowledge-main-address-rule] [--yes]
#   kubectl gentian exposures list --tenant <tenant>            what the tenant has on the internet
#   kubectl gentian exposures withdraw <app-instance> <entry> --tenant <tenant>
#   kubectl gentian exposures alias <app-instance> <entry> --tenant <tenant> (--host <name>.<cluster's domain> | --remove)
#                                                               a second address for a published entry, directly under
#                                                               the cluster's own domain; the cluster's administrator's
#
#   kubectl gentian resources plans --tenant <tenant>
#   kubectl gentian resources show --tenant <tenant>
#   kubectl gentian resources set --tenant <tenant> --plan <plan>
#   kubectl gentian resources report --tenant <tenant> --from <time> --to <time>
#
#   kubectl gentian version
#
# Which cluster is the current kubectl context's. The director is found there
# (the Deployment labeled app.kubernetes.io/component=director) and reached
# through a port-forward for the length of one command; its own settings say
# which identity provider to sign in with and which cluster it serves. The
# registrar is found the same way, beside it, and the usher -- which answers
# what the cluster holds of a tenant right now -- by its own label.

set -euo pipefail

GENTIAN_PLUGIN_VERSION="0.5.0"
# Written into the installed copy by `make install-plugin`: the checkout it was
# installed from, and that checkout's commit. Empty in the checkout itself,
# which is then never told it is out of date.
GENTIAN_PLUGIN_SOURCE=""
GENTIAN_PLUGIN_COMMIT=""

die() {
    echo "error: $*" >&2
    exit 1
}

need() {
    local c
    for c in "$@"; do
        command -v "${c}" >/dev/null 2>&1 || die "${c} is required"
    done
}

# gentian_plugin_fingerprint — sha256 of this file, short form, or "unknown".
#
# BASH_SOURCE[0] rather than $0, so it fingerprints the plugin itself when it is
# invoked through the gtnctl symlink or as `kubectl gentian`.
gentian_plugin_fingerprint() {
    local self="${BASH_SOURCE[0]}"
    local sum=""
    if command -v sha256sum >/dev/null 2>&1; then
        sum="$(sha256sum "${self}" 2>/dev/null | cut -c1-12)"
    elif command -v shasum >/dev/null 2>&1; then
        sum="$(shasum -a 256 "${self}" 2>/dev/null | cut -c1-12)"
    fi
    echo "${sum:-unknown}"
}

cmd_version() {
    echo "kubectl-gentian ${GENTIAN_PLUGIN_VERSION}"
    echo "  fingerprint : $(gentian_plugin_fingerprint)"
    echo "  path        : ${BASH_SOURCE[0]}"
    [[ -z "${GENTIAN_PLUGIN_SOURCE}" ]] ||
        echo "  installed   : from ${GENTIAN_PLUGIN_SOURCE} at ${GENTIAN_PLUGIN_COMMIT:-an unknown commit}"
}

# ---------------------------------------------------------------------------
# The director: where it is, and what it says about itself
# ---------------------------------------------------------------------------

_DIR_NS=""
_DIR_DEPLOY=""
_ISSUER=""
_CLUSTER=""
_KERNEL_DOMAIN=""

_discover() {
    [[ -n "${_DIR_NS}" ]] && return 0
    local line
    line="$(kubectl get deploy -A -l app.kubernetes.io/component=director \
        -o jsonpath='{range .items[*]}{.metadata.namespace} {.metadata.name}{"\n"}{end}' 2>/dev/null | head -1)"
    [[ -n "${line}" ]] || die "no director in the current kubectl context ($(kubectl config current-context 2>/dev/null || echo none))"
    _DIR_NS="${line%% *}"
    _DIR_DEPLOY="${line#* }"
    local env
    env="$(kubectl get deploy "${_DIR_DEPLOY}" -n "${_DIR_NS}" -o json)"
    local base
    base="$(printf '%s' "${env}" | jq -r '.spec.template.spec.containers[0].env[] | select(.name=="DIRECTOR_ISSUER_BASE_URL") | .value')"
    _CLUSTER="$(printf '%s' "${env}" | jq -r '.spec.template.spec.containers[0].env[] | select(.name=="GENTIAN_DEPLOYMENTS_CLUSTER_ID") | .value')"
    [[ -n "${base}" && -n "${_CLUSTER}" ]] || die "the director in ${_DIR_NS} does not say which issuer or cluster it serves"
    # The platform's administrators sign in through the kernel realm.
    _ISSUER="${base%/}/realms/${GENTIAN_REALM:-kernel}"
    # The cluster's domain, off the issuer's host (id.<kernel domain>), for
    # the sign-in addresses some commands print; empty when it is not that.
    _KERNEL_DOMAIN="${base#*://}"
    _KERNEL_DOMAIN="${_KERNEL_DOMAIN%%/*}"
    [[ "${_KERNEL_DOMAIN}" == id.* ]] && _KERNEL_DOMAIN="${_KERNEL_DOMAIN#id.}" || _KERNEL_DOMAIN=""
    _check_freshness "$(printf '%s' "${env}" | jq -r '.spec.template.spec.containers[0].image // ""')"
}

# gentian_plugin_body <file> — a copy of this plugin without the two lines
# install-plugin writes, so an installed copy and its checkout's compare equal
# when nothing else differs.
gentian_plugin_body() {
    grep -v '^GENTIAN_PLUGIN_\(SOURCE\|COMMIT\)=' "$1" 2>/dev/null
}

# _check_freshness <image> — say, once an hour per cluster and on stderr,
# when this copy is out of date, and the command that updates it:
#   - its checkout has a different copy now (it was pulled, or switched);
#   - the cluster runs a build whose commit the checkout has and that is
#     newer than the one this copy came from.
# Says nothing for a copy run from a checkout, and nothing it cannot tell.
# GENTIAN_SKIP_UPDATE_CHECK=1 turns it off.
_check_freshness() {
    local image="$1" src="${GENTIAN_PLUGIN_SOURCE}" stamp tag sha
    [[ -n "${src}" && "${GENTIAN_SKIP_UPDATE_CHECK:-}" != "1" ]] || return 0
    stamp="${HOME}/.gentian/cli-check-${_CLUSTER:-default}"
    if [[ -f "${stamp}" ]] && [[ -n "$(find "${stamp}" -mmin -60 2>/dev/null)" ]]; then
        return 0
    fi
    mkdir -p "${HOME}/.gentian" 2>/dev/null && touch "${stamp}" 2>/dev/null
    if [[ -r "${src}/scripts/kubectl-gentian" ]] &&
        ! cmp -s <(gentian_plugin_body "${src}/scripts/kubectl-gentian") <(gentian_plugin_body "${BASH_SOURCE[0]}"); then
        echo "note: kubectl gentian is not the copy in ${src} any more. Update it:" >&2
        echo "  make -C ${src} install-plugin" >&2
        return 0
    fi
    tag="${image##*:}"
    sha="${tag##*-}"
    [[ "${sha}" =~ ^[0-9a-f]{7,40}$ && -n "${GENTIAN_PLUGIN_COMMIT}" ]] || return 0
    [[ "${GENTIAN_PLUGIN_COMMIT}" == "${sha}"* ]] && return 0
    command -v git >/dev/null 2>&1 || return 0
    if ! git -C "${src}" cat-file -e "${sha}^{commit}" 2>/dev/null; then
        echo "note: the cluster runs build ${tag}, which ${src} does not have; kubectl gentian may be older. Update it:" >&2
        echo "  git -C ${src} fetch && git -C ${src} checkout --detach ${sha} && make -C ${src} install-plugin" >&2
    elif git -C "${src}" merge-base --is-ancestor "${GENTIAN_PLUGIN_COMMIT}" "${sha}" 2>/dev/null; then
        echo "note: kubectl gentian (${GENTIAN_PLUGIN_COMMIT:0:7}) is older than the cluster's build (${tag}). Update it:" >&2
        echo "  git -C ${src} checkout --detach ${sha} && make -C ${src} install-plugin" >&2
    fi
}

_TOKEN_FILE=""

_token_file() {
    _discover
    local dir="${HOME}/.gentian"
    mkdir -p "${dir}"
    chmod 700 "${dir}" 2>/dev/null || true
    _TOKEN_FILE="${dir}/cli-token-${_CLUSTER}.json"
}

# ---------------------------------------------------------------------------
# Signing in: the device flow, so a password is typed into the browser and
# never into this terminal
# ---------------------------------------------------------------------------

cmd_login() {
    need curl jq
    _token_file
    local start device user_code verify interval expires_in deadline answer err
    start="$(curl -sS --max-time 20 -d client_id=gentian-cli -d "scope=openid" \
        "${_ISSUER}/protocol/openid-connect/auth/device")"
    device="$(printf '%s' "${start}" | jq -r '.device_code // empty')"
    [[ -n "${device}" ]] || die "the identity provider started no sign-in: ${start}"
    user_code="$(printf '%s' "${start}" | jq -r '.user_code')"
    verify="$(printf '%s' "${start}" | jq -r '.verification_uri_complete // .verification_uri')"
    interval="$(printf '%s' "${start}" | jq -r '.interval // 5')"
    expires_in="$(printf '%s' "${start}" | jq -r '.expires_in // 600')"
    echo "Open this in a browser and confirm code ${user_code}:"
    echo "  ${verify}"
    deadline=$(( SECONDS + expires_in ))
    while (( SECONDS < deadline )); do
        sleep "${interval}"
        answer="$(curl -sS --max-time 20 -d client_id=gentian-cli \
            -d grant_type=urn:ietf:params:oauth:grant-type:device_code \
            --data-urlencode "device_code=${device}" \
            "${_ISSUER}/protocol/openid-connect/token")"
        err="$(printf '%s' "${answer}" | jq -r '.error // empty')"
        case "${err}" in
            "") _store_token "${answer}"; echo "Signed in."; return 0 ;;
            authorization_pending) continue ;;
            slow_down) interval=$(( interval + 5 )) ;;
            *) die "sign-in refused: $(printf '%s' "${answer}" | jq -r '.error_description // .error')" ;;
        esac
    done
    die "the code expired before it was confirmed"
}

_store_token() {
    local answer="$1" now
    now="$(date +%s)"
    local tmp
    tmp="$(mktemp "${_TOKEN_FILE}.XXXXXX")"
    chmod 600 "${tmp}"
    printf '%s' "${answer}" | jq --argjson now "${now}" \
        '{access_token, refresh_token, expires_at: ($now + (.expires_in // 300)), refresh_expires_at: ($now + (.refresh_expires_in // 1800))}' \
        > "${tmp}"
    mv -f "${tmp}" "${_TOKEN_FILE}"
}

cmd_logout() {
    _token_file
    if [[ -f "${_TOKEN_FILE}" ]]; then
        local refresh
        refresh="$(jq -r '.refresh_token // empty' "${_TOKEN_FILE}")"
        if [[ -n "${refresh}" ]]; then
            curl -sS --max-time 10 -o /dev/null -d client_id=gentian-cli \
                --data-urlencode "refresh_token=${refresh}" "${_ISSUER}/protocol/openid-connect/logout" || true
        fi
        rm -f "${_TOKEN_FILE}"
    fi
    echo "Signed out."
}

# _access_token — a current access token, refreshed when close to expiry.
_access_token() {
    _token_file
    [[ -f "${_TOKEN_FILE}" ]] || die "not signed in: kubectl gentian login"
    local now exp
    now="$(date +%s)"
    exp="$(jq -r '.expires_at // 0' "${_TOKEN_FILE}")"
    if (( exp - 30 > now )); then
        jq -r '.access_token' "${_TOKEN_FILE}"
        return 0
    fi
    local refresh answer
    refresh="$(jq -r '.refresh_token // empty' "${_TOKEN_FILE}")"
    [[ -n "${refresh}" ]] || die "the session has ended: kubectl gentian login"
    answer="$(curl -sS --max-time 20 -d client_id=gentian-cli -d grant_type=refresh_token \
        --data-urlencode "refresh_token=${refresh}" "${_ISSUER}/protocol/openid-connect/token")"
    [[ -n "$(printf '%s' "${answer}" | jq -r '.access_token // empty')" ]] ||
        die "the session has ended: kubectl gentian login"
    _store_token "${answer}"
    jq -r '.access_token' "${_TOKEN_FILE}"
}

# ---------------------------------------------------------------------------
# Calling the director
# ---------------------------------------------------------------------------

_PF_PID=""
_DIR_BASE=""

_connect() {
    [[ -n "${_DIR_BASE}" ]] && return 0
    _discover
    local port
    port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
    kubectl port-forward -n "${_DIR_NS}" "deploy/${_DIR_DEPLOY}" "${port}:8080" >/dev/null 2>&1 &
    _PF_PID=$!
    trap '_disconnect' EXIT
    local _i
    for _i in $(seq 1 30); do
        if curl -s -o /dev/null --max-time 1 "http://127.0.0.1:${port}/healthz"; then
            _DIR_BASE="http://127.0.0.1:${port}"
            return 0
        fi
        kill -0 "${_PF_PID}" 2>/dev/null || break
        sleep 0.5
    done
    die "the director in ${_DIR_NS} could not be reached"
}

_disconnect() {
    if [[ -n "${_PF_PID}" ]]; then
        kill "${_PF_PID}" 2>/dev/null || true
    fi
    if [[ -n "${_REG_PF_PID}" ]]; then
        kill "${_REG_PF_PID}" 2>/dev/null || true
    fi
    if [[ -n "${_USH_PF_PID}" ]]; then
        kill "${_USH_PF_PID}" 2>/dev/null || true
    fi
    if [[ -n "${_CUS_PF_PID}" ]]; then
        kill "${_CUS_PF_PID}" 2>/dev/null || true
    fi
}

# The usher: the Deployment labeled app.kubernetes.io/component=usher, in
# whichever namespace it runs. It answers what the cluster holds of a tenant
# right now; the director answers what git declares.
_USH_PF_PID=""
_USH_BASE=""

_connect_usher() {
    [[ -n "${_USH_BASE}" ]] && return 0
    _discover
    local line ns deploy target port
    line="$(kubectl get deploy -A -l app.kubernetes.io/component=usher \
        -o jsonpath='{range .items[*]}{.metadata.namespace} {.metadata.name}{"\n"}{end}' 2>/dev/null | head -1)"
    [[ -n "${line}" ]] || die "no usher in this cluster: what the cluster holds of a tenant is read there, and this cluster does not run one"
    ns="${line%% *}"
    deploy="${line#* }"
    target="$(kubectl get deploy "${deploy}" -n "${ns}" \
        -o jsonpath='{.spec.template.spec.containers[0].ports[0].containerPort}' 2>/dev/null || true)"
    [[ -n "${target}" ]] || die "the usher in ${ns} names no port"
    port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
    kubectl port-forward -n "${ns}" "deploy/${deploy}" "${port}:${target}" >/dev/null 2>&1 &
    _USH_PF_PID=$!
    trap '_disconnect' EXIT
    local _i
    for _i in $(seq 1 30); do
        if curl -s -o /dev/null --max-time 1 "http://127.0.0.1:${port}/healthz"; then
            _USH_BASE="http://127.0.0.1:${port}"
            return 0
        fi
        kill -0 "${_USH_PF_PID}" 2>/dev/null || break
        sleep 0.5
    done
    die "the usher in ${ns} could not be reached"
}

# The registrar: the Deployment labeled app.kubernetes.io/component=registrar
# in the director's namespace, on the port its Service names.
# The custodian: the Deployment labeled app.kubernetes.io/component=custodian,
# beside the director. Credentials are set there, as the person: it checks
# them against what the requirement declares and writes them to the vault
# with the person's own authority.
_CUS_PF_PID=""
_CUS_BASE=""

_connect_custodian() {
    [[ -n "${_CUS_BASE}" ]] && return 0
    _discover
    local deploy target port
    deploy="$(kubectl get deploy -n "${_DIR_NS}" -l app.kubernetes.io/component=custodian \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
    [[ -n "${deploy}" ]] || die "no custodian in ${_DIR_NS}: credentials are set there, and this cluster does not run one"
    target="$(kubectl get deploy "${deploy}" -n "${_DIR_NS}" \
        -o jsonpath='{.spec.template.spec.containers[0].ports[0].containerPort}' 2>/dev/null || true)"
    [[ -n "${target}" ]] || die "the custodian in ${_DIR_NS} names no port"
    port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
    kubectl port-forward -n "${_DIR_NS}" "deploy/${deploy}" "${port}:${target}" >/dev/null 2>&1 &
    _CUS_PF_PID=$!
    trap '_disconnect' EXIT
    local _i
    for _i in $(seq 1 30); do
        if curl -s -o /dev/null --max-time 1 "http://127.0.0.1:${port}/healthz"; then
            _CUS_BASE="http://127.0.0.1:${port}"
            return 0
        fi
        kill -0 "${_CUS_PF_PID}" 2>/dev/null || break
        sleep 0.5
    done
    die "the custodian in ${_DIR_NS} could not be reached"
}

# _call_custodian <method> <path> [json-body] — the same, of the custodian.
_call_custodian() {
    _connect_custodian
    _ask custodian "${_CUS_BASE}" "$@"
}

_REG_PF_PID=""
_REG_BASE=""

_connect_registrar() {
    [[ -n "${_REG_BASE}" ]] && return 0
    _discover
    local deploy target port
    deploy="$(kubectl get deploy -n "${_DIR_NS}" -l app.kubernetes.io/component=registrar \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
    [[ -n "${deploy}" ]] || die "no registrar in ${_DIR_NS}: people are managed there, and this cluster does not run one"
    target="$(kubectl get deploy "${deploy}" -n "${_DIR_NS}" \
        -o jsonpath='{.spec.template.spec.containers[0].ports[0].containerPort}' 2>/dev/null || true)"
    [[ -n "${target}" ]] || die "the registrar in ${_DIR_NS} names no port"
    port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
    kubectl port-forward -n "${_DIR_NS}" "deploy/${deploy}" "${port}:${target}" >/dev/null 2>&1 &
    _REG_PF_PID=$!
    trap '_disconnect' EXIT
    local _i
    for _i in $(seq 1 30); do
        if curl -s -o /dev/null --max-time 1 "http://127.0.0.1:${port}/healthz"; then
            _REG_BASE="http://127.0.0.1:${port}"
            return 0
        fi
        kill -0 "${_REG_PF_PID}" 2>/dev/null || break
        sleep 0.5
    done
    die "the registrar in ${_DIR_NS} could not be reached"
}

# _call <method> <path> [json-body] — the director's answer on stdout; a
# refusal is printed as the director worded it and ends the command.
_call() {
    _connect
    _ask director "${_DIR_BASE}" "$@"
}

# _call_registrar <method> <path> [json-body] — the same, of the registrar.
_call_registrar() {
    _connect_registrar
    _ask registrar "${_REG_BASE}" "$@"
}

# _call_usher <method> <path> — a read of live state, of the usher.
_call_usher() {
    _connect_usher
    _ask usher "${_USH_BASE}" "$@"
}

# _ask <who> <base-url> <method> <path> [json-body]
_ask() {
    local who="$1" base="$2" method="$3" path="$4" body="${5:-}" token out status
    need curl jq python3
    # || exit: _access_token says "not signed in" and exits, but inside $( )
    # that ends only the subshell. The request then went out with no token,
    # and one cause was reported as two errors, the second a 401.
    token="$(_access_token)" || exit 1
    out="$(mktemp)"
    if [[ -n "${body}" ]]; then
        status="$(curl -sS -o "${out}" -w '%{http_code}' -X "${method}" \
            -H "Authorization: Bearer ${token}" -H "Content-Type: application/json" \
            -d "${body}" "${base}${path}")"
    else
        status="$(curl -sS -o "${out}" -w '%{http_code}' -X "${method}" \
            -H "Authorization: Bearer ${token}" "${base}${path}")"
    fi
    if [[ "${status}" -ge 300 ]]; then
        local msg
        msg="$(jq -r '.error // .message // .detail // empty' "${out}" 2>/dev/null || true)"
        rm -f "${out}"
        die "the ${who} answered ${status}: ${msg:-no detail}"
    fi
    cat "${out}"
    rm -f "${out}"
}

# _try <method> <path> [json-body] — ask the director and do not end the
# command on a refusal: the status is left in _TRY_STATUS and the answer, or
# the refusal as the director worded it, in _TRY_ANSWER. For the one place a
# refusal is an answer: a command that two routes serve, by who is asking.
_TRY_STATUS=""
_TRY_ANSWER=""

_try() {
    local method="$1" path="$2" body="${3:-}" token out
    need curl jq
    _connect
    token="$(_access_token)"
    out="$(mktemp)"
    if [[ -n "${body}" ]]; then
        _TRY_STATUS="$(curl -sS -o "${out}" -w '%{http_code}' -X "${method}" \
            -H "Authorization: Bearer ${token}" -H "Content-Type: application/json" \
            -d "${body}" "${_DIR_BASE}${path}")"
    else
        _TRY_STATUS="$(curl -sS -o "${out}" -w '%{http_code}' -X "${method}" \
            -H "Authorization: Bearer ${token}" "${_DIR_BASE}${path}")"
    fi
    if [[ "${_TRY_STATUS}" -ge 300 ]]; then
        _TRY_ANSWER="$(jq -r '.error // .message // .detail // empty' "${out}" 2>/dev/null || true)"
    else
        _TRY_ANSWER="$(cat "${out}")"
    fi
    rm -f "${out}"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_whoami() {
    _discover
    _call GET "/v1/clusters/${_CLUSTER}/me" | jq .
}

cmd_tenants_list() {
    _discover
    _call GET "/v1/clusters/${_CLUSTER}/tenants" |
        jq -r '(["TENANT","NAME","APPS","STATE","ADMINS-ADD-CATALOGUES"] | @tsv), (.tenants[] | [.name, (.displayName // .name), ((.apps // []) | length | tostring), (if .purging then "purging" elif .protected then "protected" else "-" end), (if .cataloguesDelegated then "yes" else "no" end)] | @tsv)' |
        column -t -s $'\t'
}

# tenants show: one tenant as git declares it, with what only the cluster's
# administrator decides about it.
cmd_tenants_show() {
    local name="${1:-}" entry
    [[ -n "${name}" && $# -eq 1 ]] || die "usage: kubectl gentian tenants show <name>"
    _label "The tenant" "${name}"
    _discover
    local tenants
    tenants="$(_call GET "/v1/clusters/${_CLUSTER}/tenants")" || exit 1
    entry="$(jq -c --arg n "${name}" '.tenants[] | select(.name == $n)' <<<"${tenants}")"
    [[ -n "${entry}" ]] || die "this cluster has no tenant ${name}"
    printf '%s' "${entry}" | jq -r '
        "Tenant:          \(.name)",
        "Name:            \(.displayName // .name)",
        "Apps:            \((.apps // []) | if length == 0 then "none" else join(", ") end)",
        "Signs in under:  \(.loginDomain // "-")",
        "Own domain:      \(.customDomain // "none")",
        "Country:         \(.country // "none")",
        "State:           \(if .purging then "purging" elif .protected then "protected" else "-" end)",
        "",
        "Its administrators may add catalogues:            \(if .cataloguesDelegated then "yes" else "no" end)",
        "Anybody may sign up (chosen when it was made):    \(if .signUp then "yes" else "no" end)"'
    echo ""
    echo "Its public addresses and egress are approved by its perimeter approver and by the"
    echo "cluster's administrator while the tenant is operated by its cluster:"
    echo "  kubectl gentian platform-roles holders add perimeterApprover ${name} <login> --reason <why>"
}

cmd_tenants_create() {
    local name="" display="" mfa="true" catalogues="false" signup="false" country="" answer
    local usage_text="usage: kubectl gentian tenants create <name> [--display-name <text>] [--no-mfa] [--admins-add-catalogues] [--self-sign-up] [--country <alpha-2>]"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --display-name) display="${2:?}"; shift 2 ;;
            --no-mfa) mfa="false"; shift ;;
            --admins-add-catalogues) catalogues="true"; shift ;;
            --self-sign-up) signup="true"; shift ;;
            # The country the tenant is in, ISO 3166-1 alpha-2 (CH, DE).
            --country) country="${2:?--country <alpha-2>}"; shift 2 ;;
            -*) die "unknown option $1" ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "${usage_text}"
    country="$(_country "${country}")" || exit 1
    _discover
    # Said before anything is committed, because it is the one switch here
    # that opens the cluster to people nobody invited.
    if [[ "${signup}" == "true" ]]; then
        echo "WARNING: --self-sign-up lets anybody on the internet make an account in this tenant's" >&2
        echo "  realm, on a registration page at the cluster's identity provider. Such an account" >&2
        echo "  is in none of the tenant's groups: no desktop, no rights on the platform, not" >&2
        echo "  counted as a user of the tenant. The address is confirmed by a message to it and" >&2
        echo "  the page carries a proof-of-work check; the tenant's mail is transport-only so the" >&2
        echo "  realm can send. For a tenant whose apps serve the public; not for a workspace." >&2
    fi
    answer="$(_call POST "/v1/clusters/${_CLUSTER}/tenants" \
        "$(jq -n --arg n "${name}" --arg d "${display}" --argjson m "${mfa}" --argjson c "${catalogues}" --argjson s "${signup}" --arg k "${country}" \
            '{name:$n, displayName:$d, requireMFA:$m}
             + (if $c then {catalogue:{delegated:true}} else {} end)
             + (if $s then {signUp:true} else {} end)
             + (if $k != "" then {country:$k} else {} end)')")" || exit 1
    echo "Tenant ${name} committed; the platform is provisioning it."
    if [[ "${catalogues}" == "true" ]]; then
        echo "Its administrators may add catalogs for their tenant."
    fi
    if [[ "${signup}" == "true" ]]; then
        echo "Anybody may sign up to it; an account made that way is a member of nothing."
    fi
    if [[ -n "${country}" ]]; then
        echo "Its country: ${country}."
    fi
    echo "When it is ready, hand the administrator account over:"
    echo "  kubectl gentian tenants activate-admin ${name} [--recovery-email <address>]"
}

# The administrator account has no password: its holder sets one through a
# single-use link, mailed to a recovery address or shown here, once.
cmd_tenants_activate_admin() {
    local name="" email="" wait_secs=600
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --recovery-email) email="${2:?}"; shift 2 ;;
            --wait) wait_secs="${2:?}"; shift 2 ;;
            -*) die "unknown option $1" ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "usage: kubectl gentian tenants activate-admin <name> [--recovery-email <address>]"
    _discover
    # Declared at all? The director knows, from git. The registrar reads the
    # cluster, where a tenant just created has not arrived yet -- so without
    # this a mistyped name would be waited for like a new tenant.
    # Asked first and looked through second: piped straight into jq, a call
    # that failed -- not signed in, say -- left jq nothing to find, and the
    # failure was reported again as "no tenant named ...".
    local declared
    declared="$(_call GET "/v1/clusters/${_CLUSTER}/tenants")" || exit 1
    jq -e --arg n "${name}" '.tenants[]? | select(.name == $n)' >/dev/null <<<"${declared}" ||
        die "no tenant named ${name}"
    local body answer deadline
    body="$(jq -n --arg e "${email}" 'if $e == "" then {} else {recoveryEmail:$e} end')"
    # A tenant just created is still being provisioned; its realm and account
    # appear within minutes. Waited for here rather than reported as a failure.
    deadline=$(( SECONDS + wait_secs ))
    while :; do
        if answer="$( (_call_registrar POST "/v1/clusters/${_CLUSTER}/tenants/${name}/actions/activate-admin" "${body}") 2>&1)"; then
            break
        fi
        if [[ "${answer}" == *"still being provisioned"* || "${answer}" == *"tenant not found"* ]] && (( SECONDS < deadline )); then
            echo "  waiting for ${name} to be provisioned…" >&2
            sleep 15
            continue
        fi
        # The platform's own administrators are not the registrar's to change:
        # it refuses a link for one of them as it refuses everything else
        # about them. That account is handed over by the installer.
        if [[ "${answer}" == *"administers the platform"* ]]; then
            die "${answer#error: } For the platform admin's account, run ./install.sh --activate-admin on the install host."
        fi
        die "${answer#error: }"
    done
    local user mailed to link expires
    user="$(printf '%s' "${answer}" | jq -r '.username')"
    mailed="$(printf '%s' "${answer}" | jq -r '.activation.mailed')"
    if [[ "${mailed}" == "true" ]]; then
        to="$(printf '%s' "${answer}" | jq -r '.activation.email')"
        echo "Activation link for ${user} mailed to ${to}."
        return 0
    fi
    local why
    why="$(printf '%s' "${answer}" | jq -r '.activation.mailError // empty')"
    [[ -z "${why}" ]] || echo "Not mailed: ${why}. $(printf '%s' "${answer}" | jq -r '.activation.email') is kept as the recovery address." >&2
    link="$(printf '%s' "${answer}" | jq -r '.activation.link')"
    expires="$(printf '%s' "${answer}" | jq -r '.activation.expiresAt')"
    echo "Activate ${user} — open this once; it works one time:"
    echo "  ${link}"
    echo "Valid until $(date -d "@${expires}" 2>/dev/null || date -r "${expires}" 2>/dev/null || echo "${expires}")."
}

# Retire keeps the tenant's data (its manifest's deletionPolicy, Retain by
# default); --purge deletes it. Either asks for the name typed out, as the
# console does, unless --yes says the caller already has.
cmd_tenants_retire() {
    local name="" purge="" keep="" yes="" typed=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --purge) purge=1; shift ;;
            --keep-bundles) keep=1; shift ;;
            --yes) yes=1; shift ;;
            -*) die "unknown flag $1" ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "usage: kubectl gentian tenants retire <name> [--purge [--keep-bundles]] [--yes]"
    [[ -z "${keep}" || -n "${purge}" ]] || die "--keep-bundles goes with --purge; retire keeps everything"
    if [[ -z "${yes}" ]]; then
        [[ -t 0 ]] || die "not a terminal: confirm with --yes"
        if [[ -n "${purge}" ]]; then
            echo "Purging ${name} deletes its realm and every account in it, its databases,"
            echo "files, mail and secrets. This cannot be undone."
            if [[ -n "${keep}" ]]; then
                echo "Its backup bucket and the bundles in it are kept."
            else
                echo "Its backup bucket goes too (--keep-bundles keeps it)."
            fi
        else
            echo "Retiring ${name} takes it off the cluster and keeps its data."
        fi
        read -r -p "Type ${name} to confirm: " typed
        [[ "${typed}" == "${name}" ]] || die "not confirmed; nothing was changed"
    fi
    _discover
    if [[ -n "${purge}" ]]; then
        local body="{}"
        [[ -z "${keep}" ]] || body='{"keepBundles":true}'
        _call POST "/v1/clusters/${_CLUSTER}/tenants/${name}/actions/purge" "${body}" >/dev/null
        echo "Purge of ${name} requested: its data is set to be deleted, and the tenant"
        echo "is removed once the cluster has taken that in. 'tenants list' shows it as purging until then."
        return 0
    fi
    answer="$(_call DELETE "/v1/clusters/${_CLUSTER}/tenants/${name}")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "orphan-removed" ]]; then
        # Git had no such tenant, but the cluster still ran it (a sync that
        # finished after the directory was removed); the director had the
        # operator delete it.
        printf '%s' "${answer}" | jq -r '.detail'
        return 0
    fi
    echo "Tenant ${name} retired: git no longer describes it. Its data follows its deletionPolicy."
}

# Import a bundle: upload it, have the director declare the tenant from its
# manifest and restore into it, and follow the import to its end. The key
# never travels as an argument: an identity comes from a file, a passphrase
# from a prompt. A custom domain the bundle's tenant had is declared again
# with it unless --drop-custom-domain says not to.
cmd_tenants_import() {
    local file="" idfile="" ask_pw="" name="" identity="" passphrase="" dec body answer bundle st phase msg last=""
    local bucket="" prefix="" endpoint="" style="" keep=true domain=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --identity-file) idfile="${2:?}"; shift 2 ;;
            --passphrase) ask_pw=1; shift ;;
            --bucket) bucket="${2:?}"; shift 2 ;;
            --prefix) prefix="${2:?}"; shift 2 ;;
            --endpoint) endpoint="${2:?}"; shift 2 ;;
            --addressing-style) style="${2:?}"; shift 2 ;;
            --drop-custom-domain) keep=false; shift ;;
            -*) die "unknown flag $1" ;;
            *) file="$1"; shift ;;
        esac
    done
    if [[ -z "${file}" && -z "${bucket}" ]]; then
        die "usage: kubectl gentian tenants import <file.gentian> | --bucket <b> --prefix <p> [--endpoint <url> [--addressing-style path|virtualHost]]  (--identity-file <f> | --passphrase) [--drop-custom-domain]"
    fi
    case "${style}" in
        ""|path|virtualHost) ;;
        *) die "--addressing-style is path or virtualHost" ;;
    esac
    [[ -z "${style}" || -n "${endpoint}" ]] || die "--addressing-style goes with --endpoint"
    [[ -z "${file}" || -f "${file}" ]] || die "no such file: ${file}"
    [[ -z "${bucket}" || -n "${prefix}" ]] || die "--bucket needs --prefix"
    if [[ -n "${idfile}" ]]; then
        identity="$(grep -v '^#' "${idfile}")"
        dec="$(jq -n --arg i "${identity}" '{identity:$i}')"
    elif [[ -n "${ask_pw}" ]]; then
        [[ -t 0 ]] || die "--passphrase needs a terminal"
        read -r -s -p "Passphrase: " passphrase; echo
        dec="$(jq -n --arg p "${passphrase}" '{passphrase:$p}')"
    else
        die "say how to open the bundle: --identity-file <f> or --passphrase"
    fi
    _discover
    if [[ -n "${file}" ]]; then
        echo "Uploading $(du -h "${file}" | cut -f1) …" >&2
        answer="$(_upload "/v1/clusters/${_CLUSTER}/bundles" "${file}")" || die "${answer#error: }"
        bundle="$(printf '%s' "${answer}" | jq -c '.bundle')"
    else
        # A bundle still in a bucket the cluster can reach: the platform's
        # own when no endpoint is given, a destination's otherwise, named
        # path-style unless --addressing-style virtualHost says otherwise.
        bundle="$(jq -n --arg b "${bucket}" --arg p "${prefix}" --arg e "${endpoint}" --arg s "${style}" '{bucket:$b, prefix:$p} + (if $e == "" then {} else {endpoint:$e} end) + (if $s == "" then {} else {addressingStyle:$s} end)')"
    fi
    # The tenant's name is the bundle's: an import does not rename.
    body="$(jq -n --argjson b "${bundle}" --argjson d "${dec}" --argjson k "${keep}" '{bundle:$b, decryption:$d, keepCustomDomain:$k}')"
    answer="$(_call POST "/v1/clusters/${_CLUSTER}/tenants/import" "${body}")" || exit 1
    name="$(printf '%s' "${answer}" | jq -r '.tenant')"
    domain="$(printf '%s' "${answer}" | jq -r '.customDomain // ""')"
    echo "Tenant ${name} declared ($(printf '%s' "${answer}" | jq -r '.commit' | cut -c1-8)); the operator provisions it, then the bundle is restored."
    [[ -z "${domain}" ]] ||
        echo "It keeps its custom domain ${domain}: point the DNS of ${domain} and its subdomains at this cluster; the import does not."
    # Apps of the bundle's tenant left out here: the platform's own
    # components of an earlier release. Their data is not restored.
    printf '%s' "${answer}" | jq -r '(.skipped // [])[] | "Skipped app \(.app), its data not restored: \(.reason)"'
    while :; do
        st="$(_call GET "/v1/clusters/${_CLUSTER}/tenants/${name}/import")" || exit 1
        phase="$(printf '%s' "${st}" | jq -r '.phase')"
        msg="$(printf '%s' "${st}" | jq -r '.message // ""')"
        if [[ "${phase}: ${msg}" != "${last}" ]]; then
            echo "  ${phase}: ${msg}" >&2
            last="${phase}: ${msg}"
        fi
        case "${phase}" in
            ready)
                echo "Tenant ${name} imported."
                printf '%s' "${st}" | jq -r '.outsideGuarantee // empty'
                [[ "$(printf '%s' "${st}" | jq -r '.passwordResetRequired')" != "true" ]] ||
                    echo "Members have no credentials yet: send them a password reset from the console, or activate the administrator with 'tenants activate-admin ${name}'."
                return 0 ;;
            failed) die "import failed: ${msg}" ;;
        esac
        sleep 15
    done
}

# _upload <path> <file> — POST a file's bytes as the body.
_upload() {
    local path="$1" file="$2" token out status
    need curl jq
    token="$(_access_token)"
    _connect
    out="$(mktemp)"
    status="$(curl -sS -o "${out}" -w '%{http_code}' -X POST \
        -H "Authorization: Bearer ${token}" -H "Content-Type: application/x-tar" \
        --data-binary "@${file}" "${_DIR_BASE}${path}")"
    if [[ "${status}" -ge 300 ]]; then
        echo "error: $(jq -r '.error // .detail // .' "${out}" 2>/dev/null || cat "${out}")"
        rm -f "${out}"
        return 1
    fi
    cat "${out}"; rm -f "${out}"
}

_tenant_flag() {
    local t=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:?}"; shift 2 ;;
            *) shift ;;
        esac
    done
    [[ -n "${t}" ]] || die "--tenant is required"
    echo "${t}"
}

# _apps_offers <tenant> — what the catalogues a tenant sees offer -- the
# cluster's and the tenant's own -- as one JSON document: {sources:
# [<name>…], unread: [<name>…], entries: [{source, name, version, edition,
# digest}…]}. The director answers it from each catalog's index; one it
# could not read is named in unread and the rest are still listed. A tenant
# with no catalog at all answers no sources.
_apps_offers() {
    local t="$1" answer names name listing entries="[]" unread="[]"
    if ! answer="$( (_call GET "/v1/tenants/${t}/catalogues") 2>&1)"; then
        die "${answer#error: }"
    fi
    names="$(printf '%s' "${answer}" | jq -r '.catalogues[].name')"
    for name in ${names}; do
        if listing="$( (_call GET "/v1/tenants/${t}/catalogues/${name}/entries") 2>/dev/null)"; then
            entries="$(jq -n --argjson have "${entries}" --argjson got "${listing}" --arg s "${name}" \
                '$have + [$got.entries[] | {source: $s, name, version: (.version // ""), edition: (.edition // ""), digest: (.digest // ""), platform: (.platform // ""), unmet: (.unmet // "")}]')"
        else
            unread="$(jq -n --argjson have "${unread}" --arg s "${name}" '$have + [$s]')"
        fi
    done
    jq -n --arg names "${names}" --argjson unread "${unread}" --argjson entries "${entries}" \
        '{sources: ($names | split("\n") | map(select(. != ""))), unread: $unread, entries: $entries}'
}

# apps list: what the tenant has installed; with --available, what the
# catalogues it sees offer -- the cluster's and its own -- and whether the
# tenant has it.
cmd_apps_list() {
    local t available="" a
    t="$(_tenant_flag "$@")"
    for a in "$@"; do
        [[ "${a}" == "--available" ]] && available=1
    done
    if [[ -z "${available}" ]]; then
        _call GET "/v1/tenants/${t}/apps" |
            jq -r '(["APP","FOR","ADDONS"] | @tsv), (.apps[] | [.profile, (if .defaultGrant then "everyone" else "-" end), ((.addons // []) | join(","))] | @tsv)' |
            column -t -s $'\t'
        return 0
    fi
    need jq
    _connect
    local offers installed
    offers="$(_apps_offers "${t}")" || exit 1
    [[ "$(printf '%s' "${offers}" | jq -r '.sources | length')" != "0" ]] ||
        die "${t} has no catalogue to install from: the cluster's administrator adds one (kubectl gentian catalogues add <name> <https-url> [--tenant ${t}])"
    installed="$(_call GET "/v1/tenants/${t}/apps")" || exit 1
    # INSTALLED: yes is this build; "other build" is the app at another digest;
    # unpinned is the app installed with no digest. PLATFORM is the floor the
    # build declares (spec.requires.platform); one this cluster does not meet
    # is marked, and the director refuses to install it.
    jq -rn --argjson o "${offers}" --argjson i "${installed}" '
        ($i.apps | map({key: .profile, value: (.digest // "")}) | from_entries) as $have
        | (["SOURCE","APP","VERSION","EDITION","PLATFORM","DIGEST","INSTALLED"] | @tsv),
          ($o.entries[] | .name as $n | .digest as $d | [.source, $n,
              (if .version == "" then "-" else .version end),
              (if .edition == "" then "-" else .edition end),
              (if .platform == "" then "-" elif .unmet != "" then (.platform + " (not met)") else .platform end),
              (if $d == "" then "-" else $d[0:19] end),
              (if ($have | has($n) | not) then "-"
               elif $have[$n] == "" then "unpinned"
               elif $have[$n] == $d then "yes"
               else "other build" end)] | @tsv)' |
        column -t -s $'\t'
    local unread
    unread="$(printf '%s' "${offers}" | jq -r '.unread | join(", ")')"
    [[ -z "${unread}" ]] || echo "Not read, the director could not reach them: ${unread}." >&2
}

# apps install: a pinned build from one of the catalogues the tenant sees.
#
# The entry is looked up in what the director lists of them: the one
# catalog that serves the name, or the one --from names when several do. The
# digest is the one that listing states, unless --digest gives another; either
# way the director fetches the bundle from the source and installs nothing
# unless it hashes to the digest sent.
_apps_install() {
    local app="$1" t="$2" everyone="$3" from="" digest=""
    shift 3
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from) from="${2:?}"; shift 2 ;;
            --digest) digest="${2:?}"; shift 2 ;;
            *) shift ;;
        esac
    done
    need jq
    _connect
    local offers sources serving count version listed
    offers="$(_apps_offers "${t}")" || exit 1
    sources="$(printf '%s' "${offers}" | jq -r '.sources | join(", ")')"
    [[ -n "${sources}" ]] ||
        die "${t} has no catalogue to install ${app} from: the cluster's administrator adds one (kubectl gentian catalogues add <name> <https-url> [--tenant ${t}])"
    if [[ -n "${from}" ]]; then
        printf '%s' "${offers}" | jq -e --arg s "${from}" '.sources | index($s) != null' >/dev/null ||
            die "${t} has no catalogue named ${from}; its catalogues: ${sources}"
    fi
    serving="$(printf '%s' "${offers}" | jq -c --arg a "${app}" --arg s "${from}" \
        '[.entries[] | select(.name == $a and ($s == "" or .source == $s))]')"
    count="$(printf '%s' "${serving}" | jq -r 'length')"
    if [[ "${count}" == "0" ]]; then
        # A source need not publish an index, and one that does lists only
        # what a cluster may list for itself. Named in full -- source and
        # digest -- an entry can still be asked for: the director verifies it.
        [[ -n "${from}" && -n "${digest}" ]] ||
            die "${app} is not listed by ${from:-any catalogue ${t} installs from} (catalogues: ${sources}); 'apps list --tenant ${t} --available' shows what is"
    elif [[ "${count}" != "1" ]]; then
        die "${app} is served by several sources ($(printf '%s' "${serving}" | jq -r 'map(.source) | join(", ")')): say which with --from <source>"
    else
        from="$(printf '%s' "${serving}" | jq -r '.[0].source')"
    fi
    version="$(printf '%s' "${serving}" | jq -r '.[0].version // ""')"
    listed="$(printf '%s' "${serving}" | jq -r '.[0].digest // ""')"
    [[ -n "${digest}" ]] || digest="${listed}"
    [[ -n "${digest}" ]] ||
        die "${from} lists ${app} without a digest, so there is nothing to pin the install to: state the build with --digest sha256:<hex>"
    # The one spelling a manifest carries, so what is printed is what is recorded.
    digest="$(printf '%s' "${digest}" | tr '[:upper:]' '[:lower:]')"
    [[ "${digest}" == sha256:* ]] || digest="sha256:${digest}"
    local body answer status commit message
    body="$(jq -n --arg c "${from}/${app}" --arg d "${digest}" --argjson e "${everyone}" \
        '{coordinate: $c, digest: $d} + (if $e then {defaultGrant: true} else {} end)')"
    answer="$(_call POST "/v1/tenants/${t}/apps/${app}" "${body}")" || exit 1
    status="$(printf '%s' "${answer}" | jq -r '.status // ""')"
    commit="$(printf '%s' "${answer}" | jq -r '.commit // "" | .[0:8]')"
    message="$(printf '%s' "${answer}" | jq -r '.message // ""')"
    echo "Pinned ${from}/${app}  version ${version:--}  ${digest:0:19}"
    case "${status}" in
        already_installed)
            echo "${app} is already installed in ${t} at this build; nothing was committed." ;;
        retried)
            # The pinned build, whose move the platform rolled back or could
            # not start: the director asked for the move once more.
            if [[ -n "${commit}" ]]; then
                echo "${app} in ${t}: ${message}. Committed (${commit}); the platform exports, rolls the build out and verifies it again."
            else
                echo "${app} in ${t}: ${message}. The retry was asked for a moment ago; nothing new was committed."
            fi ;;
        *)
            if [[ "${everyone}" == "true" ]]; then
                echo "Installing ${app} into ${t} for everyone: committed (${commit:-no commit id}); the platform installs it and grants it to every member."
            elif [[ "${status}" == "updated" ]]; then
                echo "Moving ${app} in ${t} to this build: committed (${commit:-no commit id}); the platform rolls it out."
            else
                echo "Installing ${app} into ${t}: committed (${commit:-no commit id}); the platform installs it."
            fi ;;
    esac
}

# _purge_app_when_gone <tenant> <app> — destroy the data of an uninstalled
# app, once the cluster has finished removing the app itself.
#
# The purge is refused with 409 for as long as anything of the app is still
# there: the tenant's manifest on the cluster still names it, its Component
# exists, or Helm has not finished uninstalling its release. So it is asked
# for until it is admitted, for at most GENTIAN_UNINSTALL_WAIT seconds
# (default 900). Once admitted it is one request, answered when it is over;
# anything but success ends the command with the platform's own account of
# what was and was not destroyed.
_purge_app_when_gone() {
    local t="$1" app="$2" wait="${GENTIAN_UNINSTALL_WAIT:-900}"
    local deadline token out status msg body
    need curl jq
    _connect
    deadline=$(( $(date +%s) + wait ))
    out="$(mktemp)"
    body="$(jq -n --arg p "${app}" '{profile:$p}')"
    echo "Purging ${app} from ${t}: waiting for the app to be gone from the cluster first (up to ${wait}s) ..."
    while :; do
        token="$(_access_token)"
        status="$(curl -sS -o "${out}" -w '%{http_code}' -X POST \
            -H "Authorization: Bearer ${token}" -H "Content-Type: application/json" \
            -d "${body}" "${_DIR_BASE}/v1/tenants/${t}/actions/purge-app")"
        [[ "${status}" -lt 300 ]] && break
        msg="$(jq -r '.error // .message // .detail // empty' "${out}" 2>/dev/null || true)"
        if [[ "${status}" != "409" ]]; then
            rm -f "${out}"
            die "the purge of ${app} did not complete (the director answered ${status}): ${msg:-no detail}"
        fi
        # Refused for good, not "not yet": waiting does not bring a profile back.
        if [[ "${msg}" == *"ComponentProfile"* ]]; then
            rm -f "${out}"
            die "the purge of ${app} was refused: ${msg}"
        fi
        if [[ "$(date +%s)" -ge "${deadline}" ]]; then
            rm -f "${out}"
            die "${app} was still not gone from the cluster after ${wait}s, so nothing was purged and its data is retained: ${msg:-no detail}. Run the same command again once it is gone."
        fi
        sleep 10
    done
    echo "Purged ${app} from ${t}: its data is destroyed ($(jq -r '(.destroyed // []) | join(", ")' "${out}")). This cannot be undone."
    rm -f "${out}"
}

# ---------------------------------------------------------------------------
# Catalogues: the addresses apps are installed from
# ---------------------------------------------------------------------------

# _optional_tenant_flag — the --tenant given, or nothing.
_optional_tenant_flag() {
    local t=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:?}"; shift 2 ;;
            *) shift ;;
        esac
    done
    echo "${t}"
}

# Where a catalog is read from, as the lists show it: its https address, the
# artifact it is kept as and the repository it is read with, or the directory
# of the cluster's own deployments repository it is kept in.
_CATALOGUE_WHERE='def where: if .oci then "oci: " + .oci.artifact + " (repository " + .oci.repository + ")" else (.url // "") end;'

# catalogues list: with --tenant, what that tenant installs from -- the
# cluster's catalogues and its own. Without, everything the cluster declares:
# its own catalogues, each tenant's, and which tenants may add their own.
cmd_catalogues_list() {
    local t answer
    t="$(_optional_tenant_flag "$@")"
    need jq
    if [[ -n "${t}" ]]; then
        answer="$(_call GET "/v1/tenants/${t}/catalogues")" || exit 1
        printf '%s' "${answer}" | jq -r "${_CATALOGUE_WHERE}"'
            (["CATALOGUE","FOR","ADDED BY","ADDRESS"] | @tsv),
            (.catalogues[] | [.name, (if .scope == "cluster" then "every tenant" else "this tenant" end),
                (if .addedBy == "tenant" then "the tenant" elif .addedBy == "store" then "the store" else "the cluster" end), where] | @tsv)' |
            column -t -s $'\t'
        if [[ "$(printf '%s' "${answer}" | jq -r '.delegated')" == "true" ]]; then
            echo "The administrators of ${t} may add catalogues of their own."
        else
            echo "The administrators of ${t} may not add catalogues; the cluster's administrator adds them, or delegates it."
        fi
        return 0
    fi
    _discover
    answer="$(_call GET "/v1/clusters/${_CLUSTER}/catalogues")" || exit 1
    printf '%s' "${answer}" | jq -r "${_CATALOGUE_WHERE}"'
        (["CATALOGUE","FOR","ADDED BY","ADDRESS"] | @tsv),
        (.catalogues[] | [.name, "every tenant", (if .addedBy == "store" then "the store" else "the cluster" end), where] | @tsv),
        (.tenants[] | .tenant as $t | .catalogues[] |
            [.name, ("tenant " + $t), (if .addedBy == "tenant" then "the tenant" else "the cluster" end), where] | @tsv)' |
        column -t -s $'\t'
    local delegated
    delegated="$(printf '%s' "${answer}" | jq -r '[.tenants[] | select(.delegated) | .tenant] | join(", ")')"
    if [[ -n "${delegated}" ]]; then
        echo "Tenants whose administrators may add catalogues of their own: ${delegated}."
    else
        echo "No tenant's administrators may add catalogs of their own (tenants delegate-catalogues <tenant> on)."
    fi
}

# catalogues add / remove: for the whole cluster without --tenant, for one
# tenant with it.
#
# A tenant's catalog has two routes, by who is asking. The cluster's
# administrator adds one for the tenant; the tenant's own administrator adds
# one where that is delegated to the tenant. The first is asked, and when the
# director answers that the person may not, the second is: the person is told
# apart by the director, never by this tool.
_catalogues_change() {
    local verb="$1" method="$2" name="$3" t="$4" body="${5:-}" via="the cluster's administrator"
    _discover
    if [[ -z "${t}" ]]; then
        _try "${method}" "/v1/clusters/${_CLUSTER}/catalogues/${name}" "${body}"
    else
        _try "${method}" "/v1/clusters/${_CLUSTER}/tenants/${t}/catalogues/${name}" "${body}"
        if [[ "${_TRY_STATUS}" == "403" ]]; then
            via="the tenant's administrator"
            _try "${method}" "/v1/tenants/${t}/catalogues/${name}" "${body}"
        fi
    fi
    [[ "${_TRY_STATUS}" -lt 300 ]] || die "the director answered ${_TRY_STATUS}: ${_TRY_ANSWER:-no detail}"
    local status commit whose="every tenant of this cluster"
    [[ -z "${t}" ]] || whose="tenant ${t}"
    status="$(printf '%s' "${_TRY_ANSWER}" | jq -r '.status // ""')"
    commit="$(printf '%s' "${_TRY_ANSWER}" | jq -r '.commit // "" | .[0:8]')"
    if [[ "${status}" == "unchanged" ]]; then
        echo "Catalogue ${name} is already there for ${whose}; nothing was committed."
    elif [[ "${verb}" == "add" ]]; then
        echo "Catalogue ${name} added for ${whose}, as ${via}: committed (${commit:-no commit id})."
        if [[ -n "${t}" ]]; then
            echo "  kubectl gentian apps list --tenant ${t} --available"
        else
            echo "  kubectl gentian apps list --tenant <tenant> --available"
        fi
    else
        echo "Catalogue ${name} removed for ${whose}, as ${via}: committed (${commit:-no commit id})."
        echo "What was installed from it stays installed; a new install or a new build needs a catalog that serves it."
    fi
}

# catalogues rename: the catalog under another name, with everything that
# names it -- the source entry, the entries installed from it, the profiles'
# origin -- as one commit of the director. The cluster administrator's route,
# with --tenant as without: a tenant's administrator does not rename.
cmd_catalogues_rename() {
    local old="$1" new="$2" t="$3" body whose="every tenant of this cluster"
    _discover
    body="$(jq -n --arg n "${new}" '{name: $n}')"
    if [[ -z "${t}" ]]; then
        _try POST "/v1/clusters/${_CLUSTER}/catalogues/${old}/actions/rename" "${body}"
    else
        whose="tenant ${t}"
        _try POST "/v1/clusters/${_CLUSTER}/tenants/${t}/catalogues/${old}/actions/rename" "${body}"
    fi
    [[ "${_TRY_STATUS}" -lt 300 ]] || die "the director answered ${_TRY_STATUS}: ${_TRY_ANSWER:-no detail}"
    local status commit
    status="$(printf '%s' "${_TRY_ANSWER}" | jq -r '.status // ""')"
    commit="$(printf '%s' "${_TRY_ANSWER}" | jq -r '.commit // "" | .[0:8]')"
    if [[ "${status}" == "unchanged" ]]; then
        echo "Catalogue ${old} is already named ${new} for ${whose}; nothing was committed."
    else
        echo "Catalogue ${old} renamed to ${new} for ${whose}: committed (${commit:-no commit id})."
        echo "What was installed from it follows: its entries and the profiles' origin now name ${new}; no build moves."
    fi
}

# catalogues residue: what the catalog left on the cluster -- objects a
# profile's bundle once brought and no bundle owns now, and profiles nobody
# uses. Nothing removes them by itself. The list is the usher's, worked out
# by the operator; IN EFFECT says whether an OIDC pack catalog on it is still
# read when a client is configured.
cmd_catalogues_residue_list() {
    local answer
    need jq
    _discover
    answer="$(_call_usher GET "/v1/clusters/${_CLUSTER}/catalogue/residue")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.residue | length')" == "0" ]]; then
        echo "Nothing is left over: every object of a bundle's kinds is owned by a bundle, and every profile is in use."
    else
        printf '%s' "${answer}" | jq -r '
            (["KIND/NAME","NAMESPACE","PROFILE","WHY","CREATED","IN EFFECT"] | @tsv),
            (.residue[] | [
                (.kind + "/" + .name),
                (.namespace // "" | if . == "" then "-" else . end),
                (.profile // "" | if . == "" then "-" else . end),
                (.class | gsub("-"; " ")),
                (.created // "" | if . == "" then "-" else .[0:10] end),
                (if .oidc == null then "-"
                 elif .oidc.effective == "yes" then "YES"
                 elif .oidc.effective == "contested" then "contested"
                 else "no" end)
            ] | @tsv)' | column -t -s $'\t'
        echo
        printf '%s' "${answer}" | jq -r '.residue[] |
            "  " + .kind + "/" + .name + ": " + .reason
            + (if .oidc == null then "" else
                 (if (.oidc.clients | length) > 0 then "; configures: " + (.oidc.clients | join(", ")) else "" end)
                 + (if (.oidc.contested | length) > 0 then "; another catalog carries the same label, so these clients are refused until one is removed: " + (.oidc.contested | join(", ")) else "" end)
                 + (if (.oidc.composition // "") != "" then "; read by the Composition of " + .oidc.composition else "" end)
               end)
            + (if (.companions // []) | length > 0 then "; its bundle brings " + (.companions | join(", ")) + ", which stay" else "" end)
            + (if .removable then "" else " (not removed here: " + (.notRemovable // "") + ")" end)'
        echo
        echo "Nothing here is removed automatically. To remove one:"
        echo "  kubectl gentian catalogues residue remove <kind>/<name>"
    fi
    printf '%s' "${answer}" | jq -r '.incomplete[] | "Not established: " + .'
}

# catalogues residue remove: one object of the list, named, with the name
# typed again. The director refuses anything that is not on the list when it
# is asked, and says what was deleted or why nothing was.
cmd_catalogues_residue_remove() {
    local target="" ns="" yes="" typed="" kind name body status
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --namespace|-n) ns="${2:?}"; shift 2 ;;
            --yes) yes=1; shift ;;
            -*) die "unknown option $1" ;;
            *)
                [[ -z "${target}" ]] || die "unexpected argument $1: one object is removed at a time"
                target="$1"; shift ;;
        esac
    done
    kind="${target%%/*}"
    name="${target#*/}"
    [[ "${target}" == */* && -n "${kind}" && -n "${name}" ]] ||
        die "usage: kubectl gentian catalogues residue remove <kind>/<name> [--namespace <ns>] [--yes]"
    need jq
    if [[ -z "${yes}" ]]; then
        [[ -t 0 ]] || die "not a terminal: confirm with --yes"
        echo "Removing the ${kind} ${name} deletes it from the cluster. Nothing puts it back but"
        echo "installing a build that brings it."
        read -r -p "Type ${name} to confirm: " typed
        [[ "${typed}" == "${name}" ]] || die "not confirmed; nothing was changed"
    fi
    _discover
    body="$(jq -n --arg k "${kind}" --arg n "${name}" --arg ns "${ns}" \
        '{kind: $k, name: $n, confirm: $n} + (if $ns == "" then {} else {namespace: $ns} end)')"
    _try POST "/v1/clusters/${_CLUSTER}/actions/remove-catalogue-residue" "${body}"
    [[ "${_TRY_STATUS}" -lt 300 ]] ||
        die "nothing was deleted (the director answered ${_TRY_STATUS}): ${_TRY_ANSWER:-no detail}"
    status="$(printf '%s' "${_TRY_ANSWER}" | jq -r '.status // ""')"
    case "${status}" in
        deleted) echo "Deleted the ${kind} ${name}." ;;
        deleting) echo "The ${kind} ${name} is being deleted; it is not gone yet." ;;
        *) echo "The ${kind} ${name} is not deleted yet (${status:-no status})." ;;
    esac
    printf '%s' "${_TRY_ANSWER}" | jq -r '"  " + (.message // "")'
}

cmd_catalogues() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        list) cmd_catalogues_list "$@" ;;
        residue)
            case "${1:-}" in
                "") cmd_catalogues_residue_list ;;
                remove) shift; cmd_catalogues_residue_remove "$@" ;;
                *) die "usage: kubectl gentian catalogues residue [remove <kind>/<name> [--namespace <ns>] [--yes]]" ;;
            esac
            ;;
        add|remove)
            local name="" address="" artifact="" repository="" t=""
            local add_usage="usage: kubectl gentian catalogues add <name> <https-url> [--tenant <tenant>]
       kubectl gentian catalogues add <name> --oci <host>/<path>:<tag> --repository <declared repository> [--tenant <tenant>]"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --tenant|-t) t="${2:?}"; shift 2 ;;
                    --path|--path=*)
                        [[ "${sub}" == "add" ]] || die "unknown option ${1%%=*}"
                        die "a catalogue is never kept in the deployments repository, which holds the cluster's state only; publish it as an OCI artifact (--oci) or at an https address.
${add_usage}" ;;
                    --oci)
                        [[ "${sub}" == "add" ]] || die "unknown option $1"
                        artifact="${2:?${add_usage}}"; shift 2 ;;
                    --oci=*)
                        [[ "${sub}" == "add" ]] || die "unknown option ${1%%=*}"
                        artifact="${1#*=}"; shift ;;
                    --repository)
                        [[ "${sub}" == "add" ]] || die "unknown option $1"
                        repository="${2:?${add_usage}}"; shift 2 ;;
                    --repository=*)
                        [[ "${sub}" == "add" ]] || die "unknown option ${1%%=*}"
                        repository="${1#*=}"; shift ;;
                    -*) die "unknown option $1" ;;
                    *)
                        if [[ -z "${name}" ]]; then name="$1"
                        elif [[ -z "${address}" ]]; then address="$1"
                        else die "unexpected argument $1"
                        fi
                        shift ;;
                esac
            done
            if [[ "${sub}" == "add" ]]; then
                # One of the two: an address or an artifact.
                [[ -n "${name}" ]] || die "${add_usage}"
                [[ -n "${address}" && -z "${artifact}" ]] || [[ -z "${address}" && -n "${artifact}" ]] ||
                    die "a catalogue is at an https address or an OCI artifact (--oci): one of them.
${add_usage}"
                [[ -z "${artifact}" || -n "${repository}" ]] ||
                    die "an OCI artifact is read with a declared repository's credential: name it with --repository.
${add_usage}"
                [[ -n "${artifact}" || -z "${repository}" ]] || die "--repository goes with --oci.
${add_usage}"
                need jq
                if [[ -n "${artifact}" ]]; then
                    _catalogues_change add PUT "${name}" "${t}" \
                        "$(jq -n --arg r "${repository}" --arg a "${artifact}" '{oci: {repository: $r, artifact: $a}}')"
                else
                    _catalogues_change add PUT "${name}" "${t}" "$(jq -n --arg u "${address}" '{url: $u}')"
                fi
            else
                [[ -n "${name}" && -z "${address}" ]] ||
                    die "usage: kubectl gentian catalogues remove <name> [--tenant <tenant>]"
                _catalogues_change remove DELETE "${name}" "${t}"
            fi
            ;;
        rename)
            local old="" new="" t=""
            local rename_usage="usage: kubectl gentian catalogues rename <old> <new> [--tenant <tenant>]"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --tenant|-t) t="${2:?${rename_usage}}"; shift 2 ;;
                    -*) die "unknown option $1" ;;
                    *)
                        if [[ -z "${old}" ]]; then old="$1"
                        elif [[ -z "${new}" ]]; then new="$1"
                        else die "unexpected argument $1"
                        fi
                        shift ;;
                esac
            done
            [[ -n "${old}" && -n "${new}" ]] || die "${rename_usage}"
            need jq
            cmd_catalogues_rename "${old}" "${new}" "${t}"
            ;;
        *) die "usage: kubectl gentian catalogues list|add|remove|rename|residue ..." ;;
    esac
}

# repositories: a private registry a tenant pulls charts and images from.
#
# Declared here, with the token set afterwards in the Admin Console of the
# tenant under Credentials, as the name the director answers: an address is
# configuration and belongs in git, a token is a credential and belongs in
# the vault. A chart whose address lies inside the declared one is pulled
# with it. The route is the tenant's own, under can_write_credential, which
# is also the relation that lets the same person set the token.
cmd_repositories() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        declare|remove)
            local name="" t="" url="" type="oci" role="apps"
            local usage="usage: kubectl gentian repositories declare <name> --tenant <tenant> --url oci://<host>/<path> [--type oci|git] [--role apps]
       kubectl gentian repositories remove <name> --tenant <tenant>"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --tenant|-t) t="${2:?}"; shift 2 ;;
                    --url) url="${2:?}"; shift 2 ;;
                    --type) type="${2:?}"; shift 2 ;;
                    --role) role="${2:?}"; shift 2 ;;
                    -*) die "unknown option $1" ;;
                    *) [[ -z "${name}" ]] || die "unexpected argument $1"; name="$1"; shift ;;
                esac
            done
            [[ -n "${name}" && -n "${t}" ]] || die "${usage}"
            _discover
            if [[ "${sub}" == "declare" ]]; then
                [[ -n "${url}" ]] || die "${usage}"
                need jq
                _try PUT "/v1/tenants/${t}/repositories/${name}" \
                    "$(jq -n --arg r "${role}" --arg y "${type}" --arg u "${url}" '{role:$r, type:$y, url:$u}')"
            else
                _try DELETE "/v1/tenants/${t}/repositories/${name}"
            fi
            [[ "${_TRY_STATUS}" -lt 300 ]] || die "the director answered ${_TRY_STATUS}: ${_TRY_ANSWER:-no detail}"
            local commit credential
            commit="$(printf '%s' "${_TRY_ANSWER}" | jq -r '.commit // "" | .[0:8]')"
            if [[ "${sub}" == "declare" ]]; then
                credential="$(printf '%s' "${_TRY_ANSWER}" | jq -r '.credentialName // ""')"
                echo "Repository ${name} declared for tenant ${t}: committed (${commit:-no commit id})."
                echo "Its token is set in the Admin Console of ${t}, under Credentials, as ${credential:-repository-${name}};"
                echo "until then nothing is pulled from it. A chart whose address lies inside ${url} is pulled with it."
            else
                echo "Repository ${name} removed for tenant ${t}: committed (${commit:-no commit id})."
            fi
            ;;
        *) die "usage: kubectl gentian repositories declare|remove ..." ;;
    esac
}

# models: the models the cluster's gateway offers. They are the Cluster
# claim's (spec.llm) and the cluster administrator's to change: `set` sends
# the whole of the settings, so a model the file does not name is removed.
# `show` prints what `set` takes, so the two make an edit:
#
#   kubectl gentian models show > models.json; $EDITOR models.json
#   kubectl gentian models set -f models.json
#
# The state is what the claim alone says. Whether an instance has finished
# loading its model, or a provider's token has been supplied, is not known
# here; the admin console shows the token, under Models and under Credentials.
cmd_models() {
    local sub="${1:-}" answer
    shift || true
    case "${sub}" in
        list)
            _discover
            answer="$(_call GET "/v1/clusters/${_CLUSTER}/models")" || exit 1
            if [[ "$(printf '%s' "${answer}" | jq -r '.models | length')" == "0" ]]; then
                echo "The claim declares no models."
            else
                printf '%s' "${answer}" | jq -r '
                    (["MODEL","FROM","STATE","NOTE"] | @tsv),
                    (.models[] | [.name,
                        (if .kind == "instance" then "instance " + .source else "provider " + .source end),
                        (if .state == "not-offered" then "not offered" else "declared" end),
                        (.reason // (if .kind == "instance" then "served by vllm-" + .source + "-inference"
                            else "token: credential " + .credential + ", property " + .apiKeyProperty end))] | @tsv)' |
                    column -t -s $'\t'
            fi
            printf '%s' "${answer}" | jq -r '"Model serving is " + (if .settings.enabled then "on" else "off" end) +
                ", GPU serving " + (if .settings.gpuAcceleration then "on" else "off" end) + "."'
            ;;
        show)
            _discover
            _call GET "/v1/clusters/${_CLUSTER}/models" | jq '.settings'
            ;;
        set)
            local file="" body status
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    -f|--file) file="${2:?usage: kubectl gentian models set -f <file.json>}"; shift 2 ;;
                    *) die "usage: kubectl gentian models set -f <file.json>" ;;
                esac
            done
            [[ -n "${file}" ]] || die "usage: kubectl gentian models set -f <file.json>"
            [[ -r "${file}" ]] || die "cannot read ${file}"
            need jq
            body="$(jq -c 'if type == "object" then . else error("not an object") end' "${file}" 2>/dev/null)" ||
                die "${file} is not a JSON object; start from: kubectl gentian models show"
            _discover
            answer="$(_call PUT "/v1/clusters/${_CLUSTER}/models" "${body}")" || exit 1
            status="$(printf '%s' "${answer}" | jq -r '.status // ""')"
            if [[ "${status}" == "unchanged" ]]; then
                echo "The claim already declares these models; nothing was committed."
            else
                echo "Model settings committed ($(_committed "${answer}")). The gateway restarts with them once Argo CD has synced."
                echo "  kubectl gentian models list"
            fi
            ;;
        *) die "usage: kubectl gentian models list|show|set -f <file.json>" ;;
    esac
}

# settings: the Cluster claim's scalar settings, read from git and changed
# there. The director holds the list of what may be set (its allowlist) and
# refuses the rest; a change is one commit, and the cluster takes it when
# Argo CD has synced. The same as editing the claim and running install.sh,
# without the checkout.
cmd_settings() {
    local sub="${1:-}" answer status
    shift || true
    case "${sub}" in
        show)
            _discover
            _call GET "/v1/clusters/${_CLUSTER}/settings" | jq '.settings'
            ;;
        set)
            local body='{}' kv key value
            [[ $# -gt 0 ]] || die "usage: kubectl gentian settings set <path>=<value> [<path>=<value> ...]"
            need jq
            for kv in "$@"; do
                [[ "${kv}" == *=* ]] || die "not a setting: ${kv} (expected <path>=<value>, e.g. tenancyMode=multi)"
                key="${kv%%=*}"; value="${kv#*=}"
                [[ -n "${key}" ]] || die "not a setting: ${kv}"
                body="$(jq -c --arg k "${key}" --arg v "${value}" '. + {($k): $v}' <<<"${body}")"
            done
            _discover
            answer="$(_call PATCH "/v1/clusters/${_CLUSTER}/settings" "{\"settings\":${body}}")" || exit 1
            status="$(printf '%s' "${answer}" | jq -r '.status // ""')"
            local step
            step="$(printf '%s' "${answer}" | jq -r '.installStep // ""')"
            if [[ "${status}" == "unchanged" ]]; then
                echo "The claim already says so; nothing was committed."
            elif [[ -n "${step}" ]]; then
                # A setting the installer reads, not the operator: committed,
                # and applied by that step on the install host.
                echo "Settings committed ($(_committed "${answer}")). The installer reads this setting at step ${step}; the cluster takes it when that step runs again:"
                echo "  ./install.sh --only ${step}"
            else
                echo "Settings committed ($(_committed "${answer}")). The cluster takes them once Argo CD has synced."
                echo "  kubectl gentian settings show"
            fi
            ;;
        *) die "usage: kubectl gentian settings show|set <path>=<value> ..." ;;
    esac
}

# tenants mail-mode: what the operator provisions for a tenant's mail
# (docs/design/mail.md §2). A name alone shows what git declares; with a mode
# it is one commit. The decision that matters most is disabled for a tenant on
# a domain of its own whose mail is elsewhere: on a cluster with its own mail
# the operator otherwise publishes MX records for that domain, over the ones
# that are there.
cmd_tenants_mail_mode() {
    local name="${1:-}" mode="${2:-}" tenants current answer
    [[ -n "${name}" && $# -le 2 ]] || die "usage: kubectl gentian tenants mail-mode <name> [selfhosted|external|transport-only|disabled]"
    need jq
    _discover
    tenants="$(_call GET "/v1/clusters/${_CLUSTER}/tenants")" || exit 1
    printf '%s' "${tenants}" | jq -e --arg n "${name}" '.tenants[]? | select(.name == $n)' >/dev/null ||
        die "no tenant named ${name} in git (kubectl gentian tenants list)"
    current="$(printf '%s' "${tenants}" | jq -r --arg n "${name}" '.tenants[] | select(.name == $n) | .mailMode // ""')"
    if [[ -z "${mode}" ]]; then
        if [[ -n "${current}" ]]; then
            echo "Tenant ${name}: mail mode ${current}."
        else
            echo "Tenant ${name} names no mail mode: the cluster's default applies -- selfhosted where the cluster"
            echo "runs its own mail, transport-only where it relays."
        fi
        return 0
    fi
    case "${mode}" in
        selfhosted|external|transport-only|disabled) ;;
        *) die "not a mail mode: ${mode} (selfhosted, external, transport-only or disabled)" ;;
    esac
    answer="$(_call PUT "/v1/clusters/${_CLUSTER}/tenants/${name}/mail-mode" "$(jq -n --arg m "${mode}" '{mode: $m}')")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
        echo "Tenant ${name} already has mail mode ${mode}; nothing was committed."
        return 0
    fi
    echo "Tenant ${name}: mail mode ${mode}, committed ($(_committed "${answer}")). The operator provisions accordingly."
}

# tenants delegate-catalogues: whether a tenant's own administrators may add
# catalogues for their tenant. The cluster administrator's to say.
cmd_tenants_delegate_catalogues() {
    local name="${1:-}" state="${2:-}"
    [[ -n "${name}" && ( "${state}" == "on" || "${state}" == "off" ) ]] ||
        die "usage: kubectl gentian tenants delegate-catalogues <name> on|off"
    _discover
    if [[ "${state}" == "on" ]]; then
        _call PUT "/v1/clusters/${_CLUSTER}/tenants/${name}/catalogue-delegation" >/dev/null
        echo "The administrators of ${name} may now add catalogues for their tenant: committed."
    else
        _call DELETE "/v1/clusters/${_CLUSTER}/tenants/${name}/catalogue-delegation" >/dev/null
        echo "The administrators of ${name} may no longer add catalogues: committed. What they added stays until it is removed."
    fi
}

# tenants platform-access: whether the platform's administrators may sign in
# to a tenant, as its administrators (Tenant spec.platformAccess.adminsEnter).
# The tenant's own administrators' switch, off unless turned on, and not the
# tenant's operated_by consent: that one covers the director, this one the
# sign-in. One request to the director, which decides who may.
cmd_tenants_platform_access() {
    local name="${1:-}" state="${2:-}" answer
    [[ -n "${name}" && ( -z "${state}" || "${state}" == "on" || "${state}" == "off" ) && $# -le 2 ]] ||
        die "usage: kubectl gentian tenants platform-access <name> [on|off]"
    _label "The tenant" "${name}"
    need jq
    _discover
    if [[ -z "${state}" ]]; then
        answer="$(_call GET "/v1/tenants/${name}/platform-access")" || exit 1
        if [[ "$(jq -r '.adminsEnter' <<<"${answer}")" == "true" ]]; then
            echo "The platform's administrators may sign in to ${name} as its administrators."
            [[ -n "${_KERNEL_DOMAIN}" ]] && echo "  https://desktop.${name}.${_KERNEL_DOMAIN}/?kc_idp_hint=kernel"
        else
            echo "The platform's administrators may not sign in to ${name}."
        fi
        return 0
    fi
    local on=false
    [[ "${state}" == "on" ]] && on=true
    answer="$(_call PUT "/v1/tenants/${name}/platform-access" "{\"adminsEnter\":${on}}")" || exit 1
    if [[ "$(jq -r '.status // ""' <<<"${answer}")" == "unchanged" ]]; then
        echo "The tenant says so already; nothing was committed."
        return 0
    fi
    if [[ "${on}" == true ]]; then
        echo "The platform's administrators may sign in to ${name} as its administrators: committed ($(_committed "${answer}"))."
        echo "They enter through the platform console, or at https://desktop.${name}.${_KERNEL_DOMAIN:-<kernel-domain>}/?kc_idp_hint=kernel;"
        echo "the tenant's sign-in page shows no button for it. Each entry is in the realm's login events."
    else
        echo "The platform's administrators may no longer sign in to ${name}: committed ($(_committed "${answer}"))."
        echo "An account one of them already has in the realm stays until the tenant's administrator removes it."
    fi
}

# platform-roles: who on the cluster holds which cluster role by name. The
# cluster's administrator gives a person of the platform tenant, or an
# administrator of another tenant, a role (securityOfficer, auditor,
# serviceAdmin, sharedAppsAdmin, perimeterApprover) on the Cluster claim, with
# a reason and, if it ends, an expiry; it is held with a token of that
# tenant's realm and no other. serviceAdmin and sharedAppsAdmin are the
# platform tenant's people's alone; a perimeterApprover of the platform tenant
# approves for every tenant, one of another tenant for that tenant.
#
#   platform-roles candidates                     who could hold one, from the registrar
#   platform-roles holders                        who holds which, as the claim declares
#   platform-roles holders add <role> <tenant> <login> --reason <why> [--expires <RFC 3339>] [--scope tenant:<t>]
#   platform-roles holders remove <role> <tenant> <login>
#   platform-roles members                        who holds admin and breakGlass through their group
#
# add looks the login up in the candidates through the registrar and commits
# the account's subject; remove takes the claim's entry by the login, or by
# the subject.
cmd_platform_roles() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        candidates) cmd_platform_roles_candidates "$@" ;;
        holders) cmd_platform_roles_holders "$@" ;;
        members) cmd_platform_roles_members "$@" ;;
        *) die "usage: kubectl gentian platform-roles candidates | members | holders [add|remove <role> <tenant> <login>]" ;;
    esac
}

cmd_platform_roles_candidates() {
    [[ $# -eq 0 ]] || die "usage: kubectl gentian platform-roles candidates"
    need jq
    _discover
    local answer
    answer="$(_call_registrar GET "/v1/clusters/${_CLUSTER}/role-candidates")" || exit 1
    if [[ "$(jq '.tenants | length' <<<"${answer}")" == "0" ]]; then
        echo "This cluster has nobody who could be given a cluster role yet."
        return 0
    fi
    jq -r '(["TENANT","AS","LOGIN","EMAIL","NAME","SUBJECT"] | @tsv),
        (.tenants[] | . as $t | (if .platform then "person" else "administrator" end) as $as |
            if .unavailable then [$t.tenant, $as, "(its realm could not be read)", "", "", ""] | @tsv
            elif ((.people // []) | length) == 0 then [$t.tenant, $as, "(nobody)", "", "", ""] | @tsv
            else .people[] | [$t.tenant, $as, .username, (.email // ""), (.name // ""), .id] | @tsv end)' <<<"${answer}" |
        column -t -s $'\t'
    if [[ "$(jq -r '.complete' <<<"${answer}")" != "true" ]]; then
        echo "A realm could not be read; the list is incomplete."
    fi
}

# The members of the kernel-realm group admin and breakGlass are held through
# (spec.platformRoles). Read only: they are managed in Keycloak.
cmd_platform_roles_members() {
    [[ $# -eq 0 ]] || die "usage: kubectl gentian platform-roles members"
    need jq
    _discover
    local answer
    answer="$(_call_registrar GET "/v1/clusters/${_CLUSTER}/platform-role-members")" || exit 1
    jq -r '(["ROLE","GROUP","LOGIN","EMAIL"] | @tsv),
        (.roles[] | . as $r | if .unavailable then [$r.role, $r.group, "(could not be read)", ""] | @tsv
            elif (.members | length) == 0 then [$r.role, $r.group, "(nobody)", ""] | @tsv
            else .members[] | [$r.role, $r.group, .username, (.email // "")] | @tsv end)' <<<"${answer}" |
        column -t -s $'\t'
    if [[ "$(jq -r '.complete' <<<"${answer}")" != "true" ]]; then
        echo "A group could not be read; the list is incomplete."
    fi
    echo "These groups are managed in Keycloak, in the kernel realm."
}

cmd_platform_roles_holders() {
    local action="${1:-list}" answer
    local usage="usage: kubectl gentian platform-roles holders [list | add <role> <tenant> <login> --reason <why> [--expires <RFC 3339>] [--scope tenant:<t>] | remove <role> <tenant> <login>]"
    need jq
    shift || true
    case "${action}" in
        list)
            [[ $# -eq 0 ]] || die "${usage}"
            _discover
            answer="$(_call GET "/v1/clusters/${_CLUSTER}/platform-roles/holders")" || exit 1
            if [[ "$(jq '.roleHolders | length' <<<"${answer}")" == "0" ]]; then
                echo "The claim gives nobody a cluster role by name. Roles: $(jq -r '.roles | join(", ")' <<<"${answer}")."
                echo "  kubectl gentian platform-roles holders add <role> <tenant> <login> --reason <why>"
                return 0
            fi
            jq -r '(["ROLE","SCOPE","TENANT","LOGIN","EMAIL","EXPIRES","REASON","IN EFFECT"] | @tsv),
                (.roleHolders[] | [.role, (.scope // "cluster"), .tenant, .username, (.email // ""), (.expiresAt // "-"), (.reason // "-"),
                    (if .notInEffect then "no: " + .notInEffect else "yes" end)] | @tsv)' <<<"${answer}" |
                column -t -s $'\t'
            ;;
        add)
            local role="" tenant="" login="" reason="" expires="" scope=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --reason) [[ $# -ge 2 ]] || die "${usage}"; reason="$2"; shift 2 ;;
                    --scope) [[ $# -ge 2 ]] || die "${usage}"; scope="$2"; shift 2 ;;
                    --expires) [[ $# -ge 2 ]] || die "${usage}"; expires="$2"; shift 2 ;;
                    -*) die "unknown option $1" ;;
                    *)
                        if [[ -z "${role}" ]]; then role="$1"
                        elif [[ -z "${tenant}" ]]; then tenant="$1"
                        elif [[ -z "${login}" ]]; then login="$1"
                        else die "${usage}"; fi
                        shift ;;
                esac
            done
            [[ -n "${role}" && -n "${tenant}" && -n "${login}" && -n "${reason}" ]] || die "${usage}"
            # A tenant's auditor is a person of the platform tenant; the one
            # tenant whose evidence they read is theirs to name.
            [[ "${role}" != "tenantAuditor" || -n "${scope}" ]] || die "tenantAuditor reads one tenant's evidence: name it with --scope tenant:<t>"
            _label "The tenant" "${tenant}"
            _discover
            local people person
            people="$(_call_registrar GET "/v1/clusters/${_CLUSTER}/role-candidates")" || exit 1
            if [[ "$(jq -c --arg t "${tenant}" '.tenants[] | select(.tenant == $t)' <<<"${people}")" == "" ]]; then
                die "this cluster has no tenant ${tenant} whose people could be named; see kubectl gentian platform-roles candidates"
            fi
            person="$(jq -c --arg t "${tenant}" --arg l "${login}" '[.tenants[] | select(.tenant == $t) | (.people // [])[] |
                select((.username | ascii_downcase) == ($l | ascii_downcase) or ((.email // "") | ascii_downcase) == ($l | ascii_downcase) or .id == $l)] | first // empty' <<<"${people}")"
            if [[ -z "${person}" ]]; then
                echo "Nobody of ${tenant} who could be named is ${login}. Those who could:" >&2
                jq -r --arg t "${tenant}" '.tenants[] | select(.tenant == $t) | (.people // [])[] | "  \(.username)"' <<<"${people}" >&2
                exit 1
            fi
            local subject username email
            subject="$(jq -r '.id' <<<"${person}")"
            username="$(jq -r '.username' <<<"${person}")"
            email="$(jq -r '.email // ""' <<<"${person}")"
            answer="$(_call PUT "/v1/clusters/${_CLUSTER}/platform-roles/holders/${role}/${tenant}/${subject}" \
                "$(jq -n --arg u "${username}" --arg e "${email}" --arg r "${reason}" --arg x "${expires}" --arg s "${scope}" \
                    '{username: $u, email: $e, reason: $r} + (if $x != "" then {expiresAt: $x} else {} end)
                        + (if $s != "" then {scope: $s} else {} end)')")" || exit 1
            if [[ "$(jq -r '.status // ""' <<<"${answer}")" == "unchanged" ]]; then
                echo "${username} of ${tenant} holds ${role} already, as stated; nothing was committed."
                return 0
            fi
            echo "${username} of ${tenant} holds ${role}${scope:+ over ${scope}}${expires:+ until ${expires}}: committed ($(_committed "${answer}"))."
            echo "Once Argo CD has synced, the operator writes the role for their ${tenant} account; they use it"
            echo "signed in to ${tenant}, from its admin console."
            ;;
        remove)
            local role="${1:-}" tenant="${2:-}" login="${3:-}"
            [[ -n "${role}" && -n "${tenant}" && -n "${login}" && $# -eq 3 ]] || die "${usage}"
            _label "The tenant" "${tenant}"
            _discover
            local holders subject
            holders="$(_call GET "/v1/clusters/${_CLUSTER}/platform-roles/holders")" || exit 1
            subject="$(jq -r --arg r "${role}" --arg t "${tenant}" --arg l "${login}" '[.roleHolders[] | select(.role == $r and .tenant == $t) |
                select((.username | ascii_downcase) == ($l | ascii_downcase) or ((.email // "") | ascii_downcase) == ($l | ascii_downcase) or .subject == $l)] | first | .subject // empty' <<<"${holders}")"
            [[ -n "${subject}" ]] || die "no ${role} of tenant ${tenant} is ${login}; see kubectl gentian platform-roles holders"
            answer="$(_call DELETE "/v1/clusters/${_CLUSTER}/platform-roles/holders/${role}/${tenant}/${subject}")" || exit 1
            if [[ "$(jq -r '.status // ""' <<<"${answer}")" == "unchanged" ]]; then
                echo "The claim names no such holder; nothing was committed."
                return 0
            fi
            echo "${login} of ${tenant} no longer holds ${role}: committed ($(_committed "${answer}"))."
            ;;
        *) die "${usage}" ;;
    esac
}

# tenants set: what about a tenant only the cluster's administrator decides --
# whether its own administrators may add catalogues, a switch on the tenant's
# manifest in git, off unless turned on: one request to the director (PUT
# turns it on, DELETE off), which decides who may. --country sets the tenant's country (spec.country), which
# its own administrators may set too. Everything is read before anything is asked, so a mistyped
# option changes nothing.
cmd_tenants_set() {
    local name="" catalogues="" country="" country_set="" usage_text
    usage_text="usage: kubectl gentian tenants set <name> [--admins-add-catalogues=true|false] [--country <alpha-2> | --country \"\"]"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --admins-add-catalogues=true|--admins-add-catalogues=false) catalogues="${1#*=}"; shift ;;
            --admins-add-catalogues*) die "${1%%=*} is given as ${1%%=*}=true or ${1%%=*}=false" ;;
            --country) [[ $# -ge 2 ]] || die "${usage_text}"; country="$2"; country_set=1; shift 2 ;;
            --country=*) country="${1#*=}"; country_set=1; shift ;;
            -*) die "unknown option $1" ;;
            *) [[ -z "${name}" ]] || die "${usage_text}"; name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "${usage_text}"
    [[ -n "${catalogues}${country_set}" ]] || die "nothing to set. ${usage_text}"
    _label "The tenant" "${name}"
    if [[ -n "${country_set}" ]]; then
        country="$(_country "${country}")" || exit 1
    fi
    _discover
    if [[ "${catalogues}" == "true" ]]; then
        _call PUT "/v1/clusters/${_CLUSTER}/tenants/${name}/catalogue-delegation" >/dev/null
        echo "The administrators of ${name} may now add catalogues for their tenant: committed."
    elif [[ "${catalogues}" == "false" ]]; then
        _call DELETE "/v1/clusters/${_CLUSTER}/tenants/${name}/catalogue-delegation" >/dev/null
        echo "The administrators of ${name} may no longer add catalogues: committed. What they added stays until it is removed."
    fi
    # The tenant's own setting, beside its languages: asked on the tenant's
    # route, which its own administrators may use as well.
    if [[ -n "${country_set}" ]]; then
        _call PUT "/v1/tenants/${name}/country" "$(jq -n --arg k "${country}" '{country:$k}')" >/dev/null
        if [[ -n "${country}" ]]; then
            echo "The country of ${name} is ${country}: committed."
        else
            echo "${name} names no country: committed."
        fi
    fi
}

# _country <code> -- a country as the director takes it: ISO 3166-1 alpha-2,
# upper case; "" stays "". The director checks it again.
_country() {
    local c
    c="$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')"
    [[ -z "${c}" || "${c}" =~ ^[A-Z]{2}$ ]] ||
        die "a country is an ISO 3166-1 alpha-2 code, two letters such as CH or DE, not '$1'"
    printf '%s' "${c}"
}

# ---------------------------------------------------------------------------
# A tenant's own domain, and what a tenant has on the internet
# ---------------------------------------------------------------------------

# _label <what> <value> — a value that goes into a request's path is a name:
# lower-case letters, digits and hyphens. Refused here so that nothing typed
# can turn one request into another; the director checks the name again.
_label() {
    [[ "$2" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] ||
        die "$1 is a name of lower-case letters, digits and hyphens, not '$2'"
}

# _committed <answer> — the first eight characters of the commit an answer
# names, or a word for none.
_committed() {
    local commit
    commit="$(printf '%s' "$1" | jq -r '.commit // "" | .[0:8]')"
    echo "${commit:-no commit id}"
}

# kubectl gentian tenants groups <tenant> [<group>... | --clear]
# A tenant's own groups of its realm, declared in git (spec.groups): made by
# the platform, filled in the Admin Console. Without names it shows them;
# with names it sets them (the list given is the list); --clear removes all.
cmd_tenants_groups() {
    local name="${1:-}" clear="" answer body
    [[ -n "${name}" && "${name}" != -* ]] || die "usage: kubectl gentian tenants groups <tenant> [<group>... | --clear]"
    shift
    _label "a tenant" "${name}"
    local groups=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --clear) clear=1; shift ;;
            -*) die "unknown option $1" ;;
            *) _label "a group" "$1"; groups+=("$1"); shift ;;
        esac
    done
    need curl jq
    _connect
    if [[ -z "${clear}" && ${#groups[@]} -eq 0 ]]; then
        answer="$(_call GET "/v1/clusters/${_CLUSTER}/tenants/${name}/groups")" || exit 1
        if [[ "$(jq '.groups | length' <<<"${answer}")" == "0" ]]; then
            echo "Tenant ${name} declares no groups of its own."
        else
            jq -r '.groups[]' <<<"${answer}"
        fi
        return 0
    fi
    [[ -z "${clear}" || ${#groups[@]} -eq 0 ]] || die "--clear takes no groups"
    if [[ ${#groups[@]} -gt 0 ]]; then
        body="$(printf '%s\n' "${groups[@]}" | jq -R . | jq -sc '{groups: .}')"
    else
        body='{"groups":[]}'
    fi
    answer="$(_call PUT "/v1/clusters/${_CLUSTER}/tenants/${name}/groups" "${body}")" || exit 1
    if [[ "$(jq -r '.status // ""' <<<"${answer}")" == "unchanged" ]]; then
        echo "Tenant ${name}'s groups are as given already; nothing was committed."
        return 0
    fi
    echo "Tenant ${name}'s groups: committed ($(_committed "${answer}")). The platform makes them in its realm."
}

# kubectl gentian tenants sign-in <target> [--from <source> --groups <g>,... | --remove <source>]
# People of another tenant of this cluster signing in to <target> with their
# account there, given the groups of <target> named (members, or groups of
# its own: tenants groups). One commit of both tenants' line; the platform
# makes the client and the identity provider. Without options it shows what
# <target> declares.
cmd_tenants_sign_in() {
    local name="${1:-}" from="" given="" remove="" answer body
    [[ -n "${name}" && "${name}" != -* ]] || die "usage: kubectl gentian tenants sign-in <tenant> [--from <tenant> --groups <g>,... | --remove <tenant>]"
    shift
    _label "a tenant" "${name}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from) from="${2:-}"; shift 2 || die "--from needs a tenant" ;;
            --groups) given="${2:-}"; shift 2 || die "--groups needs a list" ;;
            --remove) remove="${2:-}"; shift 2 || die "--remove needs a tenant" ;;
            *) die "unexpected argument $1" ;;
        esac
    done
    need curl jq
    _connect
    if [[ -z "${from}" && -z "${remove}" ]]; then
        answer="$(_call GET "/v1/clusters/${_CLUSTER}/tenants/${name}/sign-in")" || exit 1
        jq -r --arg t "${name}" '
            (if (.signInFrom | length) == 0 then "No tenant'"'"'s people sign in to \($t)."
             else (.signInFrom[] | "people of \(.tenant) sign in to \($t) as: \((.groups // []) | join(", "))") end),
            (if (.signInTo | length) > 0 then "people of \($t) sign in to: \(.signInTo | join(", "))" else empty end)' <<<"${answer}"
        return 0
    fi
    [[ -z "${from}" || -z "${remove}" ]] || die "--from and --remove do not go together"
    if [[ -n "${remove}" ]]; then
        _label "a tenant" "${remove}"
        answer="$(_call DELETE "/v1/clusters/${_CLUSTER}/tenants/${name}/sign-in/${remove}")" || exit 1
        if [[ "$(jq -r '.status // ""' <<<"${answer}")" == "unchanged" ]]; then
            echo "People of ${remove} did not sign in to ${name}; nothing was committed."
            return 0
        fi
        echo "People of ${remove} no longer sign in to ${name}: committed ($(_committed "${answer}"))."
        return 0
    fi
    _label "a tenant" "${from}"
    body="$(printf '%s' "${given}" | tr ',' '\n' | sed '/^$/d' | jq -R . | jq -sc '{groups: .}')"
    answer="$(_call PUT "/v1/clusters/${_CLUSTER}/tenants/${name}/sign-in/${from}" "${body}")" || exit 1
    if [[ "$(jq -r '.status // ""' <<<"${answer}")" == "unchanged" ]]; then
        echo "People of ${from} sign in to ${name} as declared already; nothing was committed."
        return 0
    fi
    echo "People of ${from} sign in to ${name}${given:+ as ${given}}: committed ($(_committed "${answer}"))."
    echo "Their button on ${name}'s sign-in page reads ${from}'s display name."
}

# kubectl gentian tenants partners <tenant> [add <name> ... | remove <name>]
# The realms of other clusters a tenant's realm links its people's accounts
# with (Tenant spec.partners, AD-17). The director commits, within the issuers
# the Cluster claim allows; the composition makes the partner client and
# scope (--issue) and the identity provider partner-<name> (--accept).
# Writing needs can_administer on the tenant; a component the tenant names in
# spec.partnerCommissioners writes receiving entries with its own key.
cmd_tenants_partners() {
    local usage_text name="" action="" partner="" issuer="" as="" issue="false" accounts="" domain="" display="" answer
    usage_text="usage: kubectl gentian tenants partners <tenant>
       kubectl gentian tenants partners <tenant> add <name> --issuer <https://<host>/<path to the realm>> [--issue] [--accept link|create|organization [--domain <domain>] [--display-name <text>]] [--as <name>]
       kubectl gentian tenants partners <tenant> remove <name>"
    name="${1:-}"
    [[ -n "${name}" && "${name}" != -* ]] || die "${usage_text}"
    shift
    _label "a tenant" "${name}"
    action="${1:-}"
    [[ $# -eq 0 ]] || shift
    case "${action}" in
        "") ;;
        add|remove)
            partner="${1:-}"
            [[ -n "${partner}" && "${partner}" != -* ]] || die "${usage_text}"
            shift
            _label "a partner" "${partner}" ;;
        *) die "${usage_text}" ;;
    esac
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --issuer) issuer="${2:-}"; shift 2 || die "--issuer needs a value" ;;
            --as) as="${2:-}"; shift 2 || die "--as needs a value" ;;
            --issue) issue="true"; shift ;;
            --accept) accounts="${2:-}"; shift 2 || die "--accept needs link, create or organization" ;;
            --domain) domain="${2:-}"; shift 2 || die "--domain needs a value" ;;
            --display-name) display="${2:-}"; shift 2 || die "--display-name needs a value" ;;
            *) die "unexpected argument $1" ;;
        esac
    done
    need curl jq
    case "${action}" in
        "")
            answer="$(_call GET "/v1/tenants/${name}/partners")" || exit 1
            if [[ "$(printf '%s' "${answer}" | jq '.partners | length')" == "0" ]]; then
                echo "Tenant ${name} declares no partner (the Cluster claim's defaults apply)."
                return 0
            fi
            printf '%s' "${answer}" | jq -r '.partners[] |
                "\(.name)\t\(.issuer)\t\(if .issue then "issues" else "-" end)\t\(if .accept then "accepts: " + .accept.accounts else "-" end)\tidentity provider / scope partner-\(.name)"'
            ;;
        add)
            [[ -n "${issuer}" ]] || die "${usage_text}"
            [[ "${issue}" == "true" || -n "${accounts}" ]] || die "a partner issues (--issue), accepts (--accept ...), or both"
            case "${accounts}" in
                ""|link|create) [[ -z "${domain}${display}" ]] || die "--domain and --display-name are for --accept organization" ;;
                organization) [[ -n "${domain}" ]] || die "--accept organization needs --domain" ;;
                *) die "--accept takes link, create or organization" ;;
            esac
            domain="$(printf '%s' "${domain}" | tr '[:upper:]' '[:lower:]')"
            answer="$(_call PUT "/v1/tenants/${name}/partners/${partner}" "$(jq -n --arg i "${issuer}" --arg a "${as}" \
                --argjson s "${issue}" --arg c "${accounts}" --arg m "${domain}" --arg d "${display}" \
                '{issuer: $i}
                 + (if $a != "" then {as: $a} else {} end)
                 + (if $s then {issue: true} else {} end)
                 + (if $c != "" then {accept: ({accounts: $c}
                     + (if $m != "" then {domain: $m} else {} end)
                     + (if $d != "" then {displayName: $d} else {} end))} else {} end)')")" || exit 1
            if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
                echo "Tenant ${name} already has ${partner} as declared; nothing was committed."
                return 0
            fi
            echo "Tenant ${name} has the partner ${partner} (${issuer}): committed ($(_committed "${answer}"))."
            ;;
        remove)
            answer="$(_call DELETE "/v1/tenants/${name}/partners/${partner}")" || exit 1
            if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
                echo "Tenant ${name} has no partner ${partner}; nothing was committed."
                return 0
            fi
            echo "Tenant ${name} no longer has the partner ${partner}: committed ($(_committed "${answer}"))."
            ;;
    esac
}

# tenants domain: the domain of its own a tenant is served at, instead of its
# default address under the cluster's domain.
#
# With a name alone it shows what git declares. With a domain it binds the
# tenant to it, with --remove it unbinds it: one request to the director each
# (PUT or DELETE /v1/clusters/<c>/tenants/<t>/domain), which decides who may
# and which domains it refuses. What moves and what has to be true first is
# printed before anything is asked, and the change is confirmed by typing --
# the domain to bind, the tenant's name to unbind -- unless --yes says the
# caller already has. The DNS record and the certificate are checked by
# nobody: not by the director, and not here.
cmd_tenants_domain() {
    local name="" domain="" remove="" yes="" typed="" usage_text
    usage_text="usage: kubectl gentian tenants domain <name> [<domain> | --remove] [--yes]"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --remove) remove=1; shift ;;
            --yes) yes=1; shift ;;
            -*) die "unknown option $1" ;;
            *)
                if [[ -z "${name}" ]]; then name="$1"
                elif [[ -z "${domain}" ]]; then domain="$1"
                else die "unexpected argument $1"
                fi
                shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "${usage_text}"
    _label "a tenant" "${name}"
    [[ -z "${remove}" || -z "${domain}" ]] ||
        die "--remove takes no domain: it puts ${name} back at its default address"
    # The one spelling the director records, so what is shown is what is sent.
    domain="$(printf '%s' "${domain}" | tr '[:upper:]' '[:lower:]')"
    if [[ -n "${domain}${remove}" && -z "${yes}" ]]; then
        [[ -t 0 ]] || die "not a terminal: confirm with --yes"
    fi
    need curl jq
    _connect
    local tenants current answer
    tenants="$(_call GET "/v1/clusters/${_CLUSTER}/tenants")" || exit 1
    printf '%s' "${tenants}" | jq -e --arg n "${name}" '.tenants[]? | select(.name == $n)' >/dev/null ||
        die "no tenant named ${name}"
    current="$(printf '%s' "${tenants}" | jq -r --arg n "${name}" '.tenants[] | select(.name == $n) | .customDomain // ""')"

    if [[ -z "${domain}" && -z "${remove}" ]]; then
        if [[ -n "${current}" ]]; then
            echo "Tenant ${name} is bound to the domain ${current}: its desktop is desktop.${current}, its admin"
            echo "console admin.${current}, and each app <label>.${current}."
        else
            echo "Tenant ${name} is bound to no domain of its own: it is served at its default address under the"
            echo "cluster's domain."
        fi
        echo "That is what git declares. Whether the cluster has taken it in (empty when no domain is bound):"
        echo "  kubectl get tenant ${name} -o jsonpath='{.status.conditions[?(@.type==\"DomainBound\")].message}'"
        return 0
    fi

    if [[ -n "${remove}" ]]; then
        if [[ -z "${current}" ]]; then
            echo "Tenant ${name} is bound to no domain of its own; nothing was changed."
            return 0
        fi
        echo "Removing the domain ${current} from tenant ${name} puts it back at its default address under the"
        echo "cluster's domain. Its desktop, its admin console, every app, its mail and the names its people sign in"
        echo "with move there, and nothing of it answers at ${current} any more."
        if [[ -z "${yes}" ]]; then
            read -r -p "Type ${name} to confirm: " typed
            [[ "${typed}" == "${name}" ]] || die "not confirmed; nothing was changed"
        fi
        answer="$(_call DELETE "/v1/clusters/${_CLUSTER}/tenants/${name}/domain")" || exit 1
        if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
            echo "Tenant ${name} was bound to no domain; nothing was committed."
            return 0
        fi
        echo "Tenant ${name} is bound to no domain any more: committed ($(_committed "${answer}")). The operator moves it back."
        return 0
    fi

    if [[ "${current}" == "${domain}" ]]; then
        echo "Tenant ${name} is already bound to ${domain}; nothing was changed."
        return 0
    fi
    echo "Binding tenant ${name} to the domain ${domain} moves every address it is served at."
    if [[ -n "${current}" ]]; then
        echo "  now:   <label>.${current}"
    else
        echo "  now:   its default address under the cluster's domain"
    fi
    echo "  then:  desktop.${domain} (its desktop), admin.${domain} (its admin console) and <label>.${domain}"
    echo "         for every app, installed or yet to be"
    echo "Its mail and the names its people sign in with move to ${domain} as well. It is served at one domain:"
    echo "the addresses it has now stop being its own."
    echo
    echo "What has to be true first. The director checks none of it, and neither does this command:"
    echo "  - DNS: *.${domain} resolves to this cluster. The platform publishes records in the DNS zone that holds"
    echo "    the cluster's own domain and in the zones its settings list under certificates.dnsZones; list the zone"
    echo "    of ${domain} there (kubectl gentian settings set), or make the wildcard record yourself."
    echo "  - Mail: where ${domain}'s mail is elsewhere and this cluster runs its own, set the tenant's mail mode to"
    echo "    disabled first (kubectl gentian tenants mail-mode ${name} disabled), or the operator publishes MX records"
    echo "    for ${domain} over the ones that are there."
    echo "  - Certificate: the cluster's DNS-01 certificate issuer can write _acme-challenge records in the zone of"
    echo "    ${domain} -- its DNS token covers that zone. The tenant gets one wildcard certificate, *.${domain};"
    echo "    until it is issued its addresses have none."
    echo
    echo "This command is for a cluster with many tenants. On a single-tenancy cluster the one tenant for users"
    echo "is on the cluster's own addresses and the director refuses to bind it, as it refuses the platform tenant"
    echo "on any cluster. It also refuses a name that is not a hostname, one on or under the cluster's own"
    echo "domain, and one another tenant is bound to."
    if [[ -z "${yes}" ]]; then
        read -r -p "Type ${domain} to confirm: " typed
        [[ "${typed}" == "${domain}" ]] || die "not confirmed; nothing was changed"
    fi
    answer="$(_call PUT "/v1/clusters/${_CLUSTER}/tenants/${name}/domain" "$(jq -n --arg d "${domain}" '{domain: $d}')")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
        echo "Tenant ${name} is already bound to ${domain}; nothing was committed."
        return 0
    fi
    echo "Tenant ${name} bound to ${domain}: committed ($(_committed "${answer}")). The operator moves it; this says when it has,"
    echo "or why it has not:"
    echo "  kubectl get tenant ${name} -o jsonpath='{.status.conditions[?(@.type==\"DomainBound\")].message}'"
}

# exposures list: the registry of what a tenant has on the internet, as the
# director keeps it -- every entry a perimeter approver published, who did,
# when it is looked at again and when it ends. PUBLISHED is in force; REVIEW
# DUE is in force and past its review date; EXPIRED answers no longer and
# stays listed as the record that it once did.
#
# KIND is what was approved, in the director's words. Not every entry is a
# public address: one approved to keep the app's own Authorization header
# is behind sign-in and publishes nothing. A director that names no kinds is
# older than they are, and everything it lists is a public address.
cmd_exposures_list() {
    local t answer
    t="$(_tenant_flag "$@")"
    _label "a tenant" "${t}"
    need jq
    answer="$(_call GET "/v1/tenants/${t}/exposures")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '((.live // []) + (.expired // [])) | length')" == "0" ]]; then
        echo "Tenant ${t} has published nothing to the internet, and nothing else is approved for its apps' entries."
        return 0
    fi
    printf '%s' "${answer}" | jq -r '
        def day: if (. // "") == "" then "-" else .[0:10] end;
        (.kinds // {}) as $kinds
        | def kind: (.kind // "") as $k | (if $k == "" then "public" else $k end) as $k
            | $kinds[$k] // (if $k == "public" then "Public address" else $k end);
        def row(state): [.install, .exposureName, kind, state, (if .apex then "yes" else "-" end),
            (if (.alias // "") == "" then "-" else .alias end),
            (.owner // "-"), (.publishedAt | day), (.reviewAt | day), (.expiresAt | day),
            (if (.reason // "") == "" then "-" else .reason end)];
        ((.reviewDue // []) | map(.install + " " + .exposureName)) as $due
        | (["APP INSTANCE","ENTRY","KIND","STATE","MAIN ADDRESS","ALIAS","APPROVED BY","APPROVED","REVIEW","EXPIRES","REASON"] | @tsv),
          ((.live // [])[] | (.install + " " + .exposureName) as $k
              | row(if ($due | index($k)) != null then "review due" else "published" end) | @tsv),
          ((.expired // [])[] | row("expired") | @tsv)' |
        column -t -s $'\t'
}

# exposures withdraw: take one entry of an installed app off the internet, or
# take back the approval that lets an entry behind sign-in keep the app's own
# Authorization header.
# One request to the director (DELETE /v1/tenants/<t>/exposures/<app
# instance>/<entry>), which decides who may. It removes access and loses no
# data, so it is not asked twice.
cmd_exposures_withdraw() {
    local inst="" entry="" t="" answer usage_text
    usage_text="usage: kubectl gentian exposures withdraw <app-instance> <entry> --tenant <tenant>"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:?}"; shift 2 ;;
            -*) die "unknown option $1" ;;
            *)
                if [[ -z "${inst}" ]]; then inst="$1"
                elif [[ -z "${entry}" ]]; then entry="$1"
                else die "unexpected argument $1"
                fi
                shift ;;
        esac
    done
    [[ -n "${inst}" && -n "${entry}" ]] || die "${usage_text}"
    [[ -n "${t}" ]] || die "--tenant is required"
    _label "a tenant" "${t}"
    _label "an app instance" "${inst}"
    _label "an entry" "${entry}"
    need jq
    answer="$(_call DELETE "/v1/tenants/${t}/exposures/${inst}/${entry}")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
        echo "${inst}/${entry} is not approved for ${t}; nothing was committed."
        return 0
    fi
    echo "Withdrawn ${inst}/${entry} of ${t}: committed ($(_committed "${answer}")). Once the cluster has taken that in,"
    echo "a public address stops answering, and an entry behind sign-in has its Authorization header removed again."
}

# exposures alias: give one published entry a second address directly under
# the cluster's own domain (statistics.<cluster> for an entry that answers at
# statistics.<tenant>.<cluster>), or take it away.
# One request to the director (PUT or DELETE /v1/clusters/<c>/tenants/<t>/
# exposures/<app instance>/<entry>/alias), which decides who may: whoever may
# configure the cluster, since a name under its domain is the cluster's to
# give. It adds nothing to what is public -- the tenant's approver publishes
# the entry first -- so it is not asked twice.
cmd_exposures_alias() {
    local inst="" entry="" t="" host="" remove="" answer usage_text
    usage_text="usage: kubectl gentian exposures alias <app-instance> <entry> --tenant <tenant> (--host <name>.<cluster's domain> | --remove)"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:?}"; shift 2 ;;
            --host) host="${2:?}"; shift 2 ;;
            --remove) remove=1; shift ;;
            -*) die "unknown option $1" ;;
            *)
                if [[ -z "${inst}" ]]; then inst="$1"
                elif [[ -z "${entry}" ]]; then entry="$1"
                else die "unexpected argument $1"
                fi
                shift ;;
        esac
    done
    [[ -n "${inst}" && -n "${entry}" ]] || die "${usage_text}"
    [[ -n "${t}" ]] || die "--tenant is required"
    [[ -n "${host}" || -n "${remove}" ]] || die "${usage_text}"
    [[ -z "${host}" || -z "${remove}" ]] || die "--host and --remove are two different things; give one"
    _label "a tenant" "${t}"
    _label "an app instance" "${inst}"
    _label "an entry" "${entry}"
    need curl jq
    _connect
    if [[ -n "${remove}" ]]; then
        answer="$(_call DELETE "/v1/clusters/${_CLUSTER}/tenants/${t}/exposures/${inst}/${entry}/alias")" || exit 1
        if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
            echo "${inst}/${entry} of ${t} has no alias; nothing was committed."
            return 0
        fi
        echo "${inst}/${entry} of ${t} has no alias any more: committed ($(_committed "${answer}")). It stays at its own address."
        return 0
    fi
    answer="$(_call PUT "/v1/clusters/${_CLUSTER}/tenants/${t}/exposures/${inst}/${entry}/alias" \
        "$(jq -n --arg h "${host}" '{host: $h}')")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
        echo "${inst}/${entry} of ${t} already answers at ${host}; nothing was committed."
        return 0
    fi
    echo "${inst}/${entry} of ${t} also answers at ${host}: committed ($(_committed "${answer}"))."
    echo "Once the cluster has taken that in, the same paths are served there, held to the same limits."
    echo "The name has to resolve to this cluster: the platform publishes a record for it where it publishes"
    echo "the cluster's others, and where it does not, the record is yours to make."
}

# exposures requests: every entry an app installed in the tenant declares for
# the internet, as the director reads it from the app's profile -- the
# address it would be published at, its paths, whether anybody signs in --
# and whether it was approved. REQUESTED is declared and published nowhere
# until somebody approves it. UNMATCHED is in the registry and matches no
# entry of an installed app: nothing is published for it.
#
# The same list carries the one request that is no public address: an entry
# behind sign-in that asks to keep the app's own Authorization header. KIND
# says which an entry is, in the director's words.
cmd_exposures_requests() {
    local t answer
    t="$(_tenant_flag "$@")"
    _label "a tenant" "${t}"
    need jq
    answer="$(_call GET "/v1/tenants/${t}/exposures")" || exit 1
    printf '%s' "${answer}" | jq -e 'has("entries")' >/dev/null ||
        die "this director does not say what a tenant's apps ask to publish: it is older than this command"
    if [[ "$(printf '%s' "${answer}" | jq -r '.entries | length')" == "0" ]]; then
        echo "No app installed in tenant ${t} asks to have anything on the internet, or to keep its own Authorization header behind sign-in."
        return 0
    fi
    printf '%s' "${answer}" | jq -r '
        def day: if (. // "") == "" then "-" else .[0:10] end;
        def state: {"requested": "requested", "approved": "approved", "reviewDue": "review due",
                    "expired": "expired", "unmatched": "unmatched"}[.state] // .state;
        def kind: .kindLabel // (if (.kind // "") == "" then "Public address" else .kind end);
        def signin: if (.authMode // "") == "" then "-"
            elif .publicAddress == false then "required"
            elif .anyoneWithoutSignIn then "none: anyone"
            else "none: the app checks the credential" end;
        (["APP INSTANCE","ENTRY","KIND","STATE","ADDRESS","PATHS","SIGN-IN","APPROVED BY","REVIEW","EXPIRES"] | @tsv),
        (.entries[] | [.install, .exposureName, kind, state,
            (if (.host // "") == "" then "-" else "https://" + .host end),
            (if ((.paths // []) | length) == 0 then "-" else (.paths | join(" ")) end),
            signin,
            (.approval.owner // "-"), (.approval.reviewAt | day), (.approval.expiresAt | day)] | @tsv)' |
        column -t -s $'\t'
    # Why an entry has no address, or matches nothing, in the director's words.
    printf '%s' "${answer}" | jq -r '.entries[] | select((.note // "") != "") | "\n" + .install + "/" + .exposureName + ": " + .note'
    echo
    echo "Approve one with: kubectl gentian exposures approve <app-instance> <entry> --tenant ${t}"
}

# exposures approve: put one entry of an installed app on the internet, or
# look again at one that is (a review, and the way to change its expiry).
# Or, for an entry behind sign-in that asks for it, let the app keep its own
# Authorization header: that publishes nothing, and is said so.
#
# It is the perimeter approver's decision, so what is decided is shown first:
# the entry is read from the director, and its address, its paths and who can
# reach it are printed before anything is asked. What the director does not
# list is not asked for. The approval is confirmed by typing the entry, or
# with --yes.
#
# An entry for the cluster's main address is different in one way: the
# director's rule for a website there is printed in full, and the approval
# is sent only with --acknowledge-main-address-rule. --yes does not say it.
#
# One request (PUT /v1/tenants/<t>/exposures/<app instance>/<entry>); the
# director decides who may, and its refusals are printed as it worded them.
cmd_exposures_approve() {
    local inst="" entry="" t="" expires="" reason="" ack="" yes="" typed="" usage_text
    usage_text="usage: kubectl gentian exposures approve <app-instance> <entry> --tenant <tenant> [--expires <date>] [--reason <text>] [--acknowledge-main-address-rule] [--yes]"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:?}"; shift 2 ;;
            --expires) expires="${2:?}"; shift 2 ;;
            --reason) reason="${2:?}"; shift 2 ;;
            --acknowledge-main-address-rule) ack=1; shift ;;
            --yes) yes=1; shift ;;
            -*) die "unknown option $1" ;;
            *)
                if [[ -z "${inst}" ]]; then inst="$1"
                elif [[ -z "${entry}" ]]; then entry="$1"
                else die "unexpected argument $1"
                fi
                shift ;;
        esac
    done
    [[ -n "${inst}" && -n "${entry}" ]] || die "${usage_text}"
    [[ -n "${t}" ]] || die "--tenant is required"
    _label "a tenant" "${t}"
    _label "an app instance" "${inst}"
    _label "an entry" "${entry}"
    # A day is the end of that day, UTC; anything else is the director's to
    # read, and what is sent is what is shown.
    if [[ "${expires}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        expires="${expires}T23:59:59Z"
    fi
    if [[ -z "${yes}" ]]; then
        [[ -t 0 ]] || die "not a terminal: confirm with --yes"
    fi
    need jq
    local answer asked state host public kind
    answer="$(_call GET "/v1/tenants/${t}/exposures")" || exit 1
    printf '%s' "${answer}" | jq -e 'has("entries")' >/dev/null ||
        die "this director does not say what an entry would put on the internet: it is older than this command. Nothing was sent"
    asked="$(printf '%s' "${answer}" | jq -c --arg i "${inst}" --arg e "${entry}" \
        '[.entries[] | select(.install == $i and .exposureName == $e and .state != "unmatched")][0] // empty')"
    [[ -n "${asked}" ]] ||
        die "the director lists no request ${inst}/${entry} for tenant ${t}: no app installed there declares it as something an approver decides. 'kubectl gentian exposures requests --tenant ${t}' shows what its apps ask for. Nothing was sent"
    state="$(printf '%s' "${asked}" | jq -r '.state')"
    host="$(printf '%s' "${asked}" | jq -r '.host // ""')"
    # An older director names no kinds: everything it lists is a public address.
    public="$(printf '%s' "${asked}" | jq -r 'if .publicAddress == false then "" else "yes" end')"
    kind="$(printf '%s' "${asked}" | jq -r '.kind // ""')"

    if [[ "$(printf '%s' "${asked}" | jq -r '.authMode // ""')" == "" ]]; then
        # An entry the director can name and not describe: the platform's own
        # page, which the installer published. Only its review is asked.
        echo "Reviewing ${inst}/${entry} of tenant ${t}. The director cannot show what it publishes:"
        printf '%s' "${asked}" | jq -r '"  " + (.note // "no reason given")'
    elif [[ -z "${public}" ]]; then
        if [[ "${state}" == "requested" ]]; then
            echo "Approving ${inst}/${entry} for tenant ${t} puts NOTHING on the internet. It changes this, behind sign-in:"
        else
            echo "${inst}/${entry} of tenant ${t} is approved already; approving it again is a review. Nothing of it is on the internet. Behind sign-in, it has this:"
        fi
        printf '%s' "${asked}" | jq -r '
            "  kind:     " + (.kindLabel // .kind),
            "  address:  " + (if (.host // "") == "" then "(this cluster declares no domain)" else "https://" + .host end),
            "  paths:    " + ((.paths // []) | join("  ")),
            "  what:     " + .access'
    elif [[ -z "${host}" ]]; then
        die "${inst}/${entry} would be published nowhere: $(printf '%s' "${asked}" | jq -r '.note // "the director gives no address for it"'). Nothing was sent"
    else
        if [[ "${state}" == "requested" ]]; then
            echo "Approving ${inst}/${entry} for tenant ${t} puts this on the internet:"
        else
            echo "${inst}/${entry} of tenant ${t} is approved already; approving it again is a review. It has this on the internet:"
        fi
        printf '%s' "${asked}" | jq -r '
            "  address:  https://" + .host,
            "  paths:    " + (.paths | join("  ")) + (if (.paths | index("/")) != null then "   (the whole address)" else "   (nothing else at that address is published)" end),
            (if ((.denyPaths // []) | length) > 0 then "  refused:  " + (.denyPaths | join("  ")) + "   (never published, also below a path above)" else empty end),
            "  kind:     " + (.kindLabel // "Public address"),
            "  access:   " + .access,
            (if (.rateLimit // "") == "" then empty else "  limit:    " + .rateLimit end)'
    fi
    if [[ -n "${expires}" ]]; then
        echo "  expires:  ${expires}; the approval ends then"
    else
        echo "  expires:  never; it stays until it is withdrawn"
    fi
    echo "  review:   a year from now at the latest, or at its expiry if that is sooner"
    [[ -z "${reason}" ]] || echo "  reason:   ${reason}"
    if [[ "${state}" != "requested" ]]; then
        printf '%s' "${asked}" | jq -r '
            def day: if (. // "") == "" then "-" else .[0:10] end;
            "  so far:   approved by " + (.approval.owner // "-") + " on " + (.approval.publishedAt | day)
            + ", review " + (.approval.reviewAt | day) + ", expires " + (.approval.expiresAt | day)
            + ". The expiry and the reason above replace the ones it has."'
    fi

    local main
    main="$(printf '%s' "${asked}" | jq -r 'if .mainAddress then "yes" else "" end')"
    if [[ -n "${main}" ]]; then
        echo
        echo "This entry is for the cluster's MAIN ADDRESS. What the director says of a website there:"
        echo
        printf '%s' "${asked}" | jq -r '.mainAddressRule // "(the director sent no rule)"' | fold -s -w 96 | sed -e 's/ *$//' -e 's/^/  /'
        echo
        [[ -n "${ack}" ]] ||
            die "a website on the main address is approved only with --acknowledge-main-address-rule, which says the rule above is true of this site; your name and the time are recorded with the entry. Nothing was sent"
        echo "--acknowledge-main-address-rule: you say this is true of the site. Your name and the time are recorded."
    elif [[ -n "${ack}" ]]; then
        die "--acknowledge-main-address-rule is for an entry on the cluster's main address, and ${inst}/${entry} is not one. Nothing was sent"
    fi

    if [[ -z "${yes}" ]]; then
        read -r -p "Type ${inst}/${entry} to confirm: " typed
        [[ "${typed}" == "${inst}/${entry}" ]] || die "not confirmed; nothing was changed"
    fi
    local body
    # The kind that was shown goes with the approval, so the director refuses
    # it if the app's entry has come to ask for something else meanwhile.
    body="$(jq -cn --arg r "${reason}" --arg x "${expires}" --arg m "${main}" --arg k "${kind}" '
        (if $r == "" then {} else {reason: $r} end)
        + (if $k == "" then {} else {kind: $k} end)
        + (if $x == "" then {} else {expiresAt: $x} end)
        + (if $m == "" then {} else {apex: true, acknowledgeMainAddressRule: true} end)')"
    answer="$(_call PUT "/v1/tenants/${t}/exposures/${inst}/${entry}" "${body}")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
        echo "${inst}/${entry} of ${t} is approved on these terms already; nothing was committed."
        return 0
    fi
    if [[ -z "${public}" ]]; then
        echo "Approved ${inst}/${entry} of ${t}: committed ($(_committed "${answer}")). Nothing is published. Once the"
        echo "cluster has taken that in, the app's own Authorization header is kept on that address behind sign-in."
    else
        echo "Approved ${inst}/${entry} of ${t}: committed ($(_committed "${answer}")). The platform publishes it once the"
        echo "cluster has taken that in."
    fi
    echo "'kubectl gentian exposures requests --tenant ${t}' shows its review date."
}

cmd_exposures() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        list) cmd_exposures_list "$@" ;;
        requests) cmd_exposures_requests "$@" ;;
        approve) cmd_exposures_approve "$@" ;;
        withdraw) cmd_exposures_withdraw "$@" ;;
        alias) cmd_exposures_alias "$@" ;;
        *) die "usage: kubectl gentian exposures requests|approve|list|withdraw|alias ..." ;;
    esac
}

# apps outdated: which installed apps are behind the build their catalog
# offers, and what keeps them there (the director's report). For the whole
# cluster, or one tenant with --tenant.
cmd_apps_outdated() {
    local t="" a json=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:?}"; shift 2 ;;
            --json) json=1; shift ;;
            *) shift ;;
        esac
    done
    need jq
    _connect
    local answer
    if [[ -n "${t}" ]]; then
        answer="$(_call GET "/v1/tenants/${t}/updates")" || exit 1
    else
        answer="$(_call GET "/v1/clusters/${_CLUSTER}/updates")" || exit 1
    fi
    if [[ -n "${json}" ]]; then printf '%s\n' "${answer}"; return 0; fi
    jq -r '
        (["TENANT","APP","MODE","PINNED","RUNNING","NEWEST","STATE"] | @tsv),
        (.entries[] | [.tenant, .profile, (.mode + " (" + .modeFrom + ")"),
            (if .pinned == "" then "-" else .pinned[0:19] end),
            (if (.running // "") == "" then "-" else .running[0:19] end),
            (if (.newest // "") == "" then "-" else (.newest[0:19] + (if .newestVersion then " " + .newestVersion else "" end)) end),
            (if .unmet then "cannot: " + .unmet
             elif .outdated and ((.held // []) | length) > 0 then "outdated, held: " + ((.held // []) | join("; "))
             elif .outdated then "outdated"
             elif (.rollout.phase // "") == "Exporting" or (.rollout.phase // "") == "Rolling" then "moving"
             elif (.rollout.phase // "") == "RolledBack" then "rolled back: " + (.rollout.message // .rollout.reason // "")
             elif (.rollout.phase // "") == "Failed" then "move failed: " + (.rollout.message // .rollout.reason // "")
             else "current" end)] | @tsv)' <<<"${answer}" | column -t -s $'\t'
    # A move to the pinned build that ended badly is tried again by
    # installing that build again; a build that keeps failing is never
    # retried by the platform on its own.
    jq -r '.entries[] | select(((.rollout.phase // "") == "RolledBack" or (.rollout.phase // "") == "Failed") and .rollout.target == .pinned)
        | "kubectl gentian apps install " + .profile + " --tenant " + .tenant
          + (if (.newest // "") != "" and .newest != .pinned then " --digest " + .pinned else "" end)
          + " retries the move to " + .pinned[0:19]' <<<"${answer}"
    local partial unread
    partial="$(jq -r '.partial // empty' <<<"${answer}")"
    [[ -z "${partial}" ]] || echo "Partial: ${partial}" >&2
    unread="$(jq -r '(.unread // []) | join(", ")' <<<"${answer}")"
    [[ -z "${unread}" ]] || echo "Not read, the director could not reach them: ${unread}." >&2
    if [[ -z "${t}" ]]; then
        jq -r '"Policy: mode " + .policy.mode + (if .policy.window then " in the window " + .policy.window.start + "-" + .policy.window.end + " " + (.policy.window.timezone // "UTC") else ", any time" end) + (if .windowOpen then " (open now)" else " (closed now)" end)' <<<"${answer}"
    fi
}

# apps move-outdated: move every outdated app -- or those of --tenant and
# --app -- to the newest build its catalog offers, and try once more every
# move to a pinned build that was rolled back or did not start. The cluster
# administrator's act; each move exports first, verifies after and rolls back
# by itself (kubectl gentian apps outdated shows how each went).
cmd_apps_move_outdated() {
    local t="" app="" a
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:?}"; shift 2 ;;
            --app) app="${2:?}"; shift 2 ;;
            *) shift ;;
        esac
    done
    need jq
    _connect
    local body answer
    body="$(jq -n --arg t "${t}" --arg a "${app}" '{tenants: (if $t == "" then [] else [$t] end), apps: (if $a == "" then [] else [$a] end)}')"
    answer="$(_call POST "/v1/clusters/${_CLUSTER}/actions/move-outdated" "${body}")" || exit 1
    jq -r '(.moved[] | if .status == "retried"
               then "Retrying " + .profile + " in " + .tenant + " at " + .to[0:19] + ": " + (.message // "") + (if (.detail // "") != "" then " (" + .detail + ")" else "" end)
               else "Moving " + .profile + " in " + .tenant + " to " + .to[0:19] + ": " + .status + (if (.detail // "") != "" then " (" + .detail + ")" else "" end) end),
           (.skipped[] | "Not moved: " + .profile + " in " + .tenant + ": " + .status + (if .detail then " -- " + .detail else "" end))' <<<"${answer}"
    [[ "$(jq -r '.moved | length' <<<"${answer}")" != "0" ]] || echo "Nothing to move."
}

# apps update-mode <app> --tenant <t> --mode latest|manual|tenant|default:
# how one tenant's app moves to newer builds, set by the cluster's
# administrator. "default" removes the override and the cluster's policy
# applies again.
cmd_apps_update_mode() {
    local app="${1:-}"
    [[ -n "${app}" && "${app}" != -* ]] || die "usage: kubectl gentian apps update-mode <app> --tenant <tenant> --mode latest|manual|tenant|default"
    shift
    local t mode="" a
    t="$(_tenant_flag "$@")"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --mode) mode="${2:?}"; shift 2 ;;
            *) shift ;;
        esac
    done
    case "${mode}" in
        latest|manual|tenant) ;;
        default) mode="" ;;
        *) die "--mode is latest, manual, tenant or default" ;;
    esac
    need jq
    _connect
    local answer
    answer="$(_call PUT "/v1/clusters/${_CLUSTER}/tenants/${t}/apps/${app}/update-mode" "$(jq -n --arg m "${mode}" '{mode: $m}')")" || exit 1
    if [[ -n "${mode}" ]]; then
        echo "${app} in ${t} moves to newer builds in ${mode} mode: $(jq -r '.status' <<<"${answer}")."
    else
        echo "${app} in ${t} moves to newer builds as the cluster's policy says: $(jq -r '.status' <<<"${answer}")."
    fi
}

cmd_apps() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        list) cmd_apps_list "$@" ;;
        outdated) cmd_apps_outdated "$@" ;;
        move-outdated) cmd_apps_move_outdated "$@" ;;
        update-mode) cmd_apps_update_mode "$@" ;;
        install|uninstall)
            local app="${1:-}"
            [[ -n "${app}" && "${app}" != -* ]] || die "usage: kubectl gentian apps ${sub} <app> --tenant <tenant>"
            shift
            local t purge="false" everyone="false" a
            t="$(_tenant_flag "$@")"
            for a in "$@"; do
                [[ "${a}" == "--purge" ]] && purge="true"
                [[ "${a}" == "--for-everyone" ]] && everyone="true"
            done
            [[ "${everyone}" == "false" || "${sub}" == "install" ]] || die "--for-everyone goes with install"
            if [[ "${sub}" == "install" ]]; then
                # --for-everyone is part of the install, in the same commit:
                # every member has the app by default, granted once its group
                # exists.
                _apps_install "${app}" "${t}" "${everyone}" "$@"
            elif [[ "${purge}" == "true" ]]; then
                # Two acts, in order: uninstall, which keeps the data, and
                # then the purge, which destroys it and is refused until the
                # app is gone from the cluster.
                local answer
                answer="$(_call DELETE "/v1/tenants/${t}/apps/${app}")"
                if [[ -n "$(jq -r '.commit // empty' <<<"${answer}" 2>/dev/null || true)" ]]; then
                    echo "Uninstalling ${app} from ${t}: committed; the platform removes it. Its data is still there."
                else
                    echo "${app} is not installed in ${t}: nothing to uninstall."
                fi
                _purge_app_when_gone "${t}" "${app}"
            else
                _call DELETE "/v1/tenants/${t}/apps/${app}" >/dev/null
                echo "Uninstalling ${app} from ${t}: committed; the platform removes it. Its data is retained:"
                echo "installing ${app} again finds it, and 'kubectl gentian apps uninstall ${app} --tenant ${t} --purge' destroys it."
            fi
            ;;
        approve) cmd_apps_approve "$@" ;;
        decline) cmd_apps_decline "$@" ;;
        *) die "usage: kubectl gentian apps list|install|uninstall|approve|decline ..." ;;
    esac
}

# kubectl gentian apps approve <app> [<kind>/<name>] --tenant <t> --reason "<why>" [--expires <RFC 3339>]
#
# An app whose profile asks for more than the default posture waits until a
# person answers each request (the Component reads "waiting for approval of
# <kind>/<name>"). This is the answer: one commit through the director, with
# the approver taken from the session and the reason in their words. Who may
# answer is the director's to decide by the kind: an egress request is the
# tenant administrator's, a podSecurity or clusterRoles one the cluster's
# security officer's. Without a request named, it lists what the app is
# waiting for, as the cluster has it.
cmd_apps_approve() {
    local usage_text app="" privilege="" reason="" expires="" t answer kind name
    usage_text='usage: kubectl gentian apps approve <app> --tenant <tenant>
       kubectl gentian apps approve <app> <kind>/<name> --tenant <tenant> --reason "<why>" [--expires <RFC 3339>]'
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:-}"; shift 2 || die "--tenant needs a value" ;;
            --reason) reason="${2:-}"; shift 2 || die "--reason needs a value" ;;
            --expires) expires="${2:-}"; shift 2 || die "--expires needs a value" ;;
            -*) die "unknown option $1" ;;
            *)
                if [[ -z "${app}" ]]; then app="$1"
                elif [[ -z "${privilege}" ]]; then privilege="$1"
                else die "unexpected argument $1"
                fi
                shift ;;
        esac
    done
    [[ -n "${app}" && -n "${t:-}" ]] || die "${usage_text}"
    _label "an app" "${app}"
    _label "a tenant" "${t}"
    need curl jq

    if [[ -z "${privilege}" ]]; then
        answer="$(_call_usher GET "/v1/tenants/${t}/apps/status")" || exit 1
        local pending
        pending="$(jq -r --arg a "${app}" '.apps[]? | select(.name == $a or .profile == $a) | .pendingPrivileges[]?' <<<"${answer}")"
        if [[ -z "${pending}" ]]; then
            echo "${app} in ${t} is waiting for no approval."
            return 0
        fi
        echo "${app} in ${t} is waiting for these approvals:"
        local p
        while IFS= read -r p; do printf '  %s\n' "${p}"; done <<<"${pending}"
        echo "Approve one with:"
        echo "  kubectl gentian apps approve ${app} <kind>/<name> --tenant ${t} --reason \"<why, in your words>\""
        return 0
    fi

    _privilege_ref "${privilege}"
    kind="${PRIV_KIND}"
    name="${PRIV_NAME}"
    reason="$(printf '%s' "${reason}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    (( ${#reason} >= 10 )) || die "--reason is required: at least ten characters, in your own words. It is what a reviewer reads in the commit."

    answer="$(_call PUT "/v1/tenants/${t}/privileges/${app}/${kind}/${name}" \
        "$(jq -n --arg r "${reason}" --arg e "${expires}" '{reason: $r} + (if $e == "" then {} else {expiresAt: $e} end)')")" || exit 1
    if [[ "$(jq -r '.status // ""' <<<"${answer}")" == "unchanged" ]]; then
        echo "${privilege} of ${app} in ${t} is approved already; nothing was committed."
        return 0
    fi
    echo "Approved ${privilege} for ${app} in ${t}: committed ($(_committed "${answer}")). The app goes on once the platform has it."
}

# _privilege_ref <kind>/<name> -- checks the request's shape and names the
# two parts in PRIV_KIND and PRIV_NAME.
_privilege_ref() {
    local privilege="$1"
    PRIV_KIND="${privilege%%/*}"
    PRIV_NAME="${privilege#*/}"
    case "${PRIV_KIND}" in
        egress|podSecurity|clusterRoles) ;;
        *) die "the request is <kind>/<name>, the kind one of egress, podSecurity or clusterRoles: not '${privilege}'" ;;
    esac
    [[ "${privilege}" == */* && -n "${PRIV_NAME}" && "${PRIV_NAME}" != */* ]] ||
        die "the request is <kind>/<name>, as the app's state names it: not '${privilege}'"
    _label "a request" "${PRIV_NAME}"
}

# kubectl gentian apps decline <app> <kind>/<name> --tenant <t> --reason "<why>"
#
# The approver's no. Whoever may approve a request of the kind may decline
# it -- the director checks the same right -- and nobody else. Nothing is
# committed: a decline changes nothing the platform gives the app, so the
# request stays pending and the app keeps waiting. The operator records who
# declined, when and why on the app's Component, which the tenant's console
# and the App Store's install step show, with the way to ask again. An
# approval made later stands, and clears the decline.
cmd_apps_decline() {
    local usage_text app="" privilege="" reason="" t answer
    usage_text='usage: kubectl gentian apps decline <app> <kind>/<name> --tenant <tenant> --reason "<why>"'
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:-}"; shift 2 || die "--tenant needs a value" ;;
            --reason) reason="${2:-}"; shift 2 || die "--reason needs a value" ;;
            -*) die "unknown option $1" ;;
            *)
                if [[ -z "${app}" ]]; then app="$1"
                elif [[ -z "${privilege}" ]]; then privilege="$1"
                else die "unexpected argument $1"
                fi
                shift ;;
        esac
    done
    [[ -n "${app}" && -n "${privilege}" && -n "${t:-}" ]] || die "${usage_text}"
    _label "an app" "${app}"
    _label "a tenant" "${t}"
    _privilege_ref "${privilege}"
    reason="$(printf '%s' "${reason}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    (( ${#reason} >= 10 )) || die "--reason is required: at least ten characters, in your own words. It is what the person who asked reads."
    need curl jq

    answer="$(_call POST "/v1/tenants/${t}/apps/${app}/actions/decline-privilege" \
        "$(jq -n --arg p "${privilege}" --arg r "${reason}" '{privilege: $p, reason: $r}')")" || exit 1
    echo "Declined ${privilege} for ${app} in ${t}: recorded, nothing committed. The app keeps waiting; the tenant sees your reason and may ask again."
}

# kubectl gentian credentials list [--tenant <t>]
# kubectl gentian credentials set <name> --field <key>=@<file> [--field <key>=-] ...
#
# What a person supplies -- a registry's token, an app's API keys -- is set at
# the custodian, which checks each value against what the requirement
# declares (a stray newline is refused, not stored) and writes it to the vault
# with the person's own authority. A value never appears on the command line:
# it is read from a file (@path) or from standard input (-), so it stays out
# of the shell's history and the process list. Every field the requirement
# declares is given at once, as the Admin Console does.
cmd_credentials() {
    local sub="${1:-}" t="" name="" answer
    shift || true
    case "${sub}" in
        list)
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --tenant|-t) t="${2:-}"; shift 2 || die "--tenant needs a value" ;;
                    *) die "usage: kubectl gentian credentials list [--tenant <tenant>]" ;;
                esac
            done
            need curl jq
            answer="$(_call_custodian GET /v1/credentials)" || exit 1
            jq -r --arg t "${t}" '(["NAME","TENANT","SET","FIELDS"] | @tsv),
                (.credentials[]? | select($t == "" or .tenant == $t)
                 | [.name, (.tenant // "-"), (if .satisfied then "yes" else "no" end),
                    ([.fields[]?.key] | join(","))] | @tsv)' <<<"${answer}" | column -t -s $'\t'
            ;;
        set)
            name="${1:-}"
            [[ -n "${name}" && "${name}" != -* ]] || die "usage: kubectl gentian credentials set <name> --field <key>=@<file> [--field <key>=-]"
            shift
            local fields='{}' spec key src value stdin_used=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --field)
                        spec="${2:-}"
                        shift 2 || die "--field needs <key>=@<file> or <key>=-"
                        [[ "${spec}" == *=* ]] || die "--field is <key>=@<file> or <key>=-, not '${spec}'"
                        key="${spec%%=*}"
                        src="${spec#*=}"
                        [[ "${key}" =~ ^[A-Za-z0-9_.-]+$ ]] || die "'${key}' is not a field name"
                        case "${src}" in
                            -)
                                [[ -z "${stdin_used}" ]] || die "only one field can be read from standard input"
                                stdin_used=1
                                value="$(cat)" ;;
                            @*)
                                [[ -r "${src#@}" ]] || die "cannot read ${src#@}"
                                value="$(cat -- "${src#@}")" ;;
                            *) die "a value is given as @<file> or -, never on the command line: --field ${key}=@<file>" ;;
                        esac
                        # A file ends in a newline more often than not, and the
                        # custodian refuses a value that does: the last one goes.
                        value="${value%$'\n'}"
                        fields="$(jq -c --arg k "${key}" --arg v "${value}" '. + {($k): $v}' <<<"${fields}")"
                        ;;
                    *) die "unexpected argument $1" ;;
                esac
            done
            [[ "${fields}" != "{}" ]] || die "give every field of ${name}: --field <key>=@<file>"
            need curl jq
            answer="$(_call_custodian PUT "/v1/credentials/${name}" "$(jq -c '{fields: .}' <<<"${fields}")")" || exit 1
            echo "Set ${name}: stored$(jq -r 'if .validated == false then " without validation (" + (.validationSkipped // "") + ")" elif .validated == true then " and validated" else "" end' <<<"${answer}" 2>/dev/null)."
            ;;
        *) die "usage: kubectl gentian credentials list|set ..." ;;
    esac
}

cmd_resources() {
    local sub="${1:-}"
    shift || true
    local t
    case "${sub}" in
        plans)
            t="$(_tenant_flag "$@")"
            _call_usher GET "/v1/tenants/${t}/resources/plans" |
                jq -r '(["","PLAN","CPU","MEMORY","STORAGE"] | @tsv), (.plans[] | [(if .current then "*" else "" end), .name, (.quotas.requestsCpu // "-"), (.quotas.requestsMemory // "-"), (.quotas.storage // "-")] | @tsv)' |
                column -t -s $'\t'
            ;;
        show)
            t="$(_tenant_flag "$@")"
            _call_usher GET "/v1/tenants/${t}/resources" | jq .
            ;;
        set)
            t="$(_tenant_flag "$@")"
            local plan="" force="false"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --plan|-p) plan="${2:?}"; shift 2 ;;
                    --force) force="true"; shift ;;
                    *) shift ;;
                esac
            done
            [[ -n "${plan}" ]] || die "--plan is required"
            _call PUT "/v1/tenants/${t}/resources" "$(jq -n --arg p "${plan}" --argjson f "${force}" '{plan:$p, force:$f}')" >/dev/null
            echo "Plan ${plan} chosen for ${t}: committed."
            ;;
        report)
            t="$(_tenant_flag "$@")"
            local from="" to=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --from) from="${2:?}"; shift 2 ;;
                    --to) to="${2:?}"; shift 2 ;;
                    *) shift ;;
                esac
            done
            [[ -n "${from}" && -n "${to}" ]] || die "--from and --to are required (RFC 3339)"
            _call_usher GET "/v1/tenants/${t}/resources/report?from=$(jq -rn --arg v "${from}" '$v|@uri')&to=$(jq -rn --arg v "${to}" '$v|@uri')" |
                jq -r 'if .incomplete then "Nothing is known about the plan in force when this window opened; the first interval starts later.\n" else "" end,
                       (["PLAN","DAYS","FROM","TO","SKU"] | @tsv),
                       ((.intervals // [])[] | [.plan, ((.seconds / 86400) * 100 | round / 100 | tostring), .from[0:19], .to[0:19], (.productSku // "")] | @tsv)' |
                column -t -s $'\t'
            ;;
        *) die "usage: kubectl gentian resources plans|show|set|report --tenant <tenant>" ;;
    esac
}

# usage — the header comment above, which is the reference.
usage() {
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
}

# kubectl gentian approvals list
#
# What waits for an approver: every tenant's pending privilege, as the cluster
# has it, with who answers it -- the security officer for a podSecurity
# waiver or a cluster role, the perimeter approver for egress. The usher's
# list, read by whoever holds cluster#can_approve, can_approve_perimeter or
# can_configure. Each line says who asked, when, and what the app's profile
# gives as its reason, and whether it was declined and by whom; the answer is
# `apps approve` or `apps decline`, whose by the kind.
cmd_approvals_list() {
    local answer
    need jq
    _discover
    answer="$(_call_usher GET "/v1/clusters/${_CLUSTER}/approvals")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.approvals | length')" == "0" ]]; then
        echo "Nothing awaits an approver: no app of any tenant waits for a privilege."
        return 0
    fi
    printf '%s' "${answer}" | jq -r '
        (["TENANT","APP","PRIVILEGE","APPROVER","REQUESTED BY","REQUESTED","EXPIRED","DECLINED BY"] | @tsv),
        (.approvals[] | [
            .tenant, .install, .privilege, (.approvedBy // "-"),
            (.requestedBy // "-"),
            (.requestedAt // "" | if . == "" then "-" else .[0:16] end),
            (.expiredAt // "" | if . == "" then "-" else .[0:10] end),
            (.declinedBy // "-")
        ] | @tsv)' | column -t -s $'\t'
    echo
    printf '%s' "${answer}" | jq -r '.approvals[] |
        "  " + .tenant + "/" + .install + " " + .privilege + ": "
        + (if (.reason // "") != "" then .reason else "the profile gives no reason" end)
        + (if (.note // "") != "" then "; " + .requestedBy + " adds: " + .note else "" end)
        + (if (.declinedBy // "") != "" then "; declined by " + .declinedBy + " on " + (.declinedAt // "")[0:10] + ": " + (.declineReason // "") else "" end)'
    echo
    echo "Approve one with: kubectl gentian apps approve <app> <kind>/<name> --tenant <tenant> --reason \"<why, in your words>\" [--expires <RFC 3339>]"
    echo "Decline one with: kubectl gentian apps decline <app> <kind>/<name> --tenant <tenant> --reason \"<why, in your words>\""
}

# Every tenant's approved privilege exceptions, as git has them, from the
# director.
cmd_approvals_granted() {
    [[ $# -eq 0 ]] || die "usage: kubectl gentian approvals granted"
    need jq
    _discover
    local answer
    answer="$(_call GET "/v1/clusters/${_CLUSTER}/privileges")" || exit 1
    if [[ "$(jq '.privileges | length' <<<"${answer}")" == "0" ]]; then
        echo "No tenant of this cluster has an approved privilege exception."
        return 0
    fi
    jq -r '(["TENANT","APP","PRIVILEGE","APPROVED BY","APPROVED","EXPIRES","REASON"] | @tsv),
        (.privileges[] | [.tenant, .install, .privilege, .approver, (.approvedAt // "" | .[0:10]),
            (.expiresAt // "" | if . == "" then "-" else .[0:10] end), .reason] | @tsv)' <<<"${answer}" |
        column -t -s $'\t'
}

cmd_approvals() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        list) cmd_approvals_list "$@" ;;
        granted) cmd_approvals_granted "$@" ;;
        *) die "usage: kubectl gentian approvals list|granted" ;;
    esac
}

main() {
    local cmd="${1:-help}"
    shift || true
    case "${cmd}" in
        login) cmd_login ;;
        logout) cmd_logout ;;
        whoami) cmd_whoami ;;
        tenant|tenants)
            local sub="${1:-}"
            shift || true
            case "${sub}" in
                list) cmd_tenants_list ;;
                show) cmd_tenants_show "$@" ;;
                set) cmd_tenants_set "$@" ;;
                create) cmd_tenants_create "$@" ;;
                activate-admin) cmd_tenants_activate_admin "$@" ;;
                retire) cmd_tenants_retire "$@" ;;
                import) cmd_tenants_import "$@" ;;
                delegate-catalogues) cmd_tenants_delegate_catalogues "$@" ;;
                domain) cmd_tenants_domain "$@" ;;
                mail-mode) cmd_tenants_mail_mode "$@" ;;
                partners) cmd_tenants_partners "$@" ;;
                groups) cmd_tenants_groups "$@" ;;
                sign-in) cmd_tenants_sign_in "$@" ;;
                platform-access) cmd_tenants_platform_access "$@" ;;
                *) die "usage: kubectl gentian tenants list|show|create|set|activate-admin|retire|import|delegate-catalogues|domain|mail-mode|partners|groups|sign-in|platform-access" ;;
            esac
            ;;
        app|apps) cmd_apps "$@" ;;
        catalogue|catalogues) cmd_catalogues "$@" ;;
        repository|repositories) cmd_repositories "$@" ;;
        model|models) cmd_models "$@" ;;
        setting|settings) cmd_settings "$@" ;;
        platform-role|platform-roles) cmd_platform_roles "$@" ;;
        exposure|exposures) cmd_exposures "$@" ;;
        approval|approvals) cmd_approvals "$@" ;;
        resource|resources) cmd_resources "$@" ;;
        credential|credentials) cmd_credentials "$@" ;;
        version|--version|-v) cmd_version ;;
        help|--help|-h) usage ;;
        *) usage; exit 1 ;;
    esac
}

main "$@"
