#!/usr/bin/env bash
# kubectl-gentian — the command-line console for Gentian OS.
#
# A client of the director, like the admin console: every command signs in as
# the person running it and asks the director, which checks that person
# against the authorization graph, commits to git in their name, and records
# who asked. The one command about a person -- activating a tenant's
# administrator -- asks the registrar, which makes the same check and acts on
# the identity provider. Nothing here writes to git, reads OpenBao or applies
# manifests itself -- a tool that did would be a way around every check those
# two make.
#
# Usage:
#   kubectl gentian login                       sign in (a code to confirm in a browser)
#   kubectl gentian logout
#   kubectl gentian whoami
#
#   kubectl gentian tenants list
#   kubectl gentian tenants show <name>
#   kubectl gentian tenants create <name> [--display-name <text>] [--no-mfa]
#                                  [--admins-approve-public-addresses[=true|false]] [--admins-add-catalogues]
#                                  (unstated, approving is off -- and on for the user tenant
#                                  of a single-tenancy cluster)
#   kubectl gentian tenants set <name> [--admins-approve-public-addresses=true|false]
#                                      [--admins-add-catalogues=true|false]
#   kubectl gentian tenants activate-admin <name> [--recovery-email <address>]
#   kubectl gentian tenants retire <name> [--purge [--keep-bundles]] [--yes]
#   kubectl gentian tenants import <file.gentian> [--identity-file <f> | --passphrase] [--name <n>]
#   kubectl gentian tenants import --bucket <b> --prefix <p> [--endpoint <url>] (--identity-file <f> | --passphrase)
#   kubectl gentian tenants delegate-catalogues <name> on|off
#   kubectl gentian tenants domain <name>                      the domain of its own it is bound to
#   kubectl gentian tenants domain <name> <domain> [--yes]     bind it: its addresses move to <label>.<domain>
#                                                             (a cluster with many tenants only)
#   kubectl gentian tenants domain <name> --remove [--yes]     back to its default address
#
#   kubectl gentian catalogues list [--tenant <tenant>]
#   kubectl gentian catalogues add <name> <https-url> [--tenant <tenant>]
#   kubectl gentian catalogues remove <name> [--tenant <tenant>]
#   kubectl gentian catalogues residue
#   kubectl gentian catalogues residue remove <kind>/<name> [--namespace <ns>] [--yes]
#
#   kubectl gentian apps list --tenant <tenant> [--available]
#   kubectl gentian apps install <app> --tenant <tenant> [--from <source>] [--digest sha256:<hex>] [--for-everyone]
#   kubectl gentian apps uninstall <app> --tenant <tenant> [--purge]
#
#   kubectl gentian exposures requests --tenant <tenant>        what its apps ask to have on the internet, or to keep
#                                                               of their own Authorization header behind sign-in
#   kubectl gentian exposures approve <app-instance> <entry> --tenant <tenant> [--expires <date>] [--reason <text>]
#                                     [--acknowledge-main-address-rule] [--yes]
#   kubectl gentian exposures list --tenant <tenant>            what the tenant has on the internet
#   kubectl gentian exposures withdraw <app-instance> <entry> --tenant <tenant>
#
#   kubectl gentian resources plans --tenant <tenant>
#   kubectl gentian resources show --tenant <tenant>
#   kubectl gentian resources set --tenant <tenant> --plan <plan>
#   kubectl gentian resources report --tenant <tenant> --from <time> --to <time>
#
#   kubectl gentian version
#
# Which cluster is the current kubectl context's. The director is found there
# (the Deployment labelled app.kubernetes.io/component=director) and reached
# through a port-forward for the length of one command; its own settings say
# which identity provider to sign in with and which cluster it serves. The
# registrar is found the same way, beside it, and the usher -- which answers
# what the cluster holds of a tenant right now -- by its own label.

set -euo pipefail

GENTIAN_PLUGIN_VERSION="0.5.0"

die() {
    echo "error: $*" >&2
    exit 1
}

need() {
    local c
    for c in "$@"; do
        command -v "${c}" >/dev/null 2>&1 || die "${c} is required"
    done
}

# gentian_plugin_fingerprint — sha256 of this file, short form, or "unknown".
#
# BASH_SOURCE[0] rather than $0, so it fingerprints the plugin itself when it is
# invoked through the gtnctl symlink or as `kubectl gentian`.
gentian_plugin_fingerprint() {
    local self="${BASH_SOURCE[0]}"
    local sum=""
    if command -v sha256sum >/dev/null 2>&1; then
        sum="$(sha256sum "${self}" 2>/dev/null | cut -c1-12)"
    elif command -v shasum >/dev/null 2>&1; then
        sum="$(shasum -a 256 "${self}" 2>/dev/null | cut -c1-12)"
    fi
    echo "${sum:-unknown}"
}

cmd_version() {
    echo "kubectl-gentian ${GENTIAN_PLUGIN_VERSION}"
    echo "  fingerprint : $(gentian_plugin_fingerprint)"
    echo "  path        : ${BASH_SOURCE[0]}"
}

# ---------------------------------------------------------------------------
# The director: where it is, and what it says about itself
# ---------------------------------------------------------------------------

_DIR_NS=""
_DIR_DEPLOY=""
_ISSUER=""
_CLUSTER=""

_discover() {
    [[ -n "${_DIR_NS}" ]] && return 0
    local line
    line="$(kubectl get deploy -A -l app.kubernetes.io/component=director \
        -o jsonpath='{range .items[*]}{.metadata.namespace} {.metadata.name}{"\n"}{end}' 2>/dev/null | head -1)"
    [[ -n "${line}" ]] || die "no director in the current kubectl context ($(kubectl config current-context 2>/dev/null || echo none))"
    _DIR_NS="${line%% *}"
    _DIR_DEPLOY="${line#* }"
    local env
    env="$(kubectl get deploy "${_DIR_DEPLOY}" -n "${_DIR_NS}" -o json)"
    local base
    base="$(printf '%s' "${env}" | jq -r '.spec.template.spec.containers[0].env[] | select(.name=="DIRECTOR_ISSUER_BASE_URL") | .value')"
    _CLUSTER="$(printf '%s' "${env}" | jq -r '.spec.template.spec.containers[0].env[] | select(.name=="GENTIAN_DEPLOYMENTS_CLUSTER_ID") | .value')"
    [[ -n "${base}" && -n "${_CLUSTER}" ]] || die "the director in ${_DIR_NS} does not say which issuer or cluster it serves"
    # The platform's administrators sign in through the kernel realm.
    _ISSUER="${base%/}/realms/${GENTIAN_REALM:-kernel}"
}

_TOKEN_FILE=""

_token_file() {
    _discover
    local dir="${HOME}/.gentian"
    mkdir -p "${dir}"
    chmod 700 "${dir}" 2>/dev/null || true
    _TOKEN_FILE="${dir}/cli-token-${_CLUSTER}.json"
}

# ---------------------------------------------------------------------------
# Signing in: the device flow, so a password is typed into the browser and
# never into this terminal
# ---------------------------------------------------------------------------

cmd_login() {
    need curl jq
    _token_file
    local start device user_code verify interval expires_in deadline answer err
    start="$(curl -sS --max-time 20 -d client_id=gentian-cli -d "scope=openid" \
        "${_ISSUER}/protocol/openid-connect/auth/device")"
    device="$(printf '%s' "${start}" | jq -r '.device_code // empty')"
    [[ -n "${device}" ]] || die "the identity provider started no sign-in: ${start}"
    user_code="$(printf '%s' "${start}" | jq -r '.user_code')"
    verify="$(printf '%s' "${start}" | jq -r '.verification_uri_complete // .verification_uri')"
    interval="$(printf '%s' "${start}" | jq -r '.interval // 5')"
    expires_in="$(printf '%s' "${start}" | jq -r '.expires_in // 600')"
    echo "Open this in a browser and confirm code ${user_code}:"
    echo "  ${verify}"
    deadline=$(( SECONDS + expires_in ))
    while (( SECONDS < deadline )); do
        sleep "${interval}"
        answer="$(curl -sS --max-time 20 -d client_id=gentian-cli \
            -d grant_type=urn:ietf:params:oauth:grant-type:device_code \
            --data-urlencode "device_code=${device}" \
            "${_ISSUER}/protocol/openid-connect/token")"
        err="$(printf '%s' "${answer}" | jq -r '.error // empty')"
        case "${err}" in
            "") _store_token "${answer}"; echo "Signed in."; return 0 ;;
            authorization_pending) continue ;;
            slow_down) interval=$(( interval + 5 )) ;;
            *) die "sign-in refused: $(printf '%s' "${answer}" | jq -r '.error_description // .error')" ;;
        esac
    done
    die "the code expired before it was confirmed"
}

_store_token() {
    local answer="$1" now
    now="$(date +%s)"
    local tmp
    tmp="$(mktemp "${_TOKEN_FILE}.XXXXXX")"
    chmod 600 "${tmp}"
    printf '%s' "${answer}" | jq --argjson now "${now}" \
        '{access_token, refresh_token, expires_at: ($now + (.expires_in // 300)), refresh_expires_at: ($now + (.refresh_expires_in // 1800))}' \
        > "${tmp}"
    mv -f "${tmp}" "${_TOKEN_FILE}"
}

cmd_logout() {
    _token_file
    if [[ -f "${_TOKEN_FILE}" ]]; then
        local refresh
        refresh="$(jq -r '.refresh_token // empty' "${_TOKEN_FILE}")"
        if [[ -n "${refresh}" ]]; then
            curl -sS --max-time 10 -o /dev/null -d client_id=gentian-cli \
                --data-urlencode "refresh_token=${refresh}" "${_ISSUER}/protocol/openid-connect/logout" || true
        fi
        rm -f "${_TOKEN_FILE}"
    fi
    echo "Signed out."
}

# _access_token — a current access token, refreshed when close to expiry.
_access_token() {
    _token_file
    [[ -f "${_TOKEN_FILE}" ]] || die "not signed in: kubectl gentian login"
    local now exp
    now="$(date +%s)"
    exp="$(jq -r '.expires_at // 0' "${_TOKEN_FILE}")"
    if (( exp - 30 > now )); then
        jq -r '.access_token' "${_TOKEN_FILE}"
        return 0
    fi
    local refresh answer
    refresh="$(jq -r '.refresh_token // empty' "${_TOKEN_FILE}")"
    [[ -n "${refresh}" ]] || die "the session has ended: kubectl gentian login"
    answer="$(curl -sS --max-time 20 -d client_id=gentian-cli -d grant_type=refresh_token \
        --data-urlencode "refresh_token=${refresh}" "${_ISSUER}/protocol/openid-connect/token")"
    [[ -n "$(printf '%s' "${answer}" | jq -r '.access_token // empty')" ]] ||
        die "the session has ended: kubectl gentian login"
    _store_token "${answer}"
    jq -r '.access_token' "${_TOKEN_FILE}"
}

# ---------------------------------------------------------------------------
# Calling the director
# ---------------------------------------------------------------------------

_PF_PID=""
_DIR_BASE=""

_connect() {
    [[ -n "${_DIR_BASE}" ]] && return 0
    _discover
    local port
    port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
    kubectl port-forward -n "${_DIR_NS}" "deploy/${_DIR_DEPLOY}" "${port}:8080" >/dev/null 2>&1 &
    _PF_PID=$!
    trap '_disconnect' EXIT
    local _i
    for _i in $(seq 1 30); do
        if curl -s -o /dev/null --max-time 1 "http://127.0.0.1:${port}/healthz"; then
            _DIR_BASE="http://127.0.0.1:${port}"
            return 0
        fi
        kill -0 "${_PF_PID}" 2>/dev/null || break
        sleep 0.5
    done
    die "the director in ${_DIR_NS} could not be reached"
}

_disconnect() {
    if [[ -n "${_PF_PID}" ]]; then
        kill "${_PF_PID}" 2>/dev/null || true
    fi
    if [[ -n "${_REG_PF_PID}" ]]; then
        kill "${_REG_PF_PID}" 2>/dev/null || true
    fi
    if [[ -n "${_USH_PF_PID}" ]]; then
        kill "${_USH_PF_PID}" 2>/dev/null || true
    fi
}

# The usher: the Deployment labelled app.kubernetes.io/component=usher, in
# whichever namespace it runs. It answers what the cluster holds of a tenant
# right now; the director answers what git declares.
_USH_PF_PID=""
_USH_BASE=""

_connect_usher() {
    [[ -n "${_USH_BASE}" ]] && return 0
    _discover
    local line ns deploy target port
    line="$(kubectl get deploy -A -l app.kubernetes.io/component=usher \
        -o jsonpath='{range .items[*]}{.metadata.namespace} {.metadata.name}{"\n"}{end}' 2>/dev/null | head -1)"
    [[ -n "${line}" ]] || die "no usher in this cluster: what the cluster holds of a tenant is read there, and this cluster does not run one"
    ns="${line%% *}"
    deploy="${line#* }"
    target="$(kubectl get deploy "${deploy}" -n "${ns}" \
        -o jsonpath='{.spec.template.spec.containers[0].ports[0].containerPort}' 2>/dev/null || true)"
    [[ -n "${target}" ]] || die "the usher in ${ns} names no port"
    port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
    kubectl port-forward -n "${ns}" "deploy/${deploy}" "${port}:${target}" >/dev/null 2>&1 &
    _USH_PF_PID=$!
    trap '_disconnect' EXIT
    local _i
    for _i in $(seq 1 30); do
        if curl -s -o /dev/null --max-time 1 "http://127.0.0.1:${port}/healthz"; then
            _USH_BASE="http://127.0.0.1:${port}"
            return 0
        fi
        kill -0 "${_USH_PF_PID}" 2>/dev/null || break
        sleep 0.5
    done
    die "the usher in ${ns} could not be reached"
}

# The registrar: the Deployment labelled app.kubernetes.io/component=registrar
# in the director's namespace, on the port its Service names.
_REG_PF_PID=""
_REG_BASE=""

_connect_registrar() {
    [[ -n "${_REG_BASE}" ]] && return 0
    _discover
    local deploy target port
    deploy="$(kubectl get deploy -n "${_DIR_NS}" -l app.kubernetes.io/component=registrar \
        -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
    [[ -n "${deploy}" ]] || die "no registrar in ${_DIR_NS}: people are managed there, and this cluster does not run one"
    target="$(kubectl get deploy "${deploy}" -n "${_DIR_NS}" \
        -o jsonpath='{.spec.template.spec.containers[0].ports[0].containerPort}' 2>/dev/null || true)"
    [[ -n "${target}" ]] || die "the registrar in ${_DIR_NS} names no port"
    port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1]); s.close()')"
    kubectl port-forward -n "${_DIR_NS}" "deploy/${deploy}" "${port}:${target}" >/dev/null 2>&1 &
    _REG_PF_PID=$!
    trap '_disconnect' EXIT
    local _i
    for _i in $(seq 1 30); do
        if curl -s -o /dev/null --max-time 1 "http://127.0.0.1:${port}/healthz"; then
            _REG_BASE="http://127.0.0.1:${port}"
            return 0
        fi
        kill -0 "${_REG_PF_PID}" 2>/dev/null || break
        sleep 0.5
    done
    die "the registrar in ${_DIR_NS} could not be reached"
}

# _call <method> <path> [json-body] — the director's answer on stdout; a
# refusal is printed as the director worded it and ends the command.
_call() {
    _connect
    _ask director "${_DIR_BASE}" "$@"
}

# _call_registrar <method> <path> [json-body] — the same, of the registrar.
_call_registrar() {
    _connect_registrar
    _ask registrar "${_REG_BASE}" "$@"
}

# _call_usher <method> <path> — a read of live state, of the usher.
_call_usher() {
    _connect_usher
    _ask usher "${_USH_BASE}" "$@"
}

# _ask <who> <base-url> <method> <path> [json-body]
_ask() {
    local who="$1" base="$2" method="$3" path="$4" body="${5:-}" token out status
    need curl jq python3
    token="$(_access_token)"
    out="$(mktemp)"
    if [[ -n "${body}" ]]; then
        status="$(curl -sS -o "${out}" -w '%{http_code}' -X "${method}" \
            -H "Authorization: Bearer ${token}" -H "Content-Type: application/json" \
            -d "${body}" "${base}${path}")"
    else
        status="$(curl -sS -o "${out}" -w '%{http_code}' -X "${method}" \
            -H "Authorization: Bearer ${token}" "${base}${path}")"
    fi
    if [[ "${status}" -ge 300 ]]; then
        local msg
        msg="$(jq -r '.error // .message // .detail // empty' "${out}" 2>/dev/null || true)"
        rm -f "${out}"
        die "the ${who} answered ${status}: ${msg:-no detail}"
    fi
    cat "${out}"
    rm -f "${out}"
}

# _try <method> <path> [json-body] — ask the director and do not end the
# command on a refusal: the status is left in _TRY_STATUS and the answer, or
# the refusal as the director worded it, in _TRY_ANSWER. For the one place a
# refusal is an answer: a command that two routes serve, by who is asking.
_TRY_STATUS=""
_TRY_ANSWER=""

_try() {
    local method="$1" path="$2" body="${3:-}" token out
    need curl jq
    _connect
    token="$(_access_token)"
    out="$(mktemp)"
    if [[ -n "${body}" ]]; then
        _TRY_STATUS="$(curl -sS -o "${out}" -w '%{http_code}' -X "${method}" \
            -H "Authorization: Bearer ${token}" -H "Content-Type: application/json" \
            -d "${body}" "${_DIR_BASE}${path}")"
    else
        _TRY_STATUS="$(curl -sS -o "${out}" -w '%{http_code}' -X "${method}" \
            -H "Authorization: Bearer ${token}" "${_DIR_BASE}${path}")"
    fi
    if [[ "${_TRY_STATUS}" -ge 300 ]]; then
        _TRY_ANSWER="$(jq -r '.error // .message // .detail // empty' "${out}" 2>/dev/null || true)"
    else
        _TRY_ANSWER="$(cat "${out}")"
    fi
    rm -f "${out}"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_whoami() {
    _discover
    _call GET "/v1/clusters/${_CLUSTER}/me" | jq .
}

cmd_tenants_list() {
    _discover
    _call GET "/v1/clusters/${_CLUSTER}/tenants" |
        jq -r '(["TENANT","NAME","APPS","STATE","ADMINS-APPROVE","ADMINS-ADD-CATALOGUES"] | @tsv), (.tenants[] | [.name, (.displayName // .name), ((.apps // []) | length | tostring), (if .purging then "purging" elif .protected then "protected" else "-" end), (if .adminsApprove then "yes" else "no" end), (if .cataloguesDelegated then "yes" else "no" end)] | @tsv)' |
        column -t -s $'\t'
}

# tenants show: one tenant as git declares it, with the two things only the
# cluster's administrator decides about it.
cmd_tenants_show() {
    local name="${1:-}" entry
    [[ -n "${name}" && $# -eq 1 ]] || die "usage: kubectl gentian tenants show <name>"
    _label "The tenant" "${name}"
    _discover
    entry="$(_call GET "/v1/clusters/${_CLUSTER}/tenants" | jq -c --arg n "${name}" '.tenants[] | select(.name == $n)')"
    [[ -n "${entry}" ]] || die "this cluster has no tenant ${name}"
    printf '%s' "${entry}" | jq -r '
        "Tenant:          \(.name)",
        "Name:            \(.displayName // .name)",
        "Apps:            \((.apps // []) | if length == 0 then "none" else join(", ") end)",
        "Signs in under:  \(.loginDomain // "-")",
        "Own domain:      \(.customDomain // "none")",
        "State:           \(if .purging then "purging" elif .protected then "protected" else "-" end)",
        "",
        "Its administrators may approve public addresses:  \(if .adminsApprove then "yes" else "no" end)",
        "Its administrators may add catalogues:            \(if .cataloguesDelegated then "yes" else "no" end)"'
    echo ""
    echo "A public address is always approved by a member of the tenant's group"
    echo "gentian:tenant:${name}:perimeter, and by the cluster's administrator while the"
    echo "tenant is operated by its cluster. Change either line with:"
    echo "  kubectl gentian tenants set ${name} --admins-approve-public-addresses=true|false --admins-add-catalogues=true|false"
}

cmd_tenants_create() {
    local name="" display="" mfa="true" approve="" catalogues="false" answer
    local usage_text="usage: kubectl gentian tenants create <name> [--display-name <text>] [--no-mfa] [--admins-approve-public-addresses[=true|false]] [--admins-add-catalogues]"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --display-name) display="${2:?}"; shift 2 ;;
            --no-mfa) mfa="false"; shift ;;
            --admins-approve-public-addresses|--admins-approve-public-addresses=true) approve="true"; shift ;;
            --admins-approve-public-addresses=false) approve="false"; shift ;;
            --admins-approve-public-addresses=*) die "--admins-approve-public-addresses is given alone, or as =true or =false" ;;
            --admins-add-catalogues) catalogues="true"; shift ;;
            -*) die "unknown option $1" ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "${usage_text}"
    _discover
    # A switch is named in the request only when it is stated here. Left out,
    # the director decides: neither is on, which is how every tenant starts --
    # but for the user tenant of a single-tenancy cluster, whose administrators
    # approve its public addresses unless =false says they do not.
    answer="$(_call POST "/v1/clusters/${_CLUSTER}/tenants" \
        "$(jq -n --arg n "${name}" --arg d "${display}" --argjson m "${mfa}" --arg a "${approve}" --argjson c "${catalogues}" \
            '{name:$n, displayName:$d, requireMFA:$m}
             + (if $a != "" then {perimeter:{adminsApprove:($a == "true")}} else {} end)
             + (if $c then {catalogue:{delegated:true}} else {} end)')")" || exit 1
    echo "Tenant ${name} committed; the platform is provisioning it."
    # What the director wrote, where it says; what was asked for otherwise.
    case "$(printf '%s' "${answer}" | jq -r '.adminsApprove | if . == null then "" else tostring end' 2>/dev/null)" in
        true) approve="true" ;;
        false) approve="false" ;;
    esac
    if [[ "${approve}" == "true" ]]; then
        echo "Its administrators may approve its public addresses."
    else
        echo "Its public addresses are approved by the members of gentian:tenant:${name}:perimeter and by the"
        echo "cluster's administrator, not by its own administrators (tenants set ${name} --admins-approve-public-addresses=true)."
    fi
    if [[ "${catalogues}" == "true" ]]; then
        echo "Its administrators may add catalogues for their tenant."
    fi
    echo "When it is ready, hand the administrator account over:"
    echo "  kubectl gentian tenants activate-admin ${name} [--recovery-email <address>]"
}

# The administrator account has no password: its holder sets one through a
# single-use link, mailed to a recovery address or shown here, once.
cmd_tenants_activate_admin() {
    local name="" email="" wait_secs=600
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --recovery-email) email="${2:?}"; shift 2 ;;
            --wait) wait_secs="${2:?}"; shift 2 ;;
            -*) die "unknown option $1" ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "usage: kubectl gentian tenants activate-admin <name> [--recovery-email <address>]"
    _discover
    # Declared at all? The director knows, from git. The registrar reads the
    # cluster, where a tenant just created has not arrived yet -- so without
    # this a mistyped name would be waited for like a new tenant.
    _call GET "/v1/clusters/${_CLUSTER}/tenants" |
        jq -e --arg n "${name}" '.tenants[]? | select(.name == $n)' >/dev/null ||
        die "no tenant named ${name}"
    local body answer deadline
    body="$(jq -n --arg e "${email}" 'if $e == "" then {} else {recoveryEmail:$e} end')"
    # A tenant just created is still being provisioned; its realm and account
    # appear within minutes. Waited for here rather than reported as a failure.
    deadline=$(( SECONDS + wait_secs ))
    while :; do
        if answer="$( (_call_registrar POST "/v1/clusters/${_CLUSTER}/tenants/${name}/actions/activate-admin" "${body}") 2>&1)"; then
            break
        fi
        if [[ "${answer}" == *"still being provisioned"* || "${answer}" == *"tenant not found"* ]] && (( SECONDS < deadline )); then
            echo "  waiting for ${name} to be provisioned…" >&2
            sleep 15
            continue
        fi
        # The platform's own administrators are not the registrar's to change:
        # it refuses a link for one of them as it refuses everything else
        # about them. That account is handed over by the installer.
        if [[ "${answer}" == *"administers the platform"* ]]; then
            die "${answer#error: } For the platform admin's account, run ./install.sh --activate-admin on the install host."
        fi
        die "${answer#error: }"
    done
    local user mailed to link expires
    user="$(printf '%s' "${answer}" | jq -r '.username')"
    mailed="$(printf '%s' "${answer}" | jq -r '.activation.mailed')"
    if [[ "${mailed}" == "true" ]]; then
        to="$(printf '%s' "${answer}" | jq -r '.activation.email')"
        echo "Activation link for ${user} mailed to ${to}."
        return 0
    fi
    local why
    why="$(printf '%s' "${answer}" | jq -r '.activation.mailError // empty')"
    [[ -z "${why}" ]] || echo "Not mailed: ${why}. $(printf '%s' "${answer}" | jq -r '.activation.email') is kept as the recovery address." >&2
    link="$(printf '%s' "${answer}" | jq -r '.activation.link')"
    expires="$(printf '%s' "${answer}" | jq -r '.activation.expiresAt')"
    echo "Activate ${user} — open this once; it works one time:"
    echo "  ${link}"
    echo "Valid until $(date -d "@${expires}" 2>/dev/null || date -r "${expires}" 2>/dev/null || echo "${expires}")."
}

# Retire keeps the tenant's data (its manifest's deletionPolicy, Retain by
# default); --purge deletes it. Either asks for the name typed out, as the
# console does, unless --yes says the caller already has.
cmd_tenants_retire() {
    local name="" purge="" keep="" yes="" typed=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --purge) purge=1; shift ;;
            --keep-bundles) keep=1; shift ;;
            --yes) yes=1; shift ;;
            -*) die "unknown flag $1" ;;
            *) name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "usage: kubectl gentian tenants retire <name> [--purge [--keep-bundles]] [--yes]"
    [[ -z "${keep}" || -n "${purge}" ]] || die "--keep-bundles goes with --purge; retire keeps everything"
    if [[ -z "${yes}" ]]; then
        [[ -t 0 ]] || die "not a terminal: confirm with --yes"
        if [[ -n "${purge}" ]]; then
            echo "Purging ${name} deletes its realm and every account in it, its databases,"
            echo "files, mail and secrets. This cannot be undone."
            if [[ -n "${keep}" ]]; then
                echo "Its backup bucket and the bundles in it are kept."
            else
                echo "Its backup bucket goes too (--keep-bundles keeps it)."
            fi
        else
            echo "Retiring ${name} takes it off the cluster and keeps its data."
        fi
        read -r -p "Type ${name} to confirm: " typed
        [[ "${typed}" == "${name}" ]] || die "not confirmed; nothing was changed"
    fi
    _discover
    if [[ -n "${purge}" ]]; then
        local body="{}"
        [[ -z "${keep}" ]] || body='{"keepBundles":true}'
        _call POST "/v1/clusters/${_CLUSTER}/tenants/${name}/actions/purge" "${body}" >/dev/null
        echo "Purge of ${name} requested: its data is set to be deleted, and the tenant"
        echo "is removed once the cluster has taken that in. 'tenants list' shows it as purging until then."
        return 0
    fi
    _call DELETE "/v1/clusters/${_CLUSTER}/tenants/${name}" >/dev/null
    echo "Tenant ${name} retired: git no longer describes it. Its data follows its deletionPolicy."
}

# Import a bundle: upload it, have the director declare the tenant from its
# manifest and restore into it, and follow the import to its end. The key
# never travels as an argument: an identity comes from a file, a passphrase
# from a prompt.
cmd_tenants_import() {
    local file="" idfile="" ask_pw="" name="" identity="" passphrase="" dec body answer bundle st phase msg last=""
    local bucket="" prefix="" endpoint=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --identity-file) idfile="${2:?}"; shift 2 ;;
            --passphrase) ask_pw=1; shift ;;
            --name) name="${2:?}"; shift 2 ;;
            --bucket) bucket="${2:?}"; shift 2 ;;
            --prefix) prefix="${2:?}"; shift 2 ;;
            --endpoint) endpoint="${2:?}"; shift 2 ;;
            -*) die "unknown flag $1" ;;
            *) file="$1"; shift ;;
        esac
    done
    if [[ -z "${file}" && -z "${bucket}" ]]; then
        die "usage: kubectl gentian tenants import <file.gentian> | --bucket <b> --prefix <p> [--endpoint <url>]  (--identity-file <f> | --passphrase) [--name <n>]"
    fi
    [[ -z "${file}" || -f "${file}" ]] || die "no such file: ${file}"
    [[ -z "${bucket}" || -n "${prefix}" ]] || die "--bucket needs --prefix"
    if [[ -n "${idfile}" ]]; then
        identity="$(grep -v '^#' "${idfile}")"
        dec="$(jq -n --arg i "${identity}" '{identity:$i}')"
    elif [[ -n "${ask_pw}" ]]; then
        [[ -t 0 ]] || die "--passphrase needs a terminal"
        read -r -s -p "Passphrase: " passphrase; echo
        dec="$(jq -n --arg p "${passphrase}" '{passphrase:$p}')"
    else
        die "say how to open the bundle: --identity-file <f> or --passphrase"
    fi
    _discover
    if [[ -n "${file}" ]]; then
        echo "Uploading $(du -h "${file}" | cut -f1) …" >&2
        answer="$(_upload "/v1/clusters/${_CLUSTER}/bundles" "${file}")" || die "${answer#error: }"
        bundle="$(printf '%s' "${answer}" | jq -c '.bundle')"
    else
        # A bundle still in a bucket the cluster can reach: the platform's
        # own when no endpoint is given, a destination's otherwise.
        bundle="$(jq -n --arg b "${bucket}" --arg p "${prefix}" --arg e "${endpoint}" '{bucket:$b, prefix:$p} + (if $e == "" then {} else {endpoint:$e} end)')"
    fi
    body="$(jq -n --argjson b "${bundle}" --argjson d "${dec}" --arg n "${name}" '{bundle:$b, decryption:$d} + (if $n == "" then {} else {name:$n} end)')"
    answer="$(_call POST "/v1/clusters/${_CLUSTER}/tenants/import" "${body}")" || exit 1
    name="$(printf '%s' "${answer}" | jq -r '.tenant')"
    echo "Tenant ${name} declared ($(printf '%s' "${answer}" | jq -r '.commit' | cut -c1-8)); the operator provisions it, then the bundle is restored."
    while :; do
        st="$(_call GET "/v1/clusters/${_CLUSTER}/tenants/${name}/import")" || exit 1
        phase="$(printf '%s' "${st}" | jq -r '.phase')"
        msg="$(printf '%s' "${st}" | jq -r '.message // ""')"
        if [[ "${phase}: ${msg}" != "${last}" ]]; then
            echo "  ${phase}: ${msg}" >&2
            last="${phase}: ${msg}"
        fi
        case "${phase}" in
            ready)
                echo "Tenant ${name} imported."
                [[ "$(printf '%s' "${st}" | jq -r '.passwordResetRequired')" != "true" ]] ||
                    echo "Members have no credentials yet: send them a password reset from the console, or activate the administrator with 'tenants activate-admin ${name}'."
                return 0 ;;
            failed) die "import failed: ${msg}" ;;
        esac
        sleep 15
    done
}

# _upload <path> <file> — POST a file's bytes as the body.
_upload() {
    local path="$1" file="$2" token out status
    need curl jq
    token="$(_access_token)"
    _connect
    out="$(mktemp)"
    status="$(curl -sS -o "${out}" -w '%{http_code}' -X POST \
        -H "Authorization: Bearer ${token}" -H "Content-Type: application/x-tar" \
        --data-binary "@${file}" "${_DIR_BASE}${path}")"
    if [[ "${status}" -ge 300 ]]; then
        echo "error: $(jq -r '.error // .detail // .' "${out}" 2>/dev/null || cat "${out}")"
        rm -f "${out}"
        return 1
    fi
    cat "${out}"; rm -f "${out}"
}

_tenant_flag() {
    local t=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:?}"; shift 2 ;;
            *) shift ;;
        esac
    done
    [[ -n "${t}" ]] || die "--tenant is required"
    echo "${t}"
}

# _apps_offers <tenant> — what the catalogues a tenant sees offer -- the
# cluster's and the tenant's own -- as one JSON document: {sources:
# [<name>…], unread: [<name>…], entries: [{source, name, version, edition,
# digest}…]}. The director answers it from each catalogue's index; one it
# could not read is named in unread and the rest are still listed. A tenant
# with no catalogue at all answers no sources.
_apps_offers() {
    local t="$1" answer names name listing entries="[]" unread="[]"
    if ! answer="$( (_call GET "/v1/tenants/${t}/catalogues") 2>&1)"; then
        die "${answer#error: }"
    fi
    names="$(printf '%s' "${answer}" | jq -r '.catalogues[].name')"
    for name in ${names}; do
        if listing="$( (_call GET "/v1/tenants/${t}/catalogues/${name}/entries") 2>/dev/null)"; then
            entries="$(jq -n --argjson have "${entries}" --argjson got "${listing}" --arg s "${name}" \
                '$have + [$got.entries[] | {source: $s, name, version: (.version // ""), edition: (.edition // ""), digest: (.digest // "")}]')"
        else
            unread="$(jq -n --argjson have "${unread}" --arg s "${name}" '$have + [$s]')"
        fi
    done
    jq -n --arg names "${names}" --argjson unread "${unread}" --argjson entries "${entries}" \
        '{sources: ($names | split("\n") | map(select(. != ""))), unread: $unread, entries: $entries}'
}

# apps list: what the tenant has installed; with --available, what the
# catalogues it sees offer -- the cluster's and its own -- and whether the
# tenant has it.
cmd_apps_list() {
    local t available="" a
    t="$(_tenant_flag "$@")"
    for a in "$@"; do
        [[ "${a}" == "--available" ]] && available=1
    done
    if [[ -z "${available}" ]]; then
        _call GET "/v1/tenants/${t}/apps" |
            jq -r '(["APP","FOR","ADDONS"] | @tsv), (.apps[] | [.profile, (if .defaultGrant then "everyone" else "-" end), ((.addons // []) | join(","))] | @tsv)' |
            column -t -s $'\t'
        return 0
    fi
    need jq
    _connect
    local offers installed
    offers="$(_apps_offers "${t}")" || exit 1
    [[ "$(printf '%s' "${offers}" | jq -r '.sources | length')" != "0" ]] ||
        die "${t} has no catalogue to install from: the cluster's administrator adds one (kubectl gentian catalogues add <name> <https-url> [--tenant ${t}])"
    installed="$(_call GET "/v1/tenants/${t}/apps")" || exit 1
    # INSTALLED: yes is this build; "other build" is the app at another digest;
    # unpinned is the app installed with no digest.
    jq -rn --argjson o "${offers}" --argjson i "${installed}" '
        ($i.apps | map({key: .profile, value: (.digest // "")}) | from_entries) as $have
        | (["SOURCE","APP","VERSION","EDITION","DIGEST","INSTALLED"] | @tsv),
          ($o.entries[] | .name as $n | .digest as $d | [.source, $n,
              (if .version == "" then "-" else .version end),
              (if .edition == "" then "-" else .edition end),
              (if $d == "" then "-" else $d[0:19] end),
              (if ($have | has($n) | not) then "-"
               elif $have[$n] == "" then "unpinned"
               elif $have[$n] == $d then "yes"
               else "other build" end)] | @tsv)' |
        column -t -s $'\t'
    local unread
    unread="$(printf '%s' "${offers}" | jq -r '.unread | join(", ")')"
    [[ -z "${unread}" ]] || echo "Not read, the director could not reach them: ${unread}." >&2
}

# apps install: a pinned build from one of the catalogues the tenant sees.
#
# The entry is looked up in what the director lists of them: the one
# catalogue that serves the name, or the one --from names when several do. The
# digest is the one that listing states, unless --digest gives another; either
# way the director fetches the bundle from the source and installs nothing
# unless it hashes to the digest sent.
_apps_install() {
    local app="$1" t="$2" everyone="$3" from="" digest=""
    shift 3
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --from) from="${2:?}"; shift 2 ;;
            --digest) digest="${2:?}"; shift 2 ;;
            *) shift ;;
        esac
    done
    need jq
    _connect
    local offers sources serving count version listed
    offers="$(_apps_offers "${t}")" || exit 1
    sources="$(printf '%s' "${offers}" | jq -r '.sources | join(", ")')"
    [[ -n "${sources}" ]] ||
        die "${t} has no catalogue to install ${app} from: the cluster's administrator adds one (kubectl gentian catalogues add <name> <https-url> [--tenant ${t}])"
    if [[ -n "${from}" ]]; then
        printf '%s' "${offers}" | jq -e --arg s "${from}" '.sources | index($s) != null' >/dev/null ||
            die "${t} has no catalogue named ${from}; its catalogues: ${sources}"
    fi
    serving="$(printf '%s' "${offers}" | jq -c --arg a "${app}" --arg s "${from}" \
        '[.entries[] | select(.name == $a and ($s == "" or .source == $s))]')"
    count="$(printf '%s' "${serving}" | jq -r 'length')"
    if [[ "${count}" == "0" ]]; then
        # A source need not publish an index, and one that does lists only
        # what a cluster may list for itself. Named in full -- source and
        # digest -- an entry can still be asked for: the director verifies it.
        [[ -n "${from}" && -n "${digest}" ]] ||
            die "${app} is not listed by ${from:-any catalogue ${t} installs from} (catalogues: ${sources}); 'apps list --tenant ${t} --available' shows what is"
    elif [[ "${count}" != "1" ]]; then
        die "${app} is served by several sources ($(printf '%s' "${serving}" | jq -r 'map(.source) | join(", ")')): say which with --from <source>"
    else
        from="$(printf '%s' "${serving}" | jq -r '.[0].source')"
    fi
    version="$(printf '%s' "${serving}" | jq -r '.[0].version // ""')"
    listed="$(printf '%s' "${serving}" | jq -r '.[0].digest // ""')"
    [[ -n "${digest}" ]] || digest="${listed}"
    [[ -n "${digest}" ]] ||
        die "${from} lists ${app} without a digest, so there is nothing to pin the install to: state the build with --digest sha256:<hex>"
    # The one spelling a manifest carries, so what is printed is what is recorded.
    digest="$(printf '%s' "${digest}" | tr '[:upper:]' '[:lower:]')"
    [[ "${digest}" == sha256:* ]] || digest="sha256:${digest}"
    local body answer status commit
    body="$(jq -n --arg c "${from}/${app}" --arg d "${digest}" --argjson e "${everyone}" \
        '{coordinate: $c, digest: $d} + (if $e then {defaultGrant: true} else {} end)')"
    answer="$(_call POST "/v1/tenants/${t}/apps/${app}" "${body}")" || exit 1
    status="$(printf '%s' "${answer}" | jq -r '.status // ""')"
    commit="$(printf '%s' "${answer}" | jq -r '.commit // "" | .[0:8]')"
    echo "Pinned ${from}/${app}  version ${version:--}  ${digest:0:19}"
    case "${status}" in
        already_installed)
            echo "${app} is already installed in ${t} at this build; nothing was committed." ;;
        *)
            if [[ "${everyone}" == "true" ]]; then
                echo "Installing ${app} into ${t} for everyone: committed (${commit:-no commit id}); the platform installs it and grants it to every member."
            elif [[ "${status}" == "updated" ]]; then
                echo "Moving ${app} in ${t} to this build: committed (${commit:-no commit id}); the platform rolls it out."
            else
                echo "Installing ${app} into ${t}: committed (${commit:-no commit id}); the platform installs it."
            fi ;;
    esac
}

# _purge_app_when_gone <tenant> <app> — destroy the data of an uninstalled
# app, once the cluster has finished removing the app itself.
#
# The purge is refused with 409 for as long as anything of the app is still
# there: the tenant's manifest on the cluster still names it, its Component
# exists, or Helm has not finished uninstalling its release. So it is asked
# for until it is admitted, for at most GENTIAN_UNINSTALL_WAIT seconds
# (default 900). Once admitted it is one request, answered when it is over;
# anything but success ends the command with the platform's own account of
# what was and was not destroyed.
_purge_app_when_gone() {
    local t="$1" app="$2" wait="${GENTIAN_UNINSTALL_WAIT:-900}"
    local deadline token out status msg body
    need curl jq
    _connect
    deadline=$(( $(date +%s) + wait ))
    out="$(mktemp)"
    body="$(jq -n --arg p "${app}" '{profile:$p}')"
    echo "Purging ${app} from ${t}: waiting for the app to be gone from the cluster first (up to ${wait}s) ..."
    while :; do
        token="$(_access_token)"
        status="$(curl -sS -o "${out}" -w '%{http_code}' -X POST \
            -H "Authorization: Bearer ${token}" -H "Content-Type: application/json" \
            -d "${body}" "${_DIR_BASE}/v1/tenants/${t}/actions/purge-app")"
        [[ "${status}" -lt 300 ]] && break
        msg="$(jq -r '.error // .message // .detail // empty' "${out}" 2>/dev/null || true)"
        if [[ "${status}" != "409" ]]; then
            rm -f "${out}"
            die "the purge of ${app} did not complete (the director answered ${status}): ${msg:-no detail}"
        fi
        # Refused for good, not "not yet": waiting does not bring a profile back.
        if [[ "${msg}" == *"ComponentProfile"* ]]; then
            rm -f "${out}"
            die "the purge of ${app} was refused: ${msg}"
        fi
        if [[ "$(date +%s)" -ge "${deadline}" ]]; then
            rm -f "${out}"
            die "${app} was still not gone from the cluster after ${wait}s, so nothing was purged and its data is retained: ${msg:-no detail}. Run the same command again once it is gone."
        fi
        sleep 10
    done
    echo "Purged ${app} from ${t}: its data is destroyed ($(jq -r '(.destroyed // []) | join(", ")' "${out}")). This cannot be undone."
    rm -f "${out}"
}

# ---------------------------------------------------------------------------
# Catalogues: the addresses apps are installed from
# ---------------------------------------------------------------------------

# _optional_tenant_flag — the --tenant given, or nothing.
_optional_tenant_flag() {
    local t=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:?}"; shift 2 ;;
            *) shift ;;
        esac
    done
    echo "${t}"
}

# catalogues list: with --tenant, what that tenant installs from -- the
# cluster's catalogues and its own. Without, everything the cluster declares:
# its own catalogues, each tenant's, and which tenants may add their own.
cmd_catalogues_list() {
    local t answer
    t="$(_optional_tenant_flag "$@")"
    need jq
    if [[ -n "${t}" ]]; then
        answer="$(_call GET "/v1/tenants/${t}/catalogues")" || exit 1
        printf '%s' "${answer}" | jq -r '
            (["CATALOGUE","FOR","ADDED BY","ADDRESS"] | @tsv),
            (.catalogues[] | [.name, (if .scope == "cluster" then "every tenant" else "this tenant" end),
                (if .addedBy == "tenant" then "the tenant" else "the cluster" end), .url] | @tsv)' |
            column -t -s $'\t'
        if [[ "$(printf '%s' "${answer}" | jq -r '.delegated')" == "true" ]]; then
            echo "The administrators of ${t} may add catalogues of their own."
        else
            echo "The administrators of ${t} may not add catalogues; the cluster's administrator adds them, or delegates it."
        fi
        return 0
    fi
    _discover
    answer="$(_call GET "/v1/clusters/${_CLUSTER}/catalogues")" || exit 1
    printf '%s' "${answer}" | jq -r '
        (["CATALOGUE","FOR","ADDED BY","ADDRESS"] | @tsv),
        (.catalogues[] | [.name, "every tenant", "the cluster", .url] | @tsv),
        (.tenants[] | .tenant as $t | .catalogues[] |
            [.name, ("tenant " + $t), (if .addedBy == "tenant" then "the tenant" else "the cluster" end), .url] | @tsv)' |
        column -t -s $'\t'
    local delegated
    delegated="$(printf '%s' "${answer}" | jq -r '[.tenants[] | select(.delegated) | .tenant] | join(", ")')"
    if [[ -n "${delegated}" ]]; then
        echo "Tenants whose administrators may add catalogues of their own: ${delegated}."
    else
        echo "No tenant's administrators may add catalogues of their own (tenants delegate-catalogues <tenant> on)."
    fi
}

# catalogues add / remove: for the whole cluster without --tenant, for one
# tenant with it.
#
# A tenant's catalogue has two routes, by who is asking. The cluster's
# administrator adds one for the tenant; the tenant's own administrator adds
# one where that is delegated to the tenant. The first is asked, and when the
# director answers that the person may not, the second is: the person is told
# apart by the director, never by this tool.
_catalogues_change() {
    local verb="$1" method="$2" name="$3" t="$4" body="${5:-}" via="the cluster's administrator"
    _discover
    if [[ -z "${t}" ]]; then
        _try "${method}" "/v1/clusters/${_CLUSTER}/catalogues/${name}" "${body}"
    else
        _try "${method}" "/v1/clusters/${_CLUSTER}/tenants/${t}/catalogues/${name}" "${body}"
        if [[ "${_TRY_STATUS}" == "403" ]]; then
            via="the tenant's administrator"
            _try "${method}" "/v1/tenants/${t}/catalogues/${name}" "${body}"
        fi
    fi
    [[ "${_TRY_STATUS}" -lt 300 ]] || die "the director answered ${_TRY_STATUS}: ${_TRY_ANSWER:-no detail}"
    local status commit whose="every tenant of this cluster"
    [[ -z "${t}" ]] || whose="tenant ${t}"
    status="$(printf '%s' "${_TRY_ANSWER}" | jq -r '.status // ""')"
    commit="$(printf '%s' "${_TRY_ANSWER}" | jq -r '.commit // "" | .[0:8]')"
    if [[ "${status}" == "unchanged" ]]; then
        echo "Catalogue ${name} is already there for ${whose}; nothing was committed."
    elif [[ "${verb}" == "add" ]]; then
        echo "Catalogue ${name} added for ${whose}, as ${via}: committed (${commit:-no commit id})."
        if [[ -n "${t}" ]]; then
            echo "  kubectl gentian apps list --tenant ${t} --available"
        else
            echo "  kubectl gentian apps list --tenant <tenant> --available"
        fi
    else
        echo "Catalogue ${name} removed for ${whose}, as ${via}: committed (${commit:-no commit id})."
        echo "What was installed from it stays installed; a new install or a new build needs a catalogue that serves it."
    fi
}

# catalogues residue: what the catalogue left on the cluster -- objects a
# profile's bundle once brought and no bundle owns now, and profiles nobody
# uses. Nothing removes them by itself. The list is the usher's, worked out
# by the operator; IN EFFECT says whether an OIDC pack catalog on it is still
# read when a client is configured.
cmd_catalogues_residue_list() {
    local answer
    need jq
    _discover
    answer="$(_call_usher GET "/v1/clusters/${_CLUSTER}/catalogue/residue")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.residue | length')" == "0" ]]; then
        echo "Nothing is left over: every object of a bundle's kinds is owned by a bundle, and every profile is in use."
    else
        printf '%s' "${answer}" | jq -r '
            (["KIND/NAME","NAMESPACE","PROFILE","WHY","CREATED","IN EFFECT"] | @tsv),
            (.residue[] | [
                (.kind + "/" + .name),
                (.namespace // "" | if . == "" then "-" else . end),
                (.profile // "" | if . == "" then "-" else . end),
                (.class | gsub("-"; " ")),
                (.created // "" | if . == "" then "-" else .[0:10] end),
                (if .oidc == null then "-"
                 elif .oidc.effective == "yes" then "YES"
                 elif .oidc.effective == "contested" then "contested"
                 else "no" end)
            ] | @tsv)' | column -t -s $'\t'
        echo
        printf '%s' "${answer}" | jq -r '.residue[] |
            "  " + .kind + "/" + .name + ": " + .reason
            + (if .oidc == null then "" else
                 (if (.oidc.clients | length) > 0 then "; the only pack for: " + (.oidc.clients | join(", ")) else "" end)
                 + (if (.oidc.contested | length) > 0 then "; another catalog also holds: " + (.oidc.contested | join(", ")) else "" end)
                 + (if (.oidc.composition // "") != "" then "; read by the Composition of " + .oidc.composition else "" end)
               end)
            + (if (.companions // []) | length > 0 then "; its bundle brings " + (.companions | join(", ")) + ", which stay" else "" end)
            + (if .removable then "" else " (not removed here: " + (.notRemovable // "") + ")" end)'
        echo
        echo "Nothing here is removed automatically. To remove one:"
        echo "  kubectl gentian catalogues residue remove <kind>/<name>"
    fi
    printf '%s' "${answer}" | jq -r '.incomplete[] | "Not established: " + .'
}

# catalogues residue remove: one object of the list, named, with the name
# typed again. The director refuses anything that is not on the list when it
# is asked, and says what was deleted or why nothing was.
cmd_catalogues_residue_remove() {
    local target="" ns="" yes="" typed="" kind name body status
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --namespace|-n) ns="${2:?}"; shift 2 ;;
            --yes) yes=1; shift ;;
            -*) die "unknown option $1" ;;
            *)
                [[ -z "${target}" ]] || die "unexpected argument $1: one object is removed at a time"
                target="$1"; shift ;;
        esac
    done
    kind="${target%%/*}"
    name="${target#*/}"
    [[ "${target}" == */* && -n "${kind}" && -n "${name}" ]] ||
        die "usage: kubectl gentian catalogues residue remove <kind>/<name> [--namespace <ns>] [--yes]"
    need jq
    if [[ -z "${yes}" ]]; then
        [[ -t 0 ]] || die "not a terminal: confirm with --yes"
        echo "Removing the ${kind} ${name} deletes it from the cluster. Nothing puts it back but"
        echo "installing a build that brings it."
        read -r -p "Type ${name} to confirm: " typed
        [[ "${typed}" == "${name}" ]] || die "not confirmed; nothing was changed"
    fi
    _discover
    body="$(jq -n --arg k "${kind}" --arg n "${name}" --arg ns "${ns}" \
        '{kind: $k, name: $n, confirm: $n} + (if $ns == "" then {} else {namespace: $ns} end)')"
    _try POST "/v1/clusters/${_CLUSTER}/actions/remove-catalogue-residue" "${body}"
    [[ "${_TRY_STATUS}" -lt 300 ]] ||
        die "nothing was deleted (the director answered ${_TRY_STATUS}): ${_TRY_ANSWER:-no detail}"
    status="$(printf '%s' "${_TRY_ANSWER}" | jq -r '.status // ""')"
    case "${status}" in
        deleted) echo "Deleted the ${kind} ${name}." ;;
        deleting) echo "The ${kind} ${name} is being deleted; it is not gone yet." ;;
        *) echo "The ${kind} ${name} is not deleted yet (${status:-no status})." ;;
    esac
    printf '%s' "${_TRY_ANSWER}" | jq -r '"  " + (.message // "")'
}

cmd_catalogues() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        list) cmd_catalogues_list "$@" ;;
        residue)
            case "${1:-}" in
                "") cmd_catalogues_residue_list ;;
                remove) shift; cmd_catalogues_residue_remove "$@" ;;
                *) die "usage: kubectl gentian catalogues residue [remove <kind>/<name> [--namespace <ns>] [--yes]]" ;;
            esac
            ;;
        add|remove)
            local name="" address="" t="" a
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --tenant|-t) t="${2:?}"; shift 2 ;;
                    -*) die "unknown option $1" ;;
                    *)
                        if [[ -z "${name}" ]]; then name="$1"
                        elif [[ -z "${address}" ]]; then address="$1"
                        else die "unexpected argument $1"
                        fi
                        shift ;;
                esac
            done
            if [[ "${sub}" == "add" ]]; then
                [[ -n "${name}" && -n "${address}" ]] ||
                    die "usage: kubectl gentian catalogues add <name> <https-url> [--tenant <tenant>]"
                need jq
                _catalogues_change add PUT "${name}" "${t}" "$(jq -n --arg u "${address}" '{url: $u}')"
            else
                [[ -n "${name}" && -z "${address}" ]] ||
                    die "usage: kubectl gentian catalogues remove <name> [--tenant <tenant>]"
                _catalogues_change remove DELETE "${name}" "${t}"
            fi
            ;;
        *) die "usage: kubectl gentian catalogues list|add|remove|residue ..." ;;
    esac
}

# tenants delegate-catalogues: whether a tenant's own administrators may add
# catalogues for their tenant. The cluster administrator's to say.
cmd_tenants_delegate_catalogues() {
    local name="${1:-}" state="${2:-}"
    [[ -n "${name}" && ( "${state}" == "on" || "${state}" == "off" ) ]] ||
        die "usage: kubectl gentian tenants delegate-catalogues <name> on|off"
    _discover
    if [[ "${state}" == "on" ]]; then
        _call PUT "/v1/clusters/${_CLUSTER}/tenants/${name}/catalogue-delegation" >/dev/null
        echo "The administrators of ${name} may now add catalogues for their tenant: committed."
    else
        _call DELETE "/v1/clusters/${_CLUSTER}/tenants/${name}/catalogue-delegation" >/dev/null
        echo "The administrators of ${name} may no longer add catalogues: committed. What they added stays until it is removed."
    fi
}

# tenants set: the two things about a tenant that only the cluster's
# administrator decides -- whether its own administrators may approve what it
# publishes to the internet, and whether they may add catalogues. Each is a
# switch on the tenant's manifest in git, off unless turned on; each option
# given is one request to the director (PUT turns it on, DELETE off), which
# decides who may. Everything is read before anything is asked, so a mistyped
# option changes nothing.
cmd_tenants_set() {
    local name="" approve="" catalogues="" usage_text
    usage_text="usage: kubectl gentian tenants set <name> [--admins-approve-public-addresses=true|false] [--admins-add-catalogues=true|false]"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --admins-approve-public-addresses=true|--admins-approve-public-addresses=false) approve="${1#*=}"; shift ;;
            --admins-add-catalogues=true|--admins-add-catalogues=false) catalogues="${1#*=}"; shift ;;
            --admins-approve-public-addresses*|--admins-add-catalogues*) die "${1%%=*} is given as ${1%%=*}=true or ${1%%=*}=false" ;;
            -*) die "unknown option $1" ;;
            *) [[ -z "${name}" ]] || die "${usage_text}"; name="$1"; shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "${usage_text}"
    [[ -n "${approve}${catalogues}" ]] || die "nothing to set. ${usage_text}"
    _label "The tenant" "${name}"
    _discover
    if [[ "${approve}" == "true" ]]; then
        _call PUT "/v1/clusters/${_CLUSTER}/tenants/${name}/perimeter-delegation" >/dev/null
        echo "The administrators of ${name} may now approve its public addresses: committed. It holds once the cluster has taken the commit in."
    elif [[ "${approve}" == "false" ]]; then
        _call DELETE "/v1/clusters/${_CLUSTER}/tenants/${name}/perimeter-delegation" >/dev/null
        echo "The administrators of ${name} may no longer approve its public addresses: committed. What is published stays until it is withdrawn."
    fi
    if [[ "${catalogues}" == "true" ]]; then
        _call PUT "/v1/clusters/${_CLUSTER}/tenants/${name}/catalogue-delegation" >/dev/null
        echo "The administrators of ${name} may now add catalogues for their tenant: committed."
    elif [[ "${catalogues}" == "false" ]]; then
        _call DELETE "/v1/clusters/${_CLUSTER}/tenants/${name}/catalogue-delegation" >/dev/null
        echo "The administrators of ${name} may no longer add catalogues: committed. What they added stays until it is removed."
    fi
}

# ---------------------------------------------------------------------------
# A tenant's own domain, and what a tenant has on the internet
# ---------------------------------------------------------------------------

# _label <what> <value> — a value that goes into a request's path is a name:
# lower-case letters, digits and hyphens. Refused here so that nothing typed
# can turn one request into another; the director checks the name again.
_label() {
    [[ "$2" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] ||
        die "$1 is a name of lower-case letters, digits and hyphens, not '$2'"
}

# _committed <answer> — the first eight characters of the commit an answer
# names, or a word for none.
_committed() {
    local commit
    commit="$(printf '%s' "$1" | jq -r '.commit // "" | .[0:8]')"
    echo "${commit:-no commit id}"
}

# tenants domain: the domain of its own a tenant is served at, instead of its
# default address under the cluster's domain.
#
# With a name alone it shows what git declares. With a domain it binds the
# tenant to it, with --remove it unbinds it: one request to the director each
# (PUT or DELETE /v1/clusters/<c>/tenants/<t>/domain), which decides who may
# and which domains it refuses. What moves and what has to be true first is
# printed before anything is asked, and the change is confirmed by typing --
# the domain to bind, the tenant's name to unbind -- unless --yes says the
# caller already has. The DNS record and the certificate are checked by
# nobody: not by the director, and not here.
cmd_tenants_domain() {
    local name="" domain="" remove="" yes="" typed="" usage_text
    usage_text="usage: kubectl gentian tenants domain <name> [<domain> | --remove] [--yes]"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --remove) remove=1; shift ;;
            --yes) yes=1; shift ;;
            -*) die "unknown option $1" ;;
            *)
                if [[ -z "${name}" ]]; then name="$1"
                elif [[ -z "${domain}" ]]; then domain="$1"
                else die "unexpected argument $1"
                fi
                shift ;;
        esac
    done
    [[ -n "${name}" ]] || die "${usage_text}"
    _label "a tenant" "${name}"
    [[ -z "${remove}" || -z "${domain}" ]] ||
        die "--remove takes no domain: it puts ${name} back at its default address"
    # The one spelling the director records, so what is shown is what is sent.
    domain="$(printf '%s' "${domain}" | tr '[:upper:]' '[:lower:]')"
    if [[ -n "${domain}${remove}" && -z "${yes}" ]]; then
        [[ -t 0 ]] || die "not a terminal: confirm with --yes"
    fi
    need curl jq
    _connect
    local tenants current answer
    tenants="$(_call GET "/v1/clusters/${_CLUSTER}/tenants")" || exit 1
    printf '%s' "${tenants}" | jq -e --arg n "${name}" '.tenants[]? | select(.name == $n)' >/dev/null ||
        die "no tenant named ${name}"
    current="$(printf '%s' "${tenants}" | jq -r --arg n "${name}" '.tenants[] | select(.name == $n) | .customDomain // ""')"

    if [[ -z "${domain}" && -z "${remove}" ]]; then
        if [[ -n "${current}" ]]; then
            echo "Tenant ${name} is bound to the domain ${current}: its desktop is desktop.${current}, its admin"
            echo "console admin.${current}, and each app <label>.${current}."
        else
            echo "Tenant ${name} is bound to no domain of its own: it is served at its default address under the"
            echo "cluster's domain."
        fi
        echo "That is what git declares. Whether the cluster has taken it in (empty when no domain is bound):"
        echo "  kubectl get tenant ${name} -o jsonpath='{.status.conditions[?(@.type==\"DomainBound\")].message}'"
        return 0
    fi

    if [[ -n "${remove}" ]]; then
        if [[ -z "${current}" ]]; then
            echo "Tenant ${name} is bound to no domain of its own; nothing was changed."
            return 0
        fi
        echo "Removing the domain ${current} from tenant ${name} puts it back at its default address under the"
        echo "cluster's domain. Its desktop, its admin console, every app, its mail and the names its people sign in"
        echo "with move there, and nothing of it answers at ${current} any more."
        if [[ -z "${yes}" ]]; then
            read -r -p "Type ${name} to confirm: " typed
            [[ "${typed}" == "${name}" ]] || die "not confirmed; nothing was changed"
        fi
        answer="$(_call DELETE "/v1/clusters/${_CLUSTER}/tenants/${name}/domain")" || exit 1
        if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
            echo "Tenant ${name} was bound to no domain; nothing was committed."
            return 0
        fi
        echo "Tenant ${name} is bound to no domain any more: committed ($(_committed "${answer}")). The operator moves it back."
        return 0
    fi

    if [[ "${current}" == "${domain}" ]]; then
        echo "Tenant ${name} is already bound to ${domain}; nothing was changed."
        return 0
    fi
    echo "Binding tenant ${name} to the domain ${domain} moves every address it is served at."
    if [[ -n "${current}" ]]; then
        echo "  now:   <label>.${current}"
    else
        echo "  now:   its default address under the cluster's domain"
    fi
    echo "  then:  desktop.${domain} (its desktop), admin.${domain} (its admin console) and <label>.${domain}"
    echo "         for every app, installed or yet to be"
    echo "Its mail and the names its people sign in with move to ${domain} as well. It is served at one domain:"
    echo "the addresses it has now stop being its own."
    echo
    echo "What has to be true first. The director checks none of it, and neither does this command:"
    echo "  - DNS: *.${domain} resolves to this cluster. The platform publishes records only in the DNS zone that"
    echo "    holds the cluster's own domain; if ${domain} lies in another zone, the wildcard record is yours to make."
    echo "  - Certificate: the cluster's DNS-01 certificate issuer can write _acme-challenge records in the zone of"
    echo "    ${domain} -- its DNS token covers that zone. The tenant gets one wildcard certificate, *.${domain};"
    echo "    until it is issued its addresses have none."
    echo
    echo "This command is for a cluster with many tenants. On a single-tenancy cluster the one tenant for users"
    echo "is on the cluster's own addresses and the director refuses to bind it, as it refuses the platform tenant"
    echo "on any cluster. It also refuses a name that is not a hostname, one on or under the cluster's own"
    echo "domain, and one another tenant is bound to."
    if [[ -z "${yes}" ]]; then
        read -r -p "Type ${domain} to confirm: " typed
        [[ "${typed}" == "${domain}" ]] || die "not confirmed; nothing was changed"
    fi
    answer="$(_call PUT "/v1/clusters/${_CLUSTER}/tenants/${name}/domain" "$(jq -n --arg d "${domain}" '{domain: $d}')")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
        echo "Tenant ${name} is already bound to ${domain}; nothing was committed."
        return 0
    fi
    echo "Tenant ${name} bound to ${domain}: committed ($(_committed "${answer}")). The operator moves it; this says when it has,"
    echo "or why it has not:"
    echo "  kubectl get tenant ${name} -o jsonpath='{.status.conditions[?(@.type==\"DomainBound\")].message}'"
}

# exposures list: the registry of what a tenant has on the internet, as the
# director keeps it -- every entry a perimeter approver published, who did,
# when it is looked at again and when it ends. PUBLISHED is in force; REVIEW
# DUE is in force and past its review date; EXPIRED answers no longer and
# stays listed as the record that it once did.
#
# KIND is what was approved, in the director's words. Not every entry is a
# public address: one approved to keep the app's own Authorization header
# is behind sign-in and publishes nothing. A director that names no kinds is
# older than they are, and everything it lists is a public address.
cmd_exposures_list() {
    local t answer
    t="$(_tenant_flag "$@")"
    _label "a tenant" "${t}"
    need jq
    answer="$(_call GET "/v1/tenants/${t}/exposures")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '((.live // []) + (.expired // [])) | length')" == "0" ]]; then
        echo "Tenant ${t} has published nothing to the internet, and nothing else is approved for its apps' entries."
        return 0
    fi
    printf '%s' "${answer}" | jq -r '
        def day: if (. // "") == "" then "-" else .[0:10] end;
        (.kinds // {}) as $kinds
        | def kind: (.kind // "") as $k | (if $k == "" then "public" else $k end) as $k
            | $kinds[$k] // (if $k == "public" then "Public address" else $k end);
        def row(state): [.install, .exposureName, kind, state, (if .apex then "yes" else "-" end),
            (.owner // "-"), (.publishedAt | day), (.reviewAt | day), (.expiresAt | day),
            (if (.reason // "") == "" then "-" else .reason end)];
        ((.reviewDue // []) | map(.install + " " + .exposureName)) as $due
        | (["APP INSTANCE","ENTRY","KIND","STATE","MAIN ADDRESS","APPROVED BY","APPROVED","REVIEW","EXPIRES","REASON"] | @tsv),
          ((.live // [])[] | (.install + " " + .exposureName) as $k
              | row(if ($due | index($k)) != null then "review due" else "published" end) | @tsv),
          ((.expired // [])[] | row("expired") | @tsv)' |
        column -t -s $'\t'
}

# exposures withdraw: take one entry of an installed app off the internet, or
# take back the approval that lets an entry behind sign-in keep the app's own
# Authorization header.
# One request to the director (DELETE /v1/tenants/<t>/exposures/<app
# instance>/<entry>), which decides who may. It removes access and loses no
# data, so it is not asked twice.
cmd_exposures_withdraw() {
    local inst="" entry="" t="" answer usage_text
    usage_text="usage: kubectl gentian exposures withdraw <app-instance> <entry> --tenant <tenant>"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:?}"; shift 2 ;;
            -*) die "unknown option $1" ;;
            *)
                if [[ -z "${inst}" ]]; then inst="$1"
                elif [[ -z "${entry}" ]]; then entry="$1"
                else die "unexpected argument $1"
                fi
                shift ;;
        esac
    done
    [[ -n "${inst}" && -n "${entry}" ]] || die "${usage_text}"
    [[ -n "${t}" ]] || die "--tenant is required"
    _label "a tenant" "${t}"
    _label "an app instance" "${inst}"
    _label "an entry" "${entry}"
    need jq
    answer="$(_call DELETE "/v1/tenants/${t}/exposures/${inst}/${entry}")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
        echo "${inst}/${entry} is not approved for ${t}; nothing was committed."
        return 0
    fi
    echo "Withdrawn ${inst}/${entry} of ${t}: committed ($(_committed "${answer}")). Once the cluster has taken that in,"
    echo "a public address stops answering, and an entry behind sign-in has its Authorization header removed again."
}

# exposures requests: every entry an app installed in the tenant declares for
# the internet, as the director reads it from the app's profile -- the
# address it would be published at, its paths, whether anybody signs in --
# and whether it was approved. REQUESTED is declared and published nowhere
# until somebody approves it. UNMATCHED is in the registry and matches no
# entry of an installed app: nothing is published for it.
#
# The same list carries the one request that is no public address: an entry
# behind sign-in that asks to keep the app's own Authorization header. KIND
# says which an entry is, in the director's words.
cmd_exposures_requests() {
    local t answer
    t="$(_tenant_flag "$@")"
    _label "a tenant" "${t}"
    need jq
    answer="$(_call GET "/v1/tenants/${t}/exposures")" || exit 1
    printf '%s' "${answer}" | jq -e 'has("entries")' >/dev/null ||
        die "this director does not say what a tenant's apps ask to publish: it is older than this command"
    if [[ "$(printf '%s' "${answer}" | jq -r '.entries | length')" == "0" ]]; then
        echo "No app installed in tenant ${t} asks to have anything on the internet, or to keep its own Authorization header behind sign-in."
        return 0
    fi
    printf '%s' "${answer}" | jq -r '
        def day: if (. // "") == "" then "-" else .[0:10] end;
        def state: {"requested": "requested", "approved": "approved", "reviewDue": "review due",
                    "expired": "expired", "unmatched": "unmatched"}[.state] // .state;
        def kind: .kindLabel // (if (.kind // "") == "" then "Public address" else .kind end);
        def signin: if (.authMode // "") == "" then "-"
            elif .publicAddress == false then "required"
            elif .anyoneWithoutSignIn then "none: anyone"
            else "none: the app checks the credential" end;
        (["APP INSTANCE","ENTRY","KIND","STATE","ADDRESS","PATHS","SIGN-IN","APPROVED BY","REVIEW","EXPIRES"] | @tsv),
        (.entries[] | [.install, .exposureName, kind, state,
            (if (.host // "") == "" then "-" else "https://" + .host end),
            (if ((.paths // []) | length) == 0 then "-" else (.paths | join(" ")) end),
            signin,
            (.approval.owner // "-"), (.approval.reviewAt | day), (.approval.expiresAt | day)] | @tsv)' |
        column -t -s $'\t'
    # Why an entry has no address, or matches nothing, in the director's words.
    printf '%s' "${answer}" | jq -r '.entries[] | select((.note // "") != "") | "\n" + .install + "/" + .exposureName + ": " + .note'
    echo
    echo "Approve one with: kubectl gentian exposures approve <app-instance> <entry> --tenant ${t}"
}

# exposures approve: put one entry of an installed app on the internet, or
# look again at one that is (a review, and the way to change its expiry).
# Or, for an entry behind sign-in that asks for it, let the app keep its own
# Authorization header: that publishes nothing, and is said so.
#
# It is the perimeter approver's decision, so what is decided is shown first:
# the entry is read from the director, and its address, its paths and who can
# reach it are printed before anything is asked. What the director does not
# list is not asked for. The approval is confirmed by typing the entry, or
# with --yes.
#
# An entry for the cluster's main address is different in one way: the
# director's rule for a website there is printed in full, and the approval
# is sent only with --acknowledge-main-address-rule. --yes does not say it.
#
# One request (PUT /v1/tenants/<t>/exposures/<app instance>/<entry>); the
# director decides who may, and its refusals are printed as it worded them.
cmd_exposures_approve() {
    local inst="" entry="" t="" expires="" reason="" ack="" yes="" typed="" usage_text
    usage_text="usage: kubectl gentian exposures approve <app-instance> <entry> --tenant <tenant> [--expires <date>] [--reason <text>] [--acknowledge-main-address-rule] [--yes]"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tenant|-t) t="${2:?}"; shift 2 ;;
            --expires) expires="${2:?}"; shift 2 ;;
            --reason) reason="${2:?}"; shift 2 ;;
            --acknowledge-main-address-rule) ack=1; shift ;;
            --yes) yes=1; shift ;;
            -*) die "unknown option $1" ;;
            *)
                if [[ -z "${inst}" ]]; then inst="$1"
                elif [[ -z "${entry}" ]]; then entry="$1"
                else die "unexpected argument $1"
                fi
                shift ;;
        esac
    done
    [[ -n "${inst}" && -n "${entry}" ]] || die "${usage_text}"
    [[ -n "${t}" ]] || die "--tenant is required"
    _label "a tenant" "${t}"
    _label "an app instance" "${inst}"
    _label "an entry" "${entry}"
    # A day is the end of that day, UTC; anything else is the director's to
    # read, and what is sent is what is shown.
    if [[ "${expires}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
        expires="${expires}T23:59:59Z"
    fi
    if [[ -z "${yes}" ]]; then
        [[ -t 0 ]] || die "not a terminal: confirm with --yes"
    fi
    need jq
    local answer asked state host public kind
    answer="$(_call GET "/v1/tenants/${t}/exposures")" || exit 1
    printf '%s' "${answer}" | jq -e 'has("entries")' >/dev/null ||
        die "this director does not say what an entry would put on the internet: it is older than this command. Nothing was sent"
    asked="$(printf '%s' "${answer}" | jq -c --arg i "${inst}" --arg e "${entry}" \
        '[.entries[] | select(.install == $i and .exposureName == $e and .state != "unmatched")][0] // empty')"
    [[ -n "${asked}" ]] ||
        die "the director lists no request ${inst}/${entry} for tenant ${t}: no app installed there declares it as something an approver decides. 'kubectl gentian exposures requests --tenant ${t}' shows what its apps ask for. Nothing was sent"
    state="$(printf '%s' "${asked}" | jq -r '.state')"
    host="$(printf '%s' "${asked}" | jq -r '.host // ""')"
    # An older director names no kinds: everything it lists is a public address.
    public="$(printf '%s' "${asked}" | jq -r 'if .publicAddress == false then "" else "yes" end')"
    kind="$(printf '%s' "${asked}" | jq -r '.kind // ""')"

    if [[ "$(printf '%s' "${asked}" | jq -r '.authMode // ""')" == "" ]]; then
        # An entry the director can name and not describe: the platform's own
        # page, which the installer published. Only its review is asked.
        echo "Reviewing ${inst}/${entry} of tenant ${t}. The director cannot show what it publishes:"
        printf '%s' "${asked}" | jq -r '"  " + (.note // "no reason given")'
    elif [[ -z "${public}" ]]; then
        if [[ "${state}" == "requested" ]]; then
            echo "Approving ${inst}/${entry} for tenant ${t} puts NOTHING on the internet. It changes this, behind sign-in:"
        else
            echo "${inst}/${entry} of tenant ${t} is approved already; approving it again is a review. Nothing of it is on the internet. Behind sign-in, it has this:"
        fi
        printf '%s' "${asked}" | jq -r '
            "  kind:     " + (.kindLabel // .kind),
            "  address:  " + (if (.host // "") == "" then "(this cluster declares no domain)" else "https://" + .host end),
            "  paths:    " + ((.paths // []) | join("  ")),
            "  what:     " + .access'
    elif [[ -z "${host}" ]]; then
        die "${inst}/${entry} would be published nowhere: $(printf '%s' "${asked}" | jq -r '.note // "the director gives no address for it"'). Nothing was sent"
    else
        if [[ "${state}" == "requested" ]]; then
            echo "Approving ${inst}/${entry} for tenant ${t} puts this on the internet:"
        else
            echo "${inst}/${entry} of tenant ${t} is approved already; approving it again is a review. It has this on the internet:"
        fi
        printf '%s' "${asked}" | jq -r '
            "  address:  https://" + .host,
            "  paths:    " + (.paths | join("  ")) + (if (.paths | index("/")) != null then "   (the whole address)" else "   (nothing else at that address is published)" end),
            (if ((.denyPaths // []) | length) > 0 then "  refused:  " + (.denyPaths | join("  ")) + "   (never published, also below a path above)" else empty end),
            "  kind:     " + (.kindLabel // "Public address"),
            "  access:   " + .access,
            (if (.rateLimit // "") == "" then empty else "  limit:    " + .rateLimit end)'
    fi
    if [[ -n "${expires}" ]]; then
        echo "  expires:  ${expires}; the approval ends then"
    else
        echo "  expires:  never; it stays until it is withdrawn"
    fi
    echo "  review:   a year from now at the latest, or at its expiry if that is sooner"
    [[ -z "${reason}" ]] || echo "  reason:   ${reason}"
    if [[ "${state}" != "requested" ]]; then
        printf '%s' "${asked}" | jq -r '
            def day: if (. // "") == "" then "-" else .[0:10] end;
            "  so far:   approved by " + (.approval.owner // "-") + " on " + (.approval.publishedAt | day)
            + ", review " + (.approval.reviewAt | day) + ", expires " + (.approval.expiresAt | day)
            + ". The expiry and the reason above replace the ones it has."'
    fi

    local main
    main="$(printf '%s' "${asked}" | jq -r 'if .mainAddress then "yes" else "" end')"
    if [[ -n "${main}" ]]; then
        echo
        echo "This entry is for the cluster's MAIN ADDRESS. What the director says of a website there:"
        echo
        printf '%s' "${asked}" | jq -r '.mainAddressRule // "(the director sent no rule)"' | fold -s -w 96 | sed -e 's/ *$//' -e 's/^/  /'
        echo
        [[ -n "${ack}" ]] ||
            die "a website on the main address is approved only with --acknowledge-main-address-rule, which says the rule above is true of this site; your name and the time are recorded with the entry. Nothing was sent"
        echo "--acknowledge-main-address-rule: you say this is true of the site. Your name and the time are recorded."
    elif [[ -n "${ack}" ]]; then
        die "--acknowledge-main-address-rule is for an entry on the cluster's main address, and ${inst}/${entry} is not one. Nothing was sent"
    fi

    if [[ -z "${yes}" ]]; then
        read -r -p "Type ${inst}/${entry} to confirm: " typed
        [[ "${typed}" == "${inst}/${entry}" ]] || die "not confirmed; nothing was changed"
    fi
    local body
    # The kind that was shown goes with the approval, so the director refuses
    # it if the app's entry has come to ask for something else meanwhile.
    body="$(jq -cn --arg r "${reason}" --arg x "${expires}" --arg m "${main}" --arg k "${kind}" '
        (if $r == "" then {} else {reason: $r} end)
        + (if $k == "" then {} else {kind: $k} end)
        + (if $x == "" then {} else {expiresAt: $x} end)
        + (if $m == "" then {} else {apex: true, acknowledgeMainAddressRule: true} end)')"
    answer="$(_call PUT "/v1/tenants/${t}/exposures/${inst}/${entry}" "${body}")" || exit 1
    if [[ "$(printf '%s' "${answer}" | jq -r '.status // ""')" == "unchanged" ]]; then
        echo "${inst}/${entry} of ${t} is approved on these terms already; nothing was committed."
        return 0
    fi
    if [[ -z "${public}" ]]; then
        echo "Approved ${inst}/${entry} of ${t}: committed ($(_committed "${answer}")). Nothing is published. Once the"
        echo "cluster has taken that in, the app's own Authorization header is kept on that address behind sign-in."
    else
        echo "Approved ${inst}/${entry} of ${t}: committed ($(_committed "${answer}")). The platform publishes it once the"
        echo "cluster has taken that in."
    fi
    echo "'kubectl gentian exposures requests --tenant ${t}' shows its review date."
}

cmd_exposures() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        list) cmd_exposures_list "$@" ;;
        requests) cmd_exposures_requests "$@" ;;
        approve) cmd_exposures_approve "$@" ;;
        withdraw) cmd_exposures_withdraw "$@" ;;
        *) die "usage: kubectl gentian exposures requests|approve|list|withdraw ..." ;;
    esac
}

cmd_apps() {
    local sub="${1:-}"
    shift || true
    case "${sub}" in
        list) cmd_apps_list "$@" ;;
        install|uninstall)
            local app="${1:-}"
            [[ -n "${app}" && "${app}" != -* ]] || die "usage: kubectl gentian apps ${sub} <app> --tenant <tenant>"
            shift
            local t purge="false" everyone="false" a
            t="$(_tenant_flag "$@")"
            for a in "$@"; do
                [[ "${a}" == "--purge" ]] && purge="true"
                [[ "${a}" == "--for-everyone" ]] && everyone="true"
            done
            [[ "${everyone}" == "false" || "${sub}" == "install" ]] || die "--for-everyone goes with install"
            if [[ "${sub}" == "install" ]]; then
                # --for-everyone is part of the install, in the same commit:
                # every member has the app by default, granted once its group
                # exists.
                _apps_install "${app}" "${t}" "${everyone}" "$@"
            elif [[ "${purge}" == "true" ]]; then
                # Two acts, in order: uninstall, which keeps the data, and
                # then the purge, which destroys it and is refused until the
                # app is gone from the cluster.
                local answer
                answer="$(_call DELETE "/v1/tenants/${t}/apps/${app}")"
                if [[ -n "$(jq -r '.commit // empty' <<<"${answer}" 2>/dev/null || true)" ]]; then
                    echo "Uninstalling ${app} from ${t}: committed; the platform removes it. Its data is still there."
                else
                    echo "${app} is not installed in ${t}: nothing to uninstall."
                fi
                _purge_app_when_gone "${t}" "${app}"
            else
                _call DELETE "/v1/tenants/${t}/apps/${app}" >/dev/null
                echo "Uninstalling ${app} from ${t}: committed; the platform removes it. Its data is retained:"
                echo "installing ${app} again finds it, and 'kubectl gentian apps uninstall ${app} --tenant ${t} --purge' destroys it."
            fi
            ;;
        *) die "usage: kubectl gentian apps list|install|uninstall ..." ;;
    esac
}

cmd_resources() {
    local sub="${1:-}"
    shift || true
    local t
    case "${sub}" in
        plans)
            t="$(_tenant_flag "$@")"
            _call_usher GET "/v1/tenants/${t}/resources/plans" |
                jq -r '(["","PLAN","CPU","MEMORY","STORAGE"] | @tsv), (.plans[] | [(if .current then "*" else "" end), .name, (.quotas.requestsCpu // "-"), (.quotas.requestsMemory // "-"), (.quotas.storage // "-")] | @tsv)' |
                column -t -s $'\t'
            ;;
        show)
            t="$(_tenant_flag "$@")"
            _call_usher GET "/v1/tenants/${t}/resources" | jq .
            ;;
        set)
            t="$(_tenant_flag "$@")"
            local plan="" force="false"
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --plan|-p) plan="${2:?}"; shift 2 ;;
                    --force) force="true"; shift ;;
                    *) shift ;;
                esac
            done
            [[ -n "${plan}" ]] || die "--plan is required"
            _call PUT "/v1/tenants/${t}/resources" "$(jq -n --arg p "${plan}" --argjson f "${force}" '{plan:$p, force:$f}')" >/dev/null
            echo "Plan ${plan} chosen for ${t}: committed."
            ;;
        report)
            t="$(_tenant_flag "$@")"
            local from="" to=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --from) from="${2:?}"; shift 2 ;;
                    --to) to="${2:?}"; shift 2 ;;
                    *) shift ;;
                esac
            done
            [[ -n "${from}" && -n "${to}" ]] || die "--from and --to are required (RFC 3339)"
            _call_usher GET "/v1/tenants/${t}/resources/report?from=$(jq -rn --arg v "${from}" '$v|@uri')&to=$(jq -rn --arg v "${to}" '$v|@uri')" |
                jq -r 'if .incomplete then "Nothing is known about the plan in force when this window opened; the first interval starts later.\n" else "" end,
                       (["PLAN","DAYS","FROM","TO","SKU"] | @tsv),
                       ((.intervals // [])[] | [.plan, ((.seconds / 86400) * 100 | round / 100 | tostring), .from[0:19], .to[0:19], (.productSku // "")] | @tsv)' |
                column -t -s $'\t'
            ;;
        *) die "usage: kubectl gentian resources plans|show|set|report --tenant <tenant>" ;;
    esac
}

# usage — the header comment above, which is the reference.
usage() {
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
}

main() {
    local cmd="${1:-help}"
    shift || true
    case "${cmd}" in
        login) cmd_login ;;
        logout) cmd_logout ;;
        whoami) cmd_whoami ;;
        tenant|tenants)
            local sub="${1:-}"
            shift || true
            case "${sub}" in
                list) cmd_tenants_list ;;
                show) cmd_tenants_show "$@" ;;
                set) cmd_tenants_set "$@" ;;
                create) cmd_tenants_create "$@" ;;
                activate-admin) cmd_tenants_activate_admin "$@" ;;
                retire) cmd_tenants_retire "$@" ;;
                import) cmd_tenants_import "$@" ;;
                delegate-catalogues) cmd_tenants_delegate_catalogues "$@" ;;
                domain) cmd_tenants_domain "$@" ;;
                *) die "usage: kubectl gentian tenants list|show|create|set|activate-admin|retire|import|delegate-catalogues|domain" ;;
            esac
            ;;
        app|apps) cmd_apps "$@" ;;
        catalogue|catalogues) cmd_catalogues "$@" ;;
        exposure|exposures) cmd_exposures "$@" ;;
        resource|resources) cmd_resources "$@" ;;
        version|--version|-v) cmd_version ;;
        help|--help|-h) usage ;;
        *) usage; exit 1 ;;
    esac
}

main "$@"
