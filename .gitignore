# IaC runtime artifacts (if present locally)
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.backup
*.tfstate
*.tfstate.*

# Local installer credentials cache (install.sh)
.install-secrets.env
.install-state.env

# Local operator-provided install config (templates are committed as *.template)
install.env
install.secrets.env
install.env.backup
*.backup

# Go test binaries (produced by go test -c or go test -o)
*.test
bin/
# The operator binary. `make build` writes bin/manager, covered above, but the
# Dockerfile builds `-o manager` at the workspace root — run that outside Docker
# and a 45 MB artefact lands next to the Makefile, which is how one reached Git.
# Anchored, so cmd/manager or any package named manager is unaffected.
/manager
__pycache__/
*.tgz

# controller-gen RBAC output: a build intermediate, not a source artifact.
# The committed artifact is charts/gentian-os/templates/clusterrole.yaml, which
# scripts/gen-clusterrole.py renders from this file after re-normalising it, so
# controller-gen version differences in key order or grouping cannot show up as
# repo diffs.
config/rbac/

# Recovery kits. Both extensions: --export-recovery-kit writes .age when age is
# installed and .enc when it falls back to openssl, and its default path is a
# bare filename — so a kit lands in whatever directory the operator ran the
# command from, which is usually this one.
*.age
*.enc

# Agent worktrees. These are checkouts of this repo living inside it, so an
# `add -A` records each one as a gitlink — a submodule entry with no
# .gitmodules behind it. A clone then gets empty directories it cannot
# populate, and the entry goes stale on every commit made in the worktree, so
# the repo reports a modification that has nothing to do with the work.
.claude/worktrees/
backup-key*
*.png
